          "font": "NotoSans-Regular",
          "size": 10.5,
          "color": 6186611
        },
        {
          "text": "FACT",
          "bbox": [
            59.0,
            255.28,
            84.35,
            269.58
          ],
          "font": "NotoSans-SemiBold",
          "size": 10.5,
          "color": 16777215
        },
        {
          "text": "Momentic uses explicitly authored step-based tests as its default mode; V3 can use agentic actions for",
          "bbox": [
            101.35,
            240.9,
            865.38,
            262.69
          ],
          "font": "NotoSans-Regular",
          "size": 16.0,
          "color": 1515562
        },
        {
