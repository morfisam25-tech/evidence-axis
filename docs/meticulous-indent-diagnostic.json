            59.0,
            322.28,
            84.35,
            336.58
          ],
          "font": "NotoSans-SemiBold",
          "size": 10.5,
          "color": 16777215
        },
        {
          "text": "QA Wolf uses autonomous mapping plus AI-generated deterministic Playwright/Appium tests. Shiplight",
          "bbox": [
            101.35,
            307.9,
            877.78,
            329.69
          ],
          "font": "NotoSans-Regular",
          "size": 16.0,
          "color": 1515562
        },
        {
          "text": "places the coding agent itself inside browser verification and can turn that verification into durable",
          "bbox": [
            52.0,
            330.9,
            792.59,
            352.69
          ],
          "font": "NotoSans-Regular",
          "size": 16.0,
          "color": 1515562
        },
        {
          "text": "coverage.",
          "bbox": [
            52.0,
            353.9,
            125.25,
            375.69
          ],
          "font": "NotoSans-Regular",
          "size": 16.0,
          "color": 1515562
        },
        {
          "text": "[S-C02][S-C03]",
          "bbox": [
            52.0,
            380.78,
            121.4,
            395.08
          ],
          "font": "NotoSans-Regular",
          "size": 10.5,
          "color": 6186611
        },
        {
          "text": "INFERENCE",
          "bbox": [
            59.0,
            412.28,
            116.21,
            426.58
          ],
          "font": "NotoSans-SemiBold",
          "size": 10.5,
          "color": 16777215
        },
        {
          "text": "Among this comparison set, Meticulous is the one whose core coverage model starts from observed",
          "bbox": [
            133.21,
            397.9,
            884.24,
            419.69
