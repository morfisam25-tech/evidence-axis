          "bbox": [
            52.0,
            263.9,
            583.3,
            285.69
          ],
          "font": "NotoSans-Regular",
          "size": 16.0,
          "color": 1515562
        },
        {
          "text": "[S-C01]",
          "bbox": [
            52.0,
            290.78,
            86.7,
            305.08
          ],
          "font": "NotoSans-Regular",
          "size": 10.5,
          "color": 6186611
        },
        {
          "text": "FACT",
