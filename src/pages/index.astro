  .home4-section+.home4-section{border-top:1px solid rgba(113,149,207,.08)}
  .kicker4{color:#719df8;font-size:.65rem;letter-spacing:.16em}
  .section-copy,.section-head4{position:relative;z-index:2}.section-copy{max-width:34rem}.section-copy h2,.section-head4 h2,.final4 h2{margin:.72rem 0 0;font-family:var(--font-display);font-size:clamp(2.15rem,3.1vw,3.55rem);line-height:1.04;letter-spacing:-.043em;color:#f3f7fb;text-wrap:balance}.section-copy h2 em{font-style:normal;color:#7ea3ff}.section-copy>p,.section-head4>p,.final4 p{margin-top:1rem;color:var(--muted);font-size:clamp(.98rem,1.08vw,1.08rem);line-height:1.65}.section-head4{display:grid;grid-template-columns:minmax(0,.9fr) minmax(20rem,.7fr);gap:3rem;align-items:end}.section-head4>div{max-width:35rem}.section-head4>p{max-width:39rem;margin-top:0}.link4{display:inline-flex;align-items:center;gap:.6rem;margin-top:1.25rem;color:#65dede;text-decoration:none;font-family:var(--font-display);font-size:.92rem;font-weight:600}.button4{min-height:3rem;display:inline-flex;align-items:center;justify-content:center;gap:.7rem;padding:0 1.15rem;border-radius:.55rem;background:linear-gradient(110deg,#89a9ff,#58cbe8);color:#07101e;text-decoration:none;font-family:var(--font-display);font-weight:650;box-shadow:0 12px 32px rgba(50,104,228,.2)}

  .gap4{padding-top:4.8rem;background:radial-gradient(circle at 78% 40%,rgba(47,101,205,.08),transparent 28rem),#030a14}.gap4__grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(21rem,.72fr) minmax(34rem,1.25fr);gap:clamp(3rem,6vw,7rem);align-items:start}.section-copy--sticky{position:sticky;top:7rem}.gap4__board{display:grid;gap:.9rem}.gap-card{--card:#78a3ff;position:relative;padding:1.35rem 1.45rem;border:1px solid color-mix(in srgb,var(--card) 28%,var(--line));border-radius:1rem;background:radial-gradient(circle at 90% 10%,color-mix(in srgb,var(--card) 10%,transparent),transparent 30%),linear-gradient(135deg,rgba(13,30,53,.94),rgba(6,17,31,.96));box-shadow:0 24px 55px rgba(0,0,0,.16),inset 0 1px rgba(255,255,255,.025);overflow:hidden;transition:transform 180ms ease,border-color 180ms ease}.gap-card:hover{transform:translateX(-6px);border-color:color-mix(in srgb,var(--card) 55%,transparent)}.gap-card--amber{--card:var(--amber);margin-left:3rem}.gap-card--cyan{--card:var(--cyan);margin-left:1.25rem}.gap-card__top{display:flex;align-items:center;justify-content:space-between;gap:1rem}.gap-card__top span{color:#647b9e;font-size:.58rem;letter-spacing:.12em}.gap-card__top b{color:var(--card);font-family:var(--font-mono);font-size:.58rem;letter-spacing:.08em}.gap-card h3{margin:.9rem 0 0;color:#eef4ff;font-family:var(--font-display);font-size:1.18rem;line-height:1.35;max-width:38rem}.gap-card p{margin-top:.55rem;color:#9daec2;font-size:.93rem;line-height:1.55;max-width:42rem}.gap-card__signal{display:flex;gap:.35rem;margin-top:1rem}.gap-card__signal span{height:3px;border-radius:3px;background:var(--card)}.gap-card__signal span:nth-child(1){width:16%}.gap-card__signal span:nth-child(2){width:38%;opacity:.55}.gap-card__signal span:nth-child(3){width:22%;opacity:.25}.gap-card__meter{display:flex;gap:.3rem;margin-top:1rem}.gap-card__meter i{display:block;width:2rem;height:.28rem;border-radius:2px;background:var(--card);opacity:.18}.gap-card__meter i:nth-child(-n+3){opacity:.9}.gap-card__route{display:flex;align-items:center;gap:.5rem;margin-top:1rem;color:#7990ac;font-family:var(--font-mono);font-size:.56rem}.gap-card__route i{color:var(--card);font-style:normal}

  .model4{background:linear-gradient(180deg,#040c17,#030a14)}.model4__surface{position:relative;z-index:2;margin-top:2.3rem;padding:1rem;border:1px solid rgba(116,153,210,.1);border-radius:1.2rem;background:rgba(5,14,27,.46)}

  .trace4{background:radial-gradient(circle at 73% 47%,rgba(42,101,208,.09),transparent 34rem),#030a14}.trace4__grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(18rem,.48fr) minmax(0,1.35fr);gap:clamp(2.5rem,4vw,5rem);align-items:start}.trace4 .section-copy{padding-top:2.2rem}.trace4__console{min-width:0}

