---
import Base from '@layouts/Base.astro';
import Hero from '@components/Hero.astro';
import { site, offers, cta } from '@config/site';

const valueCards = [
  {
    n: '01',
    tag: 'VERIFIABLE',
    title: 'Evidence you can defend.',
    body: 'Material claims are tied to identifiable public sources and the date they were checked.',
    accent: 'fact',
  },
  {
    n: '02',
    tag: 'VISIBLE LIMITS',
    title: 'Unknowns stay unknown.',
    body: 'When public evidence cannot support a conclusion, the gap stays visible instead of being filled with guesswork.',
    accent: 'unknown',
  },
  {
    n: '03',
    tag: 'DECISION-SCOPED',
    title: 'Research follows the decision.',
    body: 'The question determines what gets investigated, so the brief stays useful instead of becoming an encyclopedic competitor deck.',
    accent: 'decision',
  },
];

const packageCards = [
  {
    n: '01',
    name: offers.twoCompetitor.name,
    price: offers.twoCompetitor.priceDisplay,
    delivery: offers.twoCompetitor.delivery,
    note: 'Best for one decision that depends on two competitors.',
    bullets: ['Two named competitors', 'One defined decision question', 'Evidence matrix + source register', 'Fact / Inference / Unknown separation'],
    href: '/competitor-brief/',
    cta: 'Start with two',
    featured: true,
  },
  {
    n: '02',
    name: offers.fiveCompetitor.name,
    price: offers.fiveCompetitor.priceDisplay,
    delivery: offers.fiveCompetitor.delivery,
    note: 'For a wider competitor field around one research question.',
    bullets: ['Five named competitors', 'Positioning + packaging evidence', 'Contradictions surfaced', 'Decision implications'],
    href: '/competitor-brief/',
    cta: 'Compare five',
    featured: false,
  },
  {
    n: '03',
    name: offers.blueprint.name,
    price: offers.blueprint.priceDisplay,
    delivery: offers.blueprint.delivery,
    note: 'For a deeper strategic decision that needs a larger evidence base.',
    bullets: ['Custom research boundary', 'Category + offer architecture', 'Deeper synthesis', 'Scoped decision framework'],
    href: '/strategic-blueprint/',
    cta: 'Scope a blueprint',
    featured: false,
  },
];

const methodTeasers = [
  ['01', 'Question first', 'Define the decision before collecting evidence.'],
  ['02', 'Source + classify', 'Record what is Fact, what is Inference, and what remains Unknown.'],
  ['03', 'Return the move', 'Translate the evidence into implications for the decision in front of you.'],
];
---
<Base title={site.name} description={site.description} path="/">
  <Hero />

  <main class="home4">
    <section class="value-band" aria-labelledby="value-title">
      <div class="container-wide">
        <div class="value-head">
          <div>
            <span class="eyebrow mono">WHY EVIDENCE AXIS</span>
            <h2 id="value-title">Less competitor noise. More decision signal.</h2>
          </div>
          <p>Evidence Axis is built for teams that already have plenty of competitor information and need to know what deserves to influence a real decision.</p>
        </div>

        <div class="value-grid">
          {valueCards.map((card) => (
            <article class:list={['value-card', `value-card--${card.accent}`]}>
              <div class="value-card__top"><span class="mono">{card.n}</span><b>{card.tag}</b></div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <div class="value-card__line" aria-hidden="true"></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="packages" id="services" aria-labelledby="packages-title">
      <div class="container-wide">
        <div class="section-heading">
          <span class="eyebrow mono">ENGAGEMENTS</span>
          <h2 id="packages-title">Choose the size of the decision.</h2>
          <p>Start small when the question is narrow. Expand only when the decision needs a wider evidence field.</p>
        </div>

        <div class="package-layout">
          <article class="package package--featured">
            <div class="package__rail">
              <span class="mono">{packageCards[0].n}</span>
              <b>Most common starting point</b>
            </div>
            <div class="package__body">
              <div class="package__identity">
                <span class="package__label">FAST DECISION</span>
                <h3>{packageCards[0].name}</h3>
                <p>{packageCards[0].note}</p>
              </div>
              <div class="package__commercial">
                <div><small>STARTING PRICE</small><strong>{packageCards[0].price}</strong></div>
                <div><small>DELIVERY</small><strong>{packageCards[0].delivery}</strong></div>
              </div>
              <ul>
                {packageCards[0].bullets.map((item) => <li><i aria-hidden="true">✓</i>{item}</li>)}
              </ul>
              <a href={packageCards[0].href}>{packageCards[0].cta}<span aria-hidden="true">→</span></a>
            </div>
          </article>

          <div class="package-stack">
            {packageCards.slice(1).map((pkg, index) => (
              <article class="package package--compact">
                <div class="package__compact-head">
                  <span class="mono">{pkg.n}</span>
                  <small>{index === 0 ? 'BROADER READ' : 'STRATEGIC SCOPE'}</small>
                </div>
                <div class="package__compact-main">
                  <div>
                    <h3>{pkg.name}</h3>
                    <p>{pkg.note}</p>
                  </div>
                  <div class="package__price"><strong>{pkg.price}</strong><span>{pkg.delivery}</span></div>
                </div>
                <div class="package__compact-foot">
                  <ul>{pkg.bullets.slice(0, 3).map((item) => <li>{item}</li>)}</ul>
                  <a href={pkg.href}>{pkg.cta}<span aria-hidden="true">→</span></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="sample-showcase" aria-labelledby="sample-title">
      <div class="sample-showcase__glow" aria-hidden="true"></div>
      <div class="container-wide sample-showcase__layout">
        <div class="sample-copy">
          <span class="eyebrow mono">LIVE SAMPLE</span>
          <h2 id="sample-title">Inspect the work before you buy.</h2>
          <p>The current sample compares Intercom and Zendesk using real first-party sources, checked dates, explicit Unknowns, and a source register.</p>
          <div class="sample-links">
            <a class="sample-primary" href="/sample-report/">View Sample Report <span aria-hidden="true">→</span></a>
            <a class="sample-secondary" href="/report/evidence-axis-sample-intercom-vs-zendesk.pdf">Open PDF</a>
          </div>
        </div>

        <a href="/sample-report/" class="sample-object" aria-label="Open the Intercom versus Zendesk sample report">
          <div class="sample-object__top mono"><span>EA / SAMPLE 001</span><b>INTERCOM × ZENDESK</b></div>
          <div class="sample-object__question">Which platform gives a SaaS support team the stronger fit for its decision context?</div>
          <div class="sample-object__states">
            <div class="state-block state-block--fact"><small>FACT</small><strong>Public list pricing</strong><span>Source-backed</span></div>
            <div class="state-block state-block--infer"><small>INFERENCE</small><strong>Packaging trade-off</strong><span>Reasoning shown</span></div>
            <div class="state-block state-block--unknown"><small>UNKNOWN</small><strong>Team-specific AI cost</strong><span>Cannot be settled publicly</span></div>
          </div>
          <div class="sample-object__footer"><span class="mono">8 FIRST-PARTY SOURCES</span><b>OPEN REPORT →</b></div>
        </a>
      </div>
    </section>

    <section class="method-teaser" aria-labelledby="method-title">
      <div class="container-wide method-teaser__layout">
        <div class="method-teaser__copy">
          <span class="eyebrow mono">METHOD</span>
          <h2 id="method-title">A short method. A visible evidence trail.</h2>
          <p>The detail lives on the Method page. The principle is simple: start with the decision, classify the evidence, and never hide where certainty ends.</p>
          <a href="/method/">See the full method <span aria-hidden="true">→</span></a>
        </div>

        <div class="method-steps">
          {methodTeasers.map(([n, title, body]) => (
            <article>
              <span class="mono">{n}</span>
              <div><h3>{title}</h3><p>{body}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title">
      <div class="final-cta__grid" aria-hidden="true"></div>
      <div class="container final-cta__inner">
        <span class="eyebrow mono">START SMALL</span>
        <h2 id="final-title">Bring the decision your team keeps debating.</h2>
        <p>Send the competitors, the question, and any context that changes what “better” means for your team.</p>
        <div class="final-cta__actions">
          <a href={cta.primary.href}>{cta.primary.label}<span aria-hidden="true">→</span></a>
          <a href="mailto:hello@evidenceaxis.com">hello@evidenceaxis.com</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .home4{
    --bg:#020812;
    --panel:#071426;
    --line:rgba(116,158,222,.18);
    --text:#edf4ff;
    --muted:#aebdce;
    --blue:#7da6ff;
    --cyan:#59e7e3;
    --amber:#f2b55b;
    --violet:#a783ff;
    background:var(--bg);
    color:var(--text);
  }
  .eyebrow{display:inline-block;color:#7da8ff;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase}
  .value-band,.packages,.sample-showcase,.method-teaser{position:relative;padding:clamp(4.5rem,7vw,7rem) 0;border-top:1px solid rgba(119,157,216,.1)}

  .value-band{background:linear-gradient(180deg,#020812,#050d19)}
  .value-head{display:grid;grid-template-columns:1fr .85fr;gap:4rem;align-items:end;margin-bottom:2.4rem}
  .value-head h2,.section-heading h2,.sample-copy h2,.method-teaser__copy h2,.final-cta h2{margin:.7rem 0 0;font-family:var(--font-display);font-size:clamp(2rem,3.2vw,3.45rem);line-height:1.05;letter-spacing:-.04em;color:#f7f9fc;text-wrap:balance}
  .value-head>p,.section-heading>p,.sample-copy>p,.method-teaser__copy>p,.final-cta p{margin:0;color:var(--muted);font-size:1.05rem;line-height:1.7;max-width:46rem}
  .value-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
  .value-card{position:relative;min-height:17rem;padding:1.55rem;border:1px solid var(--line);border-radius:1rem;background:linear-gradient(160deg,rgba(10,31,54,.94),rgba(4,15,28,.94));overflow:hidden;box-shadow:inset 0 1px rgba(255,255,255,.025)}
  .value-card__top{display:flex;justify-content:space-between;align-items:center;margin-bottom:2.2rem}.value-card__top span{color:#6f88ab;font-size:.72rem}.value-card__top b{font-size:.68rem;letter-spacing:.12em;color:var(--card-accent)}
  .value-card h3{margin:0;font-family:var(--font-display);font-size:1.55rem;line-height:1.15;color:#f5f8fc}.value-card p{margin:.85rem 0 0;color:#c0cedd;font-size:1.03rem;line-height:1.65}.value-card__line{position:absolute;left:1.55rem;right:1.55rem;bottom:1.3rem;height:2px;background:linear-gradient(90deg,var(--card-accent),transparent);opacity:.7}
  .value-card--fact{--card-accent:var(--cyan)}.value-card--unknown{--card-accent:var(--violet)}.value-card--decision{--card-accent:var(--blue)}

  .packages{background:#030a14}
  .section-heading{max-width:52rem;margin-bottom:2.4rem}.section-heading>p{margin-top:1rem}
  .package-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:1rem}
  .package{border:1px solid rgba(124,165,226,.2);border-radius:1.05rem;background:linear-gradient(150deg,rgba(8,26,46,.98),rgba(4,14,26,.98));overflow:hidden}
  .package--featured{display:grid;grid-template-columns:3.1rem 1fr;min-height:34rem;border-color:rgba(92,211,229,.42);box-shadow:0 26px 60px rgba(0,0,0,.24),inset 0 0 48px rgba(45,171,222,.04)}
  .package__rail{padding:1rem .5rem;display:flex;flex-direction:column;align-items:center;gap:1rem;border-right:1px solid rgba(100,182,222,.22);background:rgba(29,124,160,.08)}
  .package__rail span{color:#62e4df;font-size:.7rem}.package__rail b{writing-mode:vertical-rl;transform:rotate(180deg);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:#8ba6c1;font-weight:600}
  .package__body{padding:2rem;display:grid;grid-template-rows:auto auto 1fr auto;gap:1.7rem}.package__label{color:#64e5e1;font-size:.68rem;letter-spacing:.14em}.package__identity h3{margin:.5rem 0 0;font-family:var(--font-display);font-size:2rem;line-height:1.12}.package__identity p{margin:.65rem 0 0;color:#b7c5d5;font-size:1rem;line-height:1.6;max-width:34rem}
  .package__commercial{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:1.15rem 0;border-top:1px solid rgba(118,158,218,.16);border-bottom:1px solid rgba(118,158,218,.16)}.package__commercial small{display:block;color:#7790ae;font-size:.65rem;letter-spacing:.12em}.package__commercial strong{display:block;margin-top:.35rem;color:#f7f9fc;font-family:var(--font-display);font-size:2.25rem}.package__commercial>div:last-child strong{font-size:1.15rem;margin-top:.65rem}
  .package ul{list-style:none;margin:0;padding:0;display:grid;gap:.65rem}.package li{display:flex;gap:.6rem;color:#d1dbe6;font-size:1rem;line-height:1.45}.package li i{color:#5ee2dd;font-style:normal}.package a{display:inline-flex;align-items:center;justify-content:space-between;gap:1rem;min-height:3.25rem;padding:0 1.05rem;border-radius:.62rem;text-decoration:none;font-family:var(--font-display);font-weight:650}.package--featured a{color:#04101c;background:linear-gradient(110deg,#86a9ff,#5ed9e5)}
  .package-stack{display:grid;gap:1rem}.package--compact{padding:1.5rem;min-height:16.5rem;display:grid;gap:1.1rem}.package__compact-head{display:flex;align-items:center;justify-content:space-between}.package__compact-head span{color:#7187a5;font-size:.7rem}.package__compact-head small{color:#7da5ff;font-size:.68rem;letter-spacing:.12em}.package__compact-main{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:start}.package__compact-main h3{margin:0;font-family:var(--font-display);font-size:1.45rem}.package__compact-main p{margin:.55rem 0 0;color:#b5c3d2;font-size:.98rem;line-height:1.55}.package__price{text-align:right}.package__price strong{display:block;font-family:var(--font-display);font-size:1.85rem;color:#f4f8ff}.package__price span{display:block;margin-top:.3rem;color:#8297b2;font-size:.8rem}.package__compact-foot{display:grid;grid-template-columns:1fr auto;gap:1.5rem;align-items:end}.package__compact-foot ul{gap:.3rem}.package__compact-foot li{font-size:.88rem;color:#9fb0c2}.package__compact-foot a{min-height:auto;padding:.65rem .85rem;border:1px solid rgba(127,169,230,.24);color:#dbe7f7;background:rgba(14,32,53,.6);font-size:.9rem}

  .sample-showcase{overflow:hidden;background:radial-gradient(circle at 78% 55%,rgba(38,121,255,.15),transparent 28rem),linear-gradient(180deg,#020812,#061021)}.sample-showcase__glow{position:absolute;right:2%;top:8%;width:32rem;height:32rem;border-radius:50%;background:rgba(69,126,255,.08);filter:blur(55px)}
  .sample-showcase__layout{display:grid;grid-template-columns:.78fr 1.22fr;gap:4rem;align-items:center}.sample-copy{position:relative;z-index:2}.sample-copy>p{margin-top:1rem}.sample-links{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.4rem}.sample-links a{display:inline-flex;align-items:center;gap:.7rem;min-height:3rem;padding:0 1rem;border-radius:.6rem;text-decoration:none;font-family:var(--font-display);font-weight:650}.sample-primary{background:linear-gradient(110deg,#86a9ff,#5fd6e4);color:#06101b}.sample-secondary{border:1px solid rgba(128,166,222,.24);color:#dce7f6;background:rgba(8,24,43,.58)}
  .sample-object{position:relative;display:block;padding:1.25rem;border:1px solid rgba(99,176,239,.34);border-radius:1.1rem;background:linear-gradient(145deg,rgba(12,34,60,.98),rgba(4,14,27,.98));box-shadow:0 35px 75px rgba(0,0,0,.34),inset 0 1px rgba(255,255,255,.04);text-decoration:none;color:inherit;transform:perspective(1200px) rotateY(-4deg) rotateX(2deg);transition:transform .25s ease,border-color .25s ease}.sample-object:hover{transform:perspective(1200px) rotateY(-1deg) rotateX(0) translateY(-4px);border-color:rgba(89,231,227,.58)}
  .sample-object__top,.sample-object__footer{display:flex;justify-content:space-between;gap:1rem;align-items:center}.sample-object__top{padding:.2rem .15rem 1rem;border-bottom:1px solid rgba(118,159,220,.15);font-size:.68rem;color:#7189aa}.sample-object__top b{color:#64e4df;letter-spacing:.08em}.sample-object__question{padding:1.5rem 0;font-family:var(--font-display);font-size:1.7rem;line-height:1.25;color:#f3f7fc;max-width:34rem}.sample-object__states{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}.state-block{min-height:9.5rem;padding:1rem;border:1px solid rgba(122,160,215,.18);border-radius:.75rem;background:rgba(7,19,34,.78)}.state-block small{display:block;font-size:.64rem;letter-spacing:.12em;color:var(--state)}.state-block strong{display:block;margin-top:.7rem;font-size:1rem;line-height:1.3;color:#eff5fb}.state-block span{display:block;margin-top:.65rem;color:#9fb0c3;font-size:.82rem;line-height:1.4}.state-block--fact{--state:var(--cyan);border-color:rgba(89,231,227,.27)}.state-block--infer{--state:var(--amber);border-color:rgba(242,181,91,.25)}.state-block--unknown{--state:var(--violet);border-color:rgba(167,131,255,.27)}.sample-object__footer{margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(118,159,220,.15);color:#7d91aa;font-size:.68rem}.sample-object__footer b{color:#d9e5f3}

  .method-teaser{background:#030a14}.method-teaser__layout{display:grid;grid-template-columns:.85fr 1.15fr;gap:4rem;align-items:start}.method-teaser__copy>p{margin-top:1rem}.method-teaser__copy>a{display:inline-flex;margin-top:1.2rem;color:#6be1e2;text-decoration:none;font-weight:650}.method-steps{display:grid;gap:.7rem}.method-steps article{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:1.15rem 1.25rem;border:1px solid rgba(117,158,219,.17);border-radius:.8rem;background:linear-gradient(100deg,rgba(9,27,48,.9),rgba(5,15,28,.92))}.method-steps article>span{color:#6688b1;font-size:.7rem;padding-top:.2rem}.method-steps h3{margin:0;font-family:var(--font-display);font-size:1.2rem;color:#f0f5fb}.method-steps p{margin:.35rem 0 0;color:#afbece;font-size:.98rem;line-height:1.55}

  .final-cta{position:relative;overflow:hidden;padding:clamp(5rem,8vw,8rem) 0;text-align:center;background:radial-gradient(circle at 50% 45%,rgba(57,126,255,.16),transparent 28rem),#020811;border-top:1px solid rgba(119,157,216,.1)}.final-cta__grid{position:absolute;inset:0;background-image:linear-gradient(rgba(100,142,202,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(100,142,202,.03) 1px,transparent 1px);background-size:64px 64px;mask-image:radial-gradient(circle,#000,transparent 72%)}.final-cta__inner{position:relative;z-index:1;max-width:52rem}.final-cta p{margin:1rem auto 0;max-width:42rem}.final-cta__actions{display:flex;justify-content:center;gap:.8rem;flex-wrap:wrap;margin-top:1.5rem}.final-cta__actions a{display:inline-flex;align-items:center;gap:.7rem;min-height:3.15rem;padding:0 1.15rem;border-radius:.62rem;text-decoration:none;font-family:var(--font-display);font-weight:650}.final-cta__actions a:first-child{background:linear-gradient(110deg,#87a9ff,#5cd8e4);color:#05101c}.final-cta__actions a:last-child{border:1px solid rgba(125,165,222,.25);color:#d9e5f4;background:rgba(7,20,36,.55)}

  @media(max-width:68rem){.value-head,.sample-showcase__layout,.method-teaser__layout{grid-template-columns:1fr;gap:2rem}.value-grid{grid-template-columns:1fr 1fr}.value-grid article:last-child{grid-column:1/-1}.package-layout{grid-template-columns:1fr}.package-stack{grid-template-columns:1fr 1fr}.sample-object{transform:none}}
  @media(max-width:48rem){.value-band,.packages,.sample-showcase,.method-teaser{padding:4rem 0}.value-grid,.package-stack,.sample-object__states{grid-template-columns:1fr}.value-grid article:last-child{grid-column:auto}.package__compact-main,.package__compact-foot{grid-template-columns:1fr}.package__price{text-align:left}.package--featured{grid-template-columns:1fr}.package__rail{display:none}.package__body{padding:1.35rem}.package__commercial{grid-template-columns:1fr}.sample-object__question{font-size:1.35rem}.sample-object__top,.sample-object__footer{align-items:flex-start;flex-direction:column}.value-head h2,.section-heading h2,.sample-copy h2,.method-teaser__copy h2,.final-cta h2{font-size:clamp(2rem,9vw,2.7rem)}}
</style>
