---
import Base from '@layouts/Base.astro';
import Hero from '@components/Hero.astro';
import { site, offers, cta, contact } from '@config/site';
---
<Base title={site.name} description={site.description} path="/">
  <Hero />

  <main class="ea-home">
    <section class="ea-proof" id="proof" aria-label="Evidence Axis operating principles">
      <div class="container-wide ea-proof__grid">
        <article><span>01</span><b>Discover</b><p>Find the competitors the current view may be missing.</p></article>
        <article><span>02</span><b>Verify</b><p>Open the sources and separate evidence from noise.</p></article>
        <article><span>03</span><b>Decide</b><p>Turn the verified record into an executive decision.</p></article>
        <article><span>04</span><b>Respond</b><p>Convert the decision into market action when needed.</p></article>
      </div>
    </section>

    <section class="ea-section ea-founder-video" id="founder-video" aria-labelledby="founder-video-title">
      <div class="container-wide ea-founder-video__grid">
        <div class="ea-founder-video__copy">
          <span class="ea-kicker">FOUNDER OVERVIEW · 1:47</span>
          <h2 id="founder-video-title">How Evidence Axis turns public sources into decision-ready intelligence.</h2>
          <p>A short walkthrough of the research standard, the evidence controls and the work a team receives.</p>
        </div>
        <div class="ea-founder-video__frame">
          <video controls playsinline preload="metadata" poster="/assets/founder/evidence-axis-founder-explainer-poster.jpg" aria-label="Evidence Axis founder explainer video">
            <source src="/assets/founder/evidence-axis-founder-explainer-720p.mp4" type="video/mp4" />
            <track kind="captions" src="/assets/founder/evidence-axis-founder-explainer.vtt" srclang="en" label="English" default />
            Your browser does not support the video element.
          </video>
        </div>
      </div>
    </section>

    <section class="ea-section ea-brief" id="complimentary-brief">
      <div class="container-wide">
        <header class="ea-offer-head">
          <div>
            <span class="ea-kicker">HOW TO WORK WITH EVIDENCE AXIS</span>
            <h2>See the evidence first. Go deeper when the decision is real.</h2>
          </div>
          <p>Start with a company-specific brief at no cost. If a live decision, market response or continuing watch needs deeper work, move into the package built for that outcome.</p>
        </header>

        <article class="ea-start-card">
          <div class="ea-start-card__title">
            <span class="mono">START HERE · COMPLIMENTARY</span>
            <h3>{offers.complimentaryBrief.name}</h3>
            <p>Real research on your company. No generic demo, required sales call or purchase obligation.</p>
          </div>
          <div class="ea-start-card__deliverables" aria-label="Complimentary brief deliverables">
            <span><b>01</b>Competitive Set Scan</span>
            <span><b>02</b>Executive Intelligence Deck</span>
            <span><b>03</b>Evidence Appendix</span>
            <span><b>04</b>Sources + review dates</span>
          </div>
          <div class="ea-start-card__action">
            <small class="mono">NO COST · VERIFIED WORK EMAIL</small>
            <a class="ea-btn ea-btn--dark" href={cta.primary.href}>{cta.primary.label}<span>→</span></a>
          </div>
        </article>

        <div class="ea-paid-label">
          <span class="ea-kicker">PAID PACKAGES</span>
          <p>Go deeper only when there is a defined job to do. Pricing is scoped and quoted privately.</p>
        </div>
        <div class="ea-package-map" aria-label="Evidence Axis paid engagement packages">
          <a class="ea-package ea-package--decision" href="/competitor-brief/">
            <span class="mono">DECIDE · PAID CORE</span><h4>Competitive Decision Sprint</h4>
            <p>Support a live product, pricing, positioning, sales or strategic decision.</p>
            <div class="ea-package__quote"><small>ENGAGEMENT</small><strong>Private quote</strong></div>
            <div class="ea-package__delivery"><small>DELIVERY</small><b>Agreed during scoping</b></div>
            <ul><li>Decision context + constraints</li><li>Competitor deep dive</li><li>Prioritized recommendations</li></ul>
            <span class="ea-package__cta">Explore the Decision Sprint →</span>
          </a>
          <a class="ea-package ea-package--response" href="/strategic-blueprint/">
            <span class="mono">RESPOND · ACT</span><h4>Competitive Response Sprint</h4>
            <p>Build battlecards, objection handling, pricing response and messaging.</p>
            <div class="ea-package__quote"><small>ENGAGEMENT</small><strong>Private quote</strong></div>
            <div class="ea-package__delivery"><small>DELIVERY</small><b>Agreed during scoping</b></div>
            <ul><li>Competitive battlecards</li><li>Objection handling</li><li>Positioning + messaging response</li></ul>
            <span class="ea-package__cta">Explore the Response Sprint →</span>
          </a>
          <a class="ea-package ea-package--radar" href="/market-intelligence/">
            <span class="mono">MONITOR · ONGOING</span><h4>Competitive Radar</h4>
            <p>Track pricing, launches, positioning, funding, integrations and emerging rivals.</p>
            <div class="ea-package__quote"><small>ENGAGEMENT</small><strong>Private quote</strong></div>
            <div class="ea-package__delivery"><small>CADENCE</small><b>Agreed during scoping</b></div>
            <ul><li>Pricing + packaging changes</li><li>Launches + positioning shifts</li><li>Funding + emerging rivals</li></ul>
            <span class="ea-package__cta">Explore Competitive Radar →</span>
          </a>
        </div>
      </div>
    </section>

    <section class="ea-section ea-standard" data-surface="dark">
      <div class="container-wide ea-standard__grid">
        <div class="ea-standard__copy">
          <span class="ea-kicker ea-kicker--light">AI-ACCELERATED · EVIDENCE-CONTROLLED</span>
          <h2>AI accelerates the work. Evidence controls the conclusion.</h2>
          <p>Evidence Axis uses AI aggressively for discovery, organization, comparison and pattern-finding. It does not treat generated text, search snippets or vendor marketing as proof.</p>
          <a class="ea-text-link ea-text-link--light" href="/method/">See the Evidence Axis method →</a>
        </div>
        <div class="ea-standard__rules">
          <article><span>01</span><b>Human-opened sources</b><p>Material claims are checked against the underlying source before they enter a deliverable.</p></article>
          <article><span>02</span><b>Fact · Inference · Unknown</b><p>Verified observation, analytical judgment and unresolved gaps never silently blend together.</p></article>
          <article><span>03</span><b>Contradictions stay visible</b><p>Conflicting evidence is disclosed instead of cleaned up for a prettier story.</p></article>
          <article><span>04</span><b>Executive-ready output</b><p>The work is structured around what deserves attention and what decision may follow.</p></article>
        </div>
      </div>
    </section>

    <section class="ea-section ea-sample">
      <div class="container-wide ea-sample__grid">
        <div class="ea-sample__copy">
          <span class="ea-kicker">ILLUSTRATIVE SAMPLE</span>
          <h2>Inspect the intelligence before you request your own.</h2>
          <p>The public demonstration compares Intercom and Zendesk on a bounded competitive question using checked first-party sources. It shows the evidence matrix, evidence states, decision implications and the source register.</p>
          <div class="ea-actions">
            <a class="ea-btn" href="/sample-report/">View the Sample Intelligence Brief <span>→</span></a>
            <a class="ea-text-link" href={cta.primary.href}>Request My Complimentary Brief →</a>
          </div>
        </div>
        <a class="ea-sample-preview" href="/sample-report/" aria-label="Open the current Evidence Axis sample intelligence brief">
          <div class="ea-sample-preview__top"><span class="mono">PUBLIC INTELLIGENCE SAMPLE</span><span class="mono">SOURCES REVIEWED · 19 AUG 2026</span></div>
          <div class="ea-sample-preview__title"><small>BOUNDED COMPETITIVE QUESTION</small><strong>Intercom vs Zendesk</strong><p>A traceable comparison built from checked first-party sources.</p></div>
          <div class="ea-sample-preview__states" aria-label="Evidence states"><span><b>FACT</b>Verified observation</span><span><b>INFERENCE</b>Analytical interpretation</span><span><b>UNKNOWN</b>Unresolved evidence</span></div>
          <div class="ea-sample-preview__foot"><span>9 checked sources</span><span>No universal winner declared</span><b>OPEN THE BRIEF →</b></div>
        </a>
      </div>
    </section>

    <section class="ea-section ea-services" id="services">
      <div class="container-wide">
        <header class="ea-head ea-head--split">
          <div><span class="ea-kicker">PAID ENGAGEMENTS</span><h2>Three different jobs after the evidence is clear.</h2></div>
          <p>The paid work is not “the complimentary brief with more pages.” Each engagement solves a different problem: make the decision, build the response, or keep the competitive view current.</p>
        </header>

        <div class="ea-services__grid">
          <article class="ea-service ea-service--decision">
            <span class="mono">01 · DECIDE</span><h3>{offers.decisionSprint.name}</h3><p>{offers.decisionSprint.scope}</p>
            <div class="ea-service__best"><small>BEST WHEN</small><b>A real decision is live now.</b></div>
            <ul><li>Company context + constraints</li><li>Decision-critical competitor deep dive</li><li>Pricing / product / positioning implications</li><li>Prioritized recommendations</li><li>Executive Decision Deck + Appendix</li></ul>
            <a href="/competitor-brief/">Explore the Decision Sprint →</a>
          </article>
          <article class="ea-service ea-service--response">
            <span class="mono">02 · RESPOND</span><h3>{offers.responseSprint.name}</h3><p>{offers.responseSprint.scope}</p>
            <div class="ea-service__best"><small>BEST WHEN</small><b>The team knows the issue and needs assets to act.</b></div>
            <ul><li>Battlecards</li><li>Objection handling</li><li>Pricing response</li><li>Positioning + messaging</li><li>Competitor-specific enablement</li></ul>
            <a href="/strategic-blueprint/">Explore the Response Sprint →</a>
          </article>
          <article class="ea-service ea-service--radar">
            <span class="mono">03 · MONITOR</span><h3>{offers.radar.name}</h3><p>{offers.radar.scope}</p>
            <div class="ea-service__best"><small>BEST WHEN</small><b>The picture changes faster than a point-in-time brief.</b></div>
            <ul><li>Pricing + packaging changes</li><li>Launches + feature moves</li><li>Positioning shifts</li><li>Funding + integrations</li><li>Emerging competitors</li></ul>
            <a href="/market-intelligence/">Explore Competitive Radar →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="ea-section ea-outputs" id="what-you-get">
      <div class="container-wide">
        <header class="ea-head ea-head--split">
          <div><span class="ea-kicker">WHAT THE WORK CONTAINS</span><h2>Decision-ready intelligence, with the evidence behind it.</h2></div>
          <p>The competitive set, evidence depth and response work change with the question. The evidence standard does not.</p>
        </header>
        <div class="ea-outputs__grid">
          <article><span>01</span><small>DISCOVERY</small><h3>Competitive Set Scan</h3><p>Identify and validate candidates instead of assuming the known list is complete.</p></article>
          <article><span>02</span><small>DEEP DIVE</small><h3>The competitors that matter</h3><p>Investigate product, pricing, positioning, public claims and recent moves where relevant.</p></article>
          <article><span>03</span><small>CLASSIFICATION</small><h3>Fact · Inference · Unknown</h3><p>Keep verified findings separate from judgment and unresolved gaps.</p></article>
          <article><span>04</span><small>EXECUTIVE VIEW</small><h3>Executive Intelligence Deck</h3><p>A concise PDF built for senior review, implications and decisions.</p></article>
          <article><span>05</span><small>EVIDENCE VIEW</small><h3>Evidence Appendix</h3><p>Sources, source classes, review dates, limitations and contradictions.</p></article>
          <article><span>06</span><small>RESULT</small><h3>A stronger competitive view</h3><p>What the evidence supports, what it cannot support and what deserves attention next.</p></article>
        </div>
      </div>
    </section>

    <section class="ea-section ea-system" data-surface="dark">
      <div class="container-wide ea-system__grid">
        <div>
          <span class="ea-kicker ea-kicker--light">RESEARCH SYSTEM</span>
          <h2>From public source to executive decision.</h2>
          <p>No old sales video. No hidden magic. The method is visible: discover, verify, classify, connect the evidence, and show where certainty ends.</p>
          <div class="ea-system__chips mono"><span>DISCOVER</span><span>VERIFY</span><span>CLASSIFY</span><span>DECIDE</span></div>
          <a class="ea-text-link ea-text-link--light" href="/method/">Walk through the full method →</a>
        </div>
        <figure class="ea-media ea-media--dark" data-lightbox data-lightbox-caption="Evidence Axis method from source discovery to decision implication.">
          <img src="/assets/v10/approved/method-from-source-to-decision.webp" alt="Evidence Axis method visual from checked source to decision implication" width="960" height="540" loading="lazy" />
          <figcaption class="mono">CLICK TO EXPAND · SOURCE → DECISION</figcaption>
        </figure>
      </div>
    </section>

    <section class="ea-final">
      <div class="container ea-final__inner">
        <span class="ea-kicker">START WITH THE WORK — OR THE DECISION</span>
        <h2>See the evidence on your company.</h2>
        <p>Request a complimentary company-specific brief, or send a competitive decision that already needs deeper support.</p>
        <div class="ea-actions ea-actions--center">
          <a class="ea-btn ea-btn--dark" href={cta.primary.href}>{cta.primary.label}<span>→</span></a>
          <a class="ea-btn ea-btn--ghost" href={cta.secondary.href}>{cta.secondary.label}<span>→</span></a>
        </div>
        <a class="ea-final__email" href={`mailto:${contact.emailDisplay}`}>{contact.emailDisplay}</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .ea-home{background:#f8f5ef}.ea-section{padding:clamp(3.8rem,6vw,6.2rem) 0}.ea-kicker{display:block;font:800 .64rem/1 var(--font-mono);letter-spacing:.14em;color:#277d91}.ea-kicker--light{color:#64e2da}.ea-head{margin-bottom:2rem}.ea-head--split{display:grid;grid-template-columns:1.08fr .72fr;gap:clamp(2rem,6vw,5rem);align-items:end}.ea-head h2,.ea-standard h2,.ea-sample h2,.ea-system h2,.ea-final h2{margin:.65rem 0 0;font-size:clamp(2.65rem,4.6vw,5rem);line-height:.95;letter-spacing:-.052em}.ea-head>p,.ea-standard__copy>p,.ea-sample__copy>p,.ea-system p,.ea-final p{margin:0;color:#627084;line-height:1.7;font-size:1.02rem}.ea-text-link{display:inline-flex;margin-top:1rem;font-family:var(--font-display);font-weight:800;text-decoration:none;color:#1f6e86}.ea-text-link--light{color:#80e6df}.ea-btn{display:inline-flex;align-items:center;justify-content:center;gap:.65rem;min-height:3.05rem;padding:0 1rem;border-radius:.72rem;background:#0b1b2f;color:#fff;font-family:var(--font-display);font-weight:800;text-decoration:none;box-shadow:0 14px 34px rgba(18,33,52,.14)}.ea-btn--dark{background:linear-gradient(115deg,#9abaff,#53ddd6);color:#06111b}.ea-btn--ghost{background:transparent;color:#0d2037;border:1px solid rgba(26,55,86,.2);box-shadow:none}.ea-actions{display:flex;flex-wrap:wrap;gap:.7rem;align-items:center;margin-top:1.35rem}.ea-actions--center{justify-content:center}
  .ea-proof{background:#06101e;color:#eff6ff;border-top:1px solid rgba(115,161,221,.15);border-bottom:1px solid rgba(115,161,221,.15)}.ea-proof__grid{display:grid;grid-template-columns:repeat(4,1fr)}.ea-proof article{padding:1.15rem 1.25rem;border-left:1px solid rgba(120,161,215,.15)}.ea-proof span{font:800 .6rem/1 var(--font-mono);color:#5be1d9}.ea-proof b{display:block;margin:.45rem 0 .25rem;font:800 1.08rem/1 var(--font-display)}.ea-proof p{margin:0;color:#92a7c2;font-size:.78rem;line-height:1.45}
  .ea-brief{min-height:min(100svh,62rem);display:flex;align-items:center;background:radial-gradient(circle at 14% 10%,rgba(35,194,189,.12),transparent 28%),radial-gradient(circle at 85% 70%,rgba(124,92,226,.08),transparent 30%),#05101f;color:#f3f8ff}.ea-offer-head{display:grid;grid-template-columns:1.08fr .72fr;gap:clamp(2rem,6vw,5rem);align-items:end;margin-bottom:1rem}.ea-offer-head h2{margin:.55rem 0 0;font-size:clamp(2.4rem,4vw,4.5rem);line-height:.92;letter-spacing:-.055em}.ea-offer-head>p{margin:0;color:#b0c2d8;line-height:1.55;font-size:1rem}.ea-start-card{display:grid;grid-template-columns:1.05fr 1.3fr auto;gap:1rem;align-items:center;padding:1.05rem 1.15rem;border:1px solid rgba(84,224,216,.36);border-top:4px solid #2ac8c2;border-radius:1rem;background:linear-gradient(120deg,rgba(11,49,68,.98),rgba(8,27,47,.98));box-shadow:0 24px 60px rgba(0,0,0,.28),0 0 45px rgba(42,200,194,.06)}.ea-start-card__title>span{font-size:.55rem;letter-spacing:.1em;color:#62e0d8}.ea-start-card__title h3{margin:.45rem 0 .35rem;font-size:clamp(1.4rem,2.15vw,2.2rem);line-height:1}.ea-start-card__title p{margin:0;color:#b8c8da;font-size:.82rem;line-height:1.42}.ea-start-card__deliverables{display:grid;grid-template-columns:1fr 1fr;gap:.45rem}.ea-start-card__deliverables span{display:flex;align-items:center;gap:.45rem;padding:.55rem .65rem;border-radius:.55rem;background:rgba(255,255,255,.055);color:#e4eef8;font-size:.75rem}.ea-start-card__deliverables b{color:#5ce0d8;font:800 .52rem/1 var(--font-mono)}.ea-start-card__action{display:grid;gap:.55rem;min-width:14rem}.ea-start-card__action small{text-align:center;color:#a8bad0;font-size:.5rem;letter-spacing:.07em}.ea-paid-label{display:flex;justify-content:space-between;gap:2rem;align-items:center;margin:.9rem 0 .55rem}.ea-paid-label p{margin:0;color:#9cb0c9;font-size:.76rem}.ea-package-map{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.ea-package{display:flex;flex-direction:column;min-height:24rem;padding:1.15rem;border:1px solid rgba(60,213,205,.3);border-top:5px solid #28c7c2;border-radius:1rem;background:linear-gradient(145deg,#08192d,#0b2138);color:#f3f8ff;text-decoration:none;box-shadow:0 22px 52px rgba(0,0,0,.26);transition:transform .2s ease,border-color .2s ease}.ea-package:hover{transform:translateY(-4px);border-color:rgba(91,224,214,.65)}.ea-package>span{font-size:.56rem;letter-spacing:.11em;color:#56ddd5}.ea-package h4{margin:.65rem 0 .5rem;font-size:clamp(1.35rem,1.8vw,1.8rem);line-height:1.02}.ea-package p{margin:0;color:#b1c1d4;line-height:1.45;font-size:.82rem}.ea-package__quote{margin:.8rem 0 .55rem;padding:.75rem .85rem;border:1px solid rgba(45,202,196,.3);border-radius:.75rem;background:linear-gradient(110deg,rgba(28,190,184,.18),rgba(255,255,255,.02))}.ea-package__quote small,.ea-package__delivery small{display:block;margin:0 0 .3rem;padding:0;border:0;font:800 .5rem/1 var(--font-mono);letter-spacing:.1em;color:#58dbd4}.ea-package__quote strong{display:block;font:780 clamp(1.75rem,2.5vw,2.65rem)/.95 var(--font-display);letter-spacing:-.045em;color:#fff}.ea-package__delivery{padding:.6rem .75rem;border-radius:.62rem;background:rgba(255,255,255,.045)}.ea-package__delivery b{display:block;margin:0;padding:0;font-size:.76rem;color:#eef5fc}.ea-package ul{margin:.65rem 0;padding-left:1.05rem;display:grid;gap:.22rem;color:#aebfd2;font-size:.75rem;line-height:1.35}.ea-package__cta{display:block!important;margin-top:auto!important;padding:.7rem .8rem!important;border-radius:.6rem;background:#28c7c2!important;color:#06131e!important;font:800 .72rem/1 var(--font-display)!important;letter-spacing:0!important}.ea-package--response{border-top-color:#f3a63d}.ea-package--response>span{color:#f5ae4d}.ea-package--response .ea-package__quote{border-color:rgba(243,166,61,.32);background:linear-gradient(110deg,rgba(243,166,61,.19),rgba(255,255,255,.02))}.ea-package--response .ea-package__quote small,.ea-package--response .ea-package__delivery small{color:#f5ae4d}.ea-package--response .ea-package__cta{background:#f3a63d!important}.ea-package--radar{border-top-color:#7c5ce2}.ea-package--radar>span{color:#9b80f5}.ea-package--radar .ea-package__quote{border-color:rgba(124,92,226,.38);background:linear-gradient(110deg,rgba(124,92,226,.22),rgba(255,255,255,.02))}.ea-package--radar .ea-package__quote small,.ea-package--radar .ea-package__delivery small{color:#a489ff}.ea-package--radar .ea-package__cta{background:#7c5ce2!important;color:#fff!important}
  .ea-offer-head h2,.ea-start-card__title h3,.ea-package h4{color:#f3f8ff}
