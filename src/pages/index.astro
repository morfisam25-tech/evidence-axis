play:block;margin-top:.3rem;color:#cbd5e4;font-size:.78rem}.offer4 ul{grid-column:1/-1;list-style:none;padding:0;margin:1.15rem 0 0;display:grid;gap:.55rem}.offer4 li{display:flex;align-items:center;gap:.55rem;color:#b5c1d1;font-size:.84rem}.offer4 li i{color:var(--cyan);font-style:normal}.offer4>a{margin-top:auto;display:flex;align-items:center;justify-content:space-between;min-height:3.3rem;padding:0 1.3rem;border-top:1px solid rgba(121,156,211,.13);color:#e8eef8;text-decoration:none;font-family:var(--font-display);font-size:.88rem;font-weight:600;background:rgba(5,15,29,.48)}.offer4--featured>a{background:linear-gradient(110deg,rgba(77,128,235,.2),rgba(45,197,217,.08));color:#eef5ff}.offer4>a span{color:var(--cyan)}.offer4:not(.offer4--featured) .offer4__body{padding-block:1rem}.offer4:not(.offer4--featured) .offer4__body h3{font-size:1.25rem}.offer4:not(.offer4--featured) .offer4__price strong{font-size:1.9rem}.offer4:not(.offer4--featured) ul{grid-template-columns:repeat(2,1fr);gap:.4rem .7rem}.offer4:not(.offer4--featured) li{font-size:.76rem}

  .questions4{background:#030a14}.questions4__grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(19rem,.6fr) minmax(30rem,1fr);gap:clamp(3rem,6vw,7rem);align-items:start}.questions4__accordion{display:grid;gap:.55rem}.question4{border:1px solid rgba(121,156,211,.16);border-radius:.85rem;background:linear-gradient(135deg,rgba(11,27,49,.92),rgba(6,17,31,.95));overflow:hidden;transition:border-color 170ms ease,background 170ms ease}.question4[open]{border-color:rgba(93,151,255,.38);background:linear-gradient(135deg,rgba(16,38,70,.96),rgba(7,20,38,.97))}.question4 summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:2.4rem 1fr auto;gap:.8rem;align-items:center;padding:1rem 1.1rem}.question4 summary::-webkit-details-marker{display:none}.question4 summary>span{color:#6f91c6;font-size:.59rem}.question4 summary strong{color:#dce5f2;font-family:var(--font-display);font-size:.98rem;line-height:1.35;font-weight:560}.question4 summary i{width:1.75rem;height:1.75rem;display:grid;place-items:center;border-radius:50%;border:1px solid rgba(113,152,216,.22);color:#5de0dd;font-style:normal;transition:transform 180ms ease}.question4[open] summary i{transform:rotate(45deg)}.question4>div{padding:0 1.1rem 1.1rem 4.3rem}.question4>div small{color:#6f85a3;font-size:.54rem;letter-spacing:.11em}.question4>div p{margin-top:.4rem;color:#9eafc3;font-size:.9rem;line-height:1.55}.question4>div a{display:inline-flex;gap:.45rem;margin-top:.7rem;color:#61dedb;text-decoration:none;font-size:.8rem;font-weight:600}

  .sample4{background:radial-gradient(circle at 72% 50%,rgba(45,104,212,.09),transparent 30rem),#030a14}.sample4__grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(19rem,.55fr) minmax(34rem,1fr);gap:clamp(3rem,5vw,6rem);align-items:center}.sample4__actions{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:1.25rem}.sample4__actions .link4{margin-top:0}.sample4__screen{border:1px solid rgba(115,153,214,.22);border-radius:1rem;overflow:hidden;background:#061120;box-shadow:0 35px 80px rgba(0,0,0,.28)}.sample4__chrome{height:3rem;display:grid;grid-template-columns:auto 1fr auto;gap:1rem;align-items:center;padding:0 1rem;border-bottom:1px solid rgba(115,153,214,.15);background:#0a1728}.sample4__chrome>div{display:flex;gap:.35rem}.sample4__chrome i{display:block;width:.55rem;height:.55rem;border-radius:50%;background:#354863}.sample4__chrome span{text-align:center;color:#6f84a4;font-size:.55rem;letter-spacing:.08em}.sample4__chrome b{font-family:var(--font-mono);font-size:.5rem;color:#58dedb;letter-spacing:.08em}.sample4__preview{padding:1rem}

