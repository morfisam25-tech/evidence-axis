---
import Base from '@layouts/Base.astro';
import Hero from '@components/Hero.astro';
import FactInferenceUnknown from '@components/FactInferenceUnknown.astro';
import EvidenceChain from '@components/EvidenceChain.astro';
import ProcessFlow from '@components/ProcessFlow.astro';
import ReportPreview from '@components/ReportPreview.astro';
import { site, offers, cta } from '@config/site';
import { methodSteps } from '@data/method';

const questions = [
  { q: 'Which advertised capabilities appear to be genuinely shipped?', angle: 'Compare product pages against documentation, changelogs, help content, and other public proof.' },
  { q: 'How do two competitors package the same capability differently?', angle: 'Separate naming and positioning from the actual offer, limits, pricing, and evidence of delivery.' },
  { q: 'Where does publicly visible pricing and packaging actually diverge?', angle: 'Map plans, limits, add-ons, packaging logic, and the gaps that matter to the decision.' },
  { q: 'What product gaps have public evidence behind them?', angle: 'Distinguish a real observable gap from a claim that simply cannot be established publicly.' },
  { q: 'What remains unknown after reasonable public investigation?', angle: 'Record the boundary explicitly instead of filling it with guesswork.' },
];

const offerPaths = [
  {
    id: '01', eyebrow: 'Fast decision', name: offers.twoCompetitor.name,
    price: offers.twoCompetitor.priceDisplay, note: offers.twoCompetitor.priceNote,
    delivery: offers.twoCompetitor.delivery,
    bestFor: 'One decision that depends on two competitors.',
    points: ['One defined decision question','Two named competitors','Fact / Inference / Unknown matrix','Source register + decision implications'],
    href: '/competitor-brief/', cta: 'Start with two competitors', featured: true,
  },
  {
    id: '02', eyebrow: 'Broader field', name: offers.fiveCompetitor.name,
    price: offers.fiveCompetitor.priceDisplay, note: offers.fiveCompetitor.priceNote,
    delivery: offers.fiveCompetitor.delivery,
    bestFor: 'One question across a wider competitor set.',
    points: ['Five named competitors','Positioning + packaging evidence','Contradictions surfaced','Decision implications'],
    href: '/competitor-brief/', cta: 'Expand the field', featured: false,
  },
  {
    id: '03', eyebrow: 'Custom investigation', name: offers.blueprint.name,
    price: 'Custom scope', note: 'Scoped to the decision',
    delivery: offers.blueprint.delivery,
    bestFor: 'A strategic decision that needs a larger evidence base.',
    points: ['Decision-specific scope','Category + offer architecture','Deeper evidence synthesis','Custom decision framework'],
    href: '/strategic-blueprint/', cta: 'Discuss scope', featured: false,
  },
];
---
<Base title={site.name} description={site.description} path="/">
  <Hero />

  <main class="home4">
    <section class="home4-section gap4" data-surface="dark">
      <div class="container-wide gap4__grid">
        <div class="section-copy section-copy--sticky">
          <span class="kicker4 mono">01 / THE DECISION GAP</span>
          <h2>Competitor data is everywhere. <em>Decision-grade evidence isn’t.</em></h2>
          <p>Most teams already have tabs, screenshots, review snippets, launch posts, and feature claims. The hard part is deciding which signals deserve to influence a real decision.</p>
        </div>

        <div class="gap4__board">
          <article class="gap-card gap-card--blue" data-reveal>
            <div class="gap-card__top"><span class="mono">A / CLAIM CHECK</span><b>MARKETING ≠ SHIPPED</b></div>
            <h3>A feature name does not prove how the product actually behaves.</h3>
            <p>Documentation, release evidence, product behavior, and dates carry more weight than a landing-page headline.</p>
            <div class="gap-card__signal"><span></span><span></span><span></span></div>
          </article>
          <article class="gap-card gap-card--amber" data-reveal style="--reveal-delay:80ms;">
            <div class="gap-card__top"><span class="mono">B / CONFIDENCE</span><b>SIGNAL ≠ CERTAINTY</b></div>
            <h3>A clue becomes dangerous when its confidence is invisible.</h3>
            <p>Each material claim is separated into what is supported, inferred, or still unknown.</p>
            <div class="gap-card__meter"><i></i><i></i><i></i><i></i><i></i></div>
          </article>
          <article class="gap-card gap-card--cyan" data-reveal style="--reveal-delay:160ms;">
            <div class="gap-card__top"><span class="mono">C / BOUNDARY</span><b>NOISE ≠ DECISION SUPPORT</b></div>
            <h3>The decision determines what gets investigated.</h3>
            <p>No encyclopedic competitor deck. The research stays inside the boundary of the move you are considering.</p>
            <div class="gap-card__route"><span>QUESTION</span><i>→</i><span>EVIDENCE</span><i>→</i><span>MOVE</span></div>
          </article>
        </div>
      </div>
    </section>

    <section class="home4-section model4" data-surface="dark">
      <div class="container-wide">
        <div class="section-head4">
          <div><span class="kicker4 mono">02 / THE EVIDENCE MODEL</span><h2>Three states. No blurred middle.</h2></div>
          <p>Every material claim is forced into a visible state before it reaches the brief. That makes the difference between proof and judgment readable at a glance.</p>
        </div>
        <div class="model4__surface"><FactInferenceUnknown /></div>
      </div>
    </section>

    <section class="home4-section trace4" data-surface="dark">
      <div class="container-wide trace4__grid">
        <div class="section-copy">
          <span class="kicker4 mono">03 / TRACEABLE REASONING</span>
          <h2>A conclusion should be reversible.</h2>
          <p>Follow any conclusion backward through the inference, fact, observation, and public source that produced it. If the route breaks, certainty stops there.</p>
          <a href="/method/" class="link4">See the research method <span>→</span></a>
        </div>
        <div class="trace4__console"><EvidenceChain /></div>
      </div>
    </section>

    <section class="home4-section offers4" id="services" data-surface="dark">
      <div class="container-wide">
        <div class="section-head4">
          <div><span class="kicker4 mono">04 / ENGAGEMENT PATHS</span><h2>Choose by decision size.</h2></div>
          <p>The entry point changes with the amount of competitive territory the decision requires. The research discipline stays the same.</p>
        </div>

        <div class="offers4__grid">
          {offerPaths.map((offer) => (
            <article class:list={['offer4', { 'offer4--featured': offer.featured }]}>
              <div class="offer4__head">
                <span class="mono">{offer.id}</span>
                <small>{offer.eyebrow}</small>
                {offer.featured && <b>BEST STARTING POINT</b>}
              </div>
              <div class="offer4__body">
                <h3>{offer.name}</h3>
                <p>{offer.bestFor}</p>
                <div class="offer4__price"><strong>{offer.price}</strong><span>{offer.note}</span></div>
                <div class="offer4__delivery"><small>DELIVERY</small><b>{offer.delivery}</b></div>
                <ul>{offer.points.map((p) => <li><i>✓</i>{p}</li>)}</ul>
              </div>
              <a href={offer.href}>{offer.cta}<span>→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home4-section questions4" data-surface="dark">
      <div class="container-wide questions4__grid">
        <div class="section-copy section-copy--sticky">
          <span class="kicker4 mono">05 / QUESTIONS THAT FIT</span>
          <h2>Bring a decision, not a topic.</h2>
          <p>A strong brief begins with something your team may actually do differently after seeing the evidence.</p>
        </div>
        <div class="questions4__accordion">
          {questions.map((item, i) => (
            <details class="question4" open={i === 0}>
              <summary><span class="mono">Q0{i + 1}</span><strong>{item.q}</strong><i>+</i></summary>
              <div><small class="mono">WHAT THE BRIEF WOULD TEST</small><p>{item.angle}</p><a href="/competitor-brief/">Use this question <span>→</span></a></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="home4-section sample4" data-surface="dark">
      <div class="container-wide sample4__grid">
        <div class="section-copy">
          <span class="kicker4 mono">06 / THE DELIVERABLE</span>
          <h2>Inspect the structure before you buy.</h2>
          <p>The live sample uses the same source discipline, claim classification, and explicit limits used in a client brief.</p>
          <div class="sample4__actions"><a href="/sample-report/" class="button4">View sample report <span>→</span></a><a href="/report/evidence-axis-sample-intercom-vs-zendesk.pdf" class="link4">Open PDF</a></div>
        </div>
        <div class="sample4__screen">
          <div class="sample4__chrome"><div><i></i><i></i><i></i></div><span class="mono">EA / SAMPLE BRIEF / INTERCOM VS ZENDESK</span><b>LIVE</b></div>
          <div class="sample4__preview"><ReportPreview /></div>
        </div>
      </div>
    </section>

    <section class="home4-section process4" data-surface="dark">
      <div class="container-wide">
        <div class="section-head4">
          <div><span class="kicker4 mono">07 / DELIVERY</span><h2>Question in. Evidence brief out.</h2></div>
          <p>The workflow is asynchronous. You define the decision context; the investigation is bounded, sourced, classified, and returned as a usable brief.</p>
        </div>
        <div class="process4__surface"><ProcessFlow steps={methodSteps.slice(0, 6)} columns /></div>
      </div>
    </section>

    <section class="home4-section boundary4" data-surface="dark">
      <div class="container-wide boundary4__grid">
        <div class="section-copy"><span class="kicker4 mono">08 / RESEARCH BOUNDARY</span><h2>When the evidence ends, the claim ends.</h2><p>Evidence Axis uses lawful public competitor evidence plus context you choose to share. Private-data gaps stay visible.</p></div>
        <div class="boundary4__cards">
          <article class="boundary4__card boundary4__card--in"><header><span>✓</span><b>IN SCOPE</b></header><p>Public pricing and product pages, documentation, help centres, changelogs, app marketplaces, public reviews, announcements, and other lawful public sources.</p></article>
          <article class="boundary4__card boundary4__card--out"><header><span>?</span><b>MARKED UNKNOWN</b></header><p>Confidential roadmaps, private revenue or churn, internal strategy, private usage metrics, or anything public evidence cannot establish.</p></article>
        </div>
      </div>
    </section>

    <section class="final4" data-surface="dark">
      <div class="final4__glow"></div>
      <div class="container final4__inner">
        <span class="kicker4 mono">READY WHEN THE DECISION IS</span>
        <h2>Start with the question your team keeps debating.</h2>
        <p>Send the competitors, the decision you are trying to make, and the context that changes what “better” means.</p>
        <div><a href={cta.primary.href} class="button4">{cta.primary.label}<span>→</span></a><a href="mailto:hello@evidenceaxis.com" class="link4">hello@evidenceaxis.com</a></div>
      </div>
    </section>
  </main>
</Base>

<style>
  .home4{--bg:#030a14;--panel:#071425;--line:rgba(118,155,214,.15);--blue:#78a3ff;--cyan:#59e7e3;--amber:#f1b35a;--violet:#a981f4;--muted:#9eacbf;background:var(--bg);color:#eef4ff}
