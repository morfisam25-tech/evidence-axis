---
import Base from '@layouts/Base.astro';
import Hero from '@components/Hero.astro';
import SectionIntro from '@components/SectionIntro.astro';
import FactInferenceUnknown from '@components/FactInferenceUnknown.astro';
import EvidenceChain from '@components/EvidenceChain.astro';
import ServiceOffer from '@components/ServiceOffer.astro';
import ProcessFlow from '@components/ProcessFlow.astro';
import ReportPreview from '@components/ReportPreview.astro';
import CTASection from '@components/CTASection.astro';
import { site, offers } from '@config/site';
import { methodSteps } from '@data/method';

const questions = [
  'Which advertised capabilities appear to be genuinely shipped, and which read as marketing language?',
  'How do two competitors position and package the same capability differently?',
  'Where does publicly visible pricing and packaging actually diverge?',
  'What product gaps have public evidence behind them?',
  'What remains unknown after reasonable public investigation?',
];
---
<Base title={site.name} description={site.description} path="/">
  <Hero />

  <!-- BUYER PROBLEM -->
  <section class="section" data-surface="dark">
    <div class="container-wide problem">
      <div class="problem__lead">
        <SectionIntro
          eyebrow="The problem"
          title="The issue is rarely a shortage of competitor information."
          lede="It is scattered across pricing pages, documentation, changelogs, marketplaces, reviews and announcements. What is missing is a clear line between what is verified, what is a reasonable inference, and what simply cannot be known."
        />
      </div>
      <ul class="problem__list axis-frame">
        <li class="axis-tick" data-reveal>
          <span class="label">Marketing vs. shipped</span>
          <p>A feature named on a landing page is not evidence that it works the way a buyer assumes.</p>
        </li>
        <li class="axis-tick" data-reveal style="--reveal-delay:80ms;">
          <span class="label">Signal vs. certainty</span>
          <p>A single review or a vague claim becomes a "fact" the moment nobody records where it came from.</p>
        </li>
        <li class="axis-tick" data-reveal style="--reveal-delay:160ms;">
          <span class="label">Noise vs. decision</span>
          <p>Most competitor decks answer questions no one is deciding on. The decision is what should set the boundary.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- WHAT WE DO / METHOD DEMONSTRATION -->
  <section class="section container">
    <SectionIntro
      eyebrow="The method"
      title="Every claim is sourced, dated, and marked."
      lede="Evidence Axis separates what the evidence supports from what it merely suggests, and names what it cannot establish. Three states run through the analysis, the report, and this site."
    />
    <div class="method-demo">
      <FactInferenceUnknown />
    </div>
  </section>

  <!-- EVIDENCE CHAIN -->
  <section class="section" data-surface="dark">
    <div class="container">
      <SectionIntro
        eyebrow="Traceable reasoning"
        title="A conclusion you can walk back to its source."
        lede="Nothing arrives as an assertion. Each decision implication keeps a visible path: from the public source, through the observation, to the fact, the inference, and the unknown."
      />
      <div class="chain-wrap">
        <EvidenceChain />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section container" id="services">
    <SectionIntro
      eyebrow="Services"
      title="Three ways to turn a question into evidence."
      lede="Fixed, transparent entry pricing. No subscription, no account, no checkout — the engagement starts with a question and a defined boundary."
    />
    <div class="offer-grid">
      <ServiceOffer
        name={offers.twoCompetitor.name}
        priceDisplay={offers.twoCompetitor.priceDisplay}
        priceNote={offers.twoCompetitor.priceNote}
        delivery={offers.twoCompetitor.delivery}
        scope={offers.twoCompetitor.scope}
        featured
        points={[
          'One defined decision question',
          'Two named competitors, or you vs. a competitor',
          'Evidence matrix with Fact / Inference / Unknown',
          'Source register with check dates',
        ]}
        href="/competitor-brief/"
      />
      <ServiceOffer
        name={offers.fiveCompetitor.name}
        priceDisplay={offers.fiveCompetitor.priceDisplay}
        priceNote={offers.fiveCompetitor.priceNote}
        delivery={offers.fiveCompetitor.delivery}
        scope={offers.fiveCompetitor.scope}
        points={[
          'Broader competitor set, one research question',
          'Positioning, packaging and capability evidence',
          'Contradictions and open unknowns surfaced',
          'Decision implications for your context',
        ]}
        href="/competitor-brief/"
      />
      <ServiceOffer
        name={offers.blueprint.name}
        priceDisplay={offers.blueprint.priceDisplay}
        priceNote={offers.blueprint.priceNote}
        delivery={offers.blueprint.delivery}
        scope={offers.blueprint.scope}
        points={[
          'Scoped around the decision to be made',
          'Category, positioning and offer architecture',
          'Deeper evidence base and synthesis',
        ]}
        href="/strategic-blueprint/"
        ctaLabel="Discuss scope"
      />
    </div>
  </section>

  <!-- EXAMPLE QUESTIONS -->
  <section class="section" data-surface="dark">
    <div class="container questions">
      <SectionIntro
        eyebrow="Questions that fit"
        title="Bring a decision, not a topic."
        lede="The service works best when a real choice is on the table. A few questions it is built to answer:"
      />
      <ul class="questions__list">
        {questions.map((q, i) => (
          <li class="questions__item" data-reveal style={`--reveal-delay:${i * 60}ms;`}>
            <span class="questions__n mono">Q{i + 1}</span>
            <p>{q}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SAMPLE REPORT PROMOTION -->
  <section class="section container">
    <div class="sample">
      <div class="sample__copy">
        <SectionIntro
          eyebrow="The deliverable"
          title="The report reads like the site: structured, sourced, honest about its limits."
          lede="You receive an executive decision summary, an evidence matrix, source-backed observations, contradictions, unknowns, and decision implications — not a wall of screenshots."
        />
        <div class="sample__actions">
          <a href="/sample-report/" class="btn btn--lg">View Sample Report<span class="btn-arrow" aria-hidden="true">→</span></a>
          <a href="/method/" class="btn btn--ghost btn--lg">See the method</a>
        </div>
      </div>
      <div class="sample__preview">
        <ReportPreview />
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section" data-surface="dark">
    <div class="container">
      <SectionIntro
        eyebrow="How it works"
        title="From decision question to decision brief."
        lede="Asynchronous by design. You send the question; the evidence comes back structured."
      />
      <div class="process-wrap">
        <ProcessFlow steps={methodSteps.slice(0, 6)} columns />
      </div>
    </div>
  </section>

  <!-- RESEARCH BOUNDARIES -->
  <section class="section container">
    <div class="boundaries axis-frame">
      <SectionIntro
        eyebrow="Research boundaries"
        title="What public evidence can — and cannot — establish."
      />
      <div class="boundaries__cols">
        <div class="boundaries__col" data-reveal>
          <h3 class="boundaries__h"><span class="state state--fact">In scope</span></h3>
          <p>Public websites, pricing and product pages, documentation, help centres, changelogs, app marketplaces, public reviews, announcements and other lawful public sources — plus anything you choose to share.</p>
        </div>
        <div class="boundaries__col" data-reveal style="--reveal-delay:100ms;">
          <h3 class="boundaries__h"><span class="state state--unknown">Out of scope</span></h3>
          <p>Confidential roadmaps, private revenue or churn, internal strategy, private usage metrics, or anything requiring unauthorized access. When the evidence runs out, we mark it Unknown rather than guess.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</Base>

<style>
  .problem { display: grid; gap: var(--space-xl); }
  .problem__list { list-style: none; padding: 0; display: grid; gap: var(--space-l); }
  .problem__list li p { margin-top: 0.4em; color: var(--text-muted); max-width: 52ch; }
  .method-demo { margin-top: var(--space-xl); }
  .chain-wrap { margin-top: var(--space-xl); max-width: 52rem; }
  .offer-grid { display: grid; gap: var(--space-m); margin-top: var(--space-xl); grid-template-columns: 1fr; }
  .questions__list { list-style: none; padding: 0; margin-top: var(--space-xl); display: grid; gap: 0; }
  .questions__item {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-m); align-items: baseline;
    padding: var(--space-m) 0; border-top: 1px solid var(--hairline);
  }
  .questions__item p { font-family: var(--font-serif); font-size: var(--step-1); color: var(--text); }
  .questions__n { color: var(--accent); font-size: 0.8rem; }
  .sample { display: grid; gap: var(--space-xl); align-items: center; }
  .sample__actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-l); }
  .process-wrap { margin-top: var(--space-xl); }
  .boundaries__cols { display: grid; gap: var(--space-l); margin-top: var(--space-l); }
  .boundaries__h { margin-bottom: var(--space-s); }
  .boundaries__col p { color: var(--text-muted); max-width: 48ch; }

  @media (min-width: 52rem) {
    .problem { grid-template-columns: 1fr 1fr; align-items: start; }
    .offer-grid { grid-template-columns: repeat(3, 1fr); }
    .sample { grid-template-columns: 1fr 1fr; }
    .boundaries__cols { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 64rem) {
    .problem__lead { position: sticky; top: 6rem; }
  }
</style>
