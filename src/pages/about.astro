---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import SectionIntro from '@components/SectionIntro.astro';
import CTASection from '@components/CTASection.astro';
import { legal } from '@config/site';

const standards = [
  { t: 'Discovery before assumption', d: 'The competitive set is scanned before the deep dive so the names already known internally do not automatically define the whole market.' },
  { t: 'Evidence before assertion', d: 'Every material factual finding stays attached to a source that was opened and checked.' },
  { t: 'Fact / Inference / Unknown', d: 'Verified fact, analytical interpretation and unresolved gaps remain visibly separate.' },
  { t: 'Contradictions stay visible', d: 'When credible sources disagree, Evidence Axis reports the conflict instead of picking the cleaner-looking answer.' },
  { t: 'Executive usefulness', d: 'Research is structured around what deserves attention and what decision or response may follow — not around page count.' },
  { t: 'Traceable by the client', d: 'The Evidence Appendix preserves source URLs, source classes, review dates, limitations and the path behind material conclusions.' },
];

const work = [
  { t: 'Complimentary Competitive Intelligence Brief', d: 'Company-specific competitive intelligence provided at no cost to verified inbound company employees, and proactively to selected outbound companies.' },
  { t: 'Competitive Decision Sprint', d: 'A paid engagement combining verified market evidence with the client’s actual decision context, constraints and priorities.' },
  { t: 'Competitive Response Sprint', d: 'Turns a defined competitive decision into battlecards, objection handling, pricing response, positioning, messaging and enablement.' },
  { t: 'Competitive Radar', d: 'Ongoing monitoring of decision-relevant competitor moves when the competitive picture needs to stay current.' },
];
---
<Base
  title="About"
  description="Evidence Axis is an independent competitive intelligence and decision-support firm that discovers overlooked competitors, verifies public evidence and turns it into executive-ready intelligence."
  path="/about/"
>
  <PageHeader
    eyebrow="About Evidence Axis"
    title="Independent competitive intelligence built for decisions, not information volume."
    lede="Evidence Axis discovers overlooked competitors, verifies what is actually happening in the public record, separates proof from judgment, and turns the evidence into executive-ready intelligence."
    meta={['Independent firm', 'Human-reviewed evidence', 'Executive-ready output']}
  />

  <section class="section container">
    <div class="ab13-lead">
      <SectionIntro eyebrow="The firm" title="What Evidence Axis is built to do." as="h2" />
      <div>
        <p>Competitive research becomes dangerous when fluent summaries make uncertain claims look settled. Evidence Axis is built around the opposite operating principle: discover broadly, verify directly, disclose the source class, preserve contradictions and name what cannot be established.</p>
        <p>The result is not a generic dashboard or a library of AI-generated competitor profiles. Each brief is assembled around a real company and a bounded competitive question, with the evidence trail kept visible behind the executive output.</p>
        <p>The public professional identity of the firm is <strong>{legal.publicOperator}</strong>. Evidence Axis works with clients through project engagements as an independent firm.</p>
      </div>
    </div>
  </section>

  <section class="section" data-surface="dark">
    <div class="container">
      <SectionIntro eyebrow="What we do" title="One intelligence engine, four commercial paths." />
      <div class="ab13-grid">
        {work.map((item, i) => <article><span class="mono">0{i+1}</span><h3>{item.t}</h3><p>{item.d}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section container">
    <SectionIntro eyebrow="Operating standard" title="The work should survive scrutiny." as="h2" />
    <div class="ab13-standards axis-frame">
      {standards.map((s) => <div class="axis-tick"><h3>{s.t}</h3><p>{s.d}</p></div>)}
    </div>
  </section>

  <section class="section ab13-boundary">
    <div class="container ab13-boundary__grid">
      <div><span class="label">RESEARCH BOUNDARY</span><h2>Public competitive evidence. Client context when provided.</h2></div>
      <div><p>Evidence Axis uses lawful, publicly accessible competitor information. A paid client may add its own internal context about the decision, sales process or priorities. Evidence Axis does not imply access to confidential or unauthorized competitor information.</p><a href="/method/">See the full method →</a></div>
    </div>
  </section>

  <CTASection />
</Base>

<style>
  .ab13-lead{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:clamp(2rem,7vw,6rem);align-items:start}.ab13-lead p{font-size:1.05rem;line-height:1.75;color:var(--text-muted);margin:0 0 1rem}.ab13-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:var(--space-xl)}.ab13-grid article{padding:1.5rem;border:1px solid var(--hairline);border-radius:.8rem;background:color-mix(in srgb,var(--bg-raised) 78%,transparent)}.ab13-grid span{color:var(--accent);font-size:.72rem}.ab13-grid h3{margin:.7rem 0 .45rem}.ab13-grid p{margin:0;color:var(--text-muted);line-height:1.6}.ab13-standards{margin-top:var(--space-xl)}.ab13-standards>div{display:grid;grid-template-columns:minmax(13rem,.7fr) 1.3fr;gap:2rem;padding:1.1rem 0;border-top:1px solid var(--hairline);align-items:baseline}.ab13-standards h3,.ab13-standards p{margin:0}.ab13-standards p{color:var(--text-muted)}.ab13-boundary{background:var(--bg-raised)}.ab13-boundary__grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,6rem)}.ab13-boundary h2{font-size:clamp(2rem,4vw,3.7rem);line-height:1;letter-spacing:-.04em;margin:.6rem 0}.ab13-boundary p{color:var(--text-muted);line-height:1.7}.ab13-boundary a{font-family:var(--font-display);font-weight:750;text-decoration:none}@media(max-width:780px){.ab13-lead,.ab13-grid,.ab13-standards>div,.ab13-boundary__grid{grid-template-columns:1fr}}
</style>
