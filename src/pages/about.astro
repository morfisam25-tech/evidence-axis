---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import SectionIntro from '@components/SectionIntro.astro';
import CTASection from '@components/CTASection.astro';

const standards = [
  { t: 'Evidence before assertion', d: 'Nothing enters a brief as a bare claim. Every material finding carries its source and the date it was checked.' },
  { t: 'Separate what is known from what is inferred', d: 'Fact, Inference and Unknown remain visibly distinct — in the research process and in the final brief.' },
  { t: 'Name the unknowns', d: 'When public evidence runs out, that boundary is stated plainly rather than filled with a confident-sounding guess.' },
  { t: 'Public evidence, plus your context', d: 'Competitor findings come from lawful, publicly accessible evidence, plus whatever context a client chooses to share. No private competitor data.' },
  { t: 'Decision usefulness over volume', d: 'A brief is measured by whether it helps a team decide — not by page count, screenshot count or research theatre.' },
  { t: 'Verifiable by you', d: 'Sources are listed so a finding can be checked independently. The method is designed to withstand scrutiny.' },
];

const services = [
  { t: 'Competitive Intelligence', d: 'Structured competitor briefs that separate verified facts from inferences — so you know exactly what you actually know about your rivals before making a move.' },
  { t: 'Market Research', d: 'Market sizing, demand analysis, pricing benchmarks, customer segments, and entry barriers — for companies looking seriously at Turkey, the Middle East, and the GCC.' },
  { t: 'Go-to-Market Strategy', d: 'Positioning, channel selection, pricing, and a step-by-step launch plan anchored in real market data, not generic templates.' },
  { t: 'Market-Entry Planning', d: 'Country-specific entry strategies: regulations, local partners, competitive landscape, and a practical 90-day roadmap. Built from direct regional experience.' },
  { t: 'Business Plans & Investor Documents', d: 'Investor-ready business plans, financial assumptions, and pitch narratives built on actual market research — not theoretical projections.' },
];

const capabilities = [
  { t: 'Turkey, Middle East & GCC — direct operations', d: 'Over a decade of active business operations across Turkey, the Gulf, and Central Asia — covering commodity trading, technology distribution, and food manufacturing. Not desk research. Direct experience.' },
  { t: 'Multilingual research advantage', d: 'Evidence Axis operates in English, Turkish, Persian, and Azerbaijani — reaching primary sources and on-the-ground intelligence that English-only research firms simply cannot access.' },
  { t: 'Full commercial cycle depth', d: 'From product strategy and national sales management in consumer electronics through founding and scaling industrial operations — the firm brings end-to-end commercial perspective to every brief.' },
  { t: 'Commodity and industrial markets', d: 'Deep operational knowledge of petroleum, petrochemicals, chemicals, and fertilizer markets across the MENA region and Central Asia — built through years of active trading, not secondary sources.' },
];
---
<Base
  title="About"
  description="Evidence Axis is a competitive intelligence and market strategy firm specialising in Turkey, the Middle East, and the GCC — built on 20 years of direct regional business experience."
  path="/about/"
>
  <PageHeader
    eyebrow="About Evidence Axis"
    title="Competitive intelligence built on 20 years of real regional experience."
    lede="Evidence Axis is a market research and competitive intelligence firm specialising in Turkey, the Middle East, and the GCC. Every engagement draws on two decades of direct business operations across these markets — not generic desk research."
  />

  <section class="about-visual-section">
    <div class="container-wide">
      <figure class="about-visual-frame">
        <img src="/assets/v10/premium/strategy-war-room.webp" alt="Evidence Axis — competitive intelligence and market strategy" loading="eager" />
        <figcaption><span>THE STANDARD</span><b>Source → evidence state → reasoning → decision</b></figcaption>
      </figure>
    </div>
  </section>

  <!-- THE FIRM -->
  <section class="section container">
    <div class="firm-wrap">
      <SectionIntro eyebrow="The firm" title="What Evidence Axis brings to an engagement." as="h2" />
      <div class="firm-body">
        <p class="about-lead__p">
          Evidence Axis is a competitive intelligence and market strategy firm with 20 years of direct operational experience across Turkey, the Middle East, the GCC, and Central Asia. The firm has operated across commodity trading, technology distribution, food manufacturing, and consumer electronics — giving it a commercial depth that generalist research firms cannot replicate.
        </p>
        <p class="about-lead__p">
          Research draws on multilingual access — English, Turkish, Persian, and Azerbaijani — reaching primary sources that most international consulting firms cannot reach. Every engagement is led at senior level, with no junior handoffs and no account management layers between client and analyst.
        </p>
        <p class="about-lead__p">
          Evidence Axis exists because most competitor research is built on confident-sounding assertions that fall apart the moment someone asks "how do you know that?" The firm's standard is simple: state what the evidence actually shows, keep facts visibly separate from inferences, and never fill a gap with a guess.
        </p>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="section" data-surface="dark">
    <div class="container">
      <SectionIntro
        eyebrow="Firm capabilities"
        title="What 20 years of regional operations looks like in practice."
        lede="Evidence Axis's research capabilities are built on direct operational experience — not credentials alone."
      />
      <dl class="std axis-frame">
        {capabilities.map((s) => (
          <div class="std__row axis-tick" data-reveal>
            <dt class="std__t">{s.t}</dt>
            <dd class="std__d">{s.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section container">
    <SectionIntro
      eyebrow="What we do"
      title="Five disciplines. No scope creep."
      lede="Every engagement is scoped to one of these disciplines. No vague 'consulting,' no scope creep, no deliverable that can't be used."
    />
    <dl class="std axis-frame">
      {services.map((s) => (
        <div class="std__row axis-tick" data-reveal>
          <dt class="std__t">{s.t}</dt>
          <dd class="std__d">{s.d}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- WORKING STANDARDS -->
  <section class="section" data-surface="dark">
    <div class="container">
      <SectionIntro
        eyebrow="Working standards"
        title="The standards are the product."
        lede="These operating rules apply to every engagement. They are not marketing language — they are the reason the work holds up when someone checks it."
      />
      <dl class="std axis-frame">
        {standards.map((s) => (
          <div class="std__row axis-tick" data-reveal>
            <dt class="std__t">{s.t}</dt>
            <dd class="std__d">{s.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- LEADERSHIP -->
  <section class="section team-section">
    <div class="container">
      <div class="team-split">
        <div class="team-copy">
          <SectionIntro eyebrow="Leadership" title="Sai Morfi — Founder & Managing Director." as="h2" />
          <p class="about-lead__p">
            Sai Morfi founded Evidence Axis after 20 years leading business operations across Turkey, the Gulf, and Central Asia — including Unique Holding A.Ş. (international commodity trading), senior national management at Sony Gulf, and founding and scaling a food manufacturing group to 140+ employees and 35,000 meals per day.
          </p>
          <p class="about-lead__p" style="color:var(--text-muted);">
            Every engagement at Evidence Axis is led by Sai directly. Engagements are asynchronous and tightly scoped so the research stays close to the decision it is meant to serve. The scope is agreed in writing before work begins. No surprises.
          </p>
        </div>
        <figure class="team-photo-frame" data-reveal>
          <img src="/assets/v10/approved/team-photo.webp" alt="Sai Morfi, Founder of Evidence Axis" loading="lazy" width="848" height="1098" />
        </figure>
      </div>
    </div>
  </section>

  <!-- TRACK RECORD -->
  <section class="section" data-surface="dark">
    <div class="container">
      <div class="track-record axis-frame">
        <SectionIntro
          eyebrow="Track record"
          title="What the method has produced."
          as="h2"
          lede="One complete anonymised engagement shows the method at full depth — from baseline audit through investor-ready documentation."
        />
        <div class="tr-grid">
          <div class="tr-item" data-reveal>
            <span class="tr-n">20+</span>
            <span class="tr-l">Years of direct operational experience across Turkey, the Middle East, and Central Asia</span>
          </div>
          <div class="tr-item" data-reveal style="--reveal-delay:60ms;">
            <span class="tr-n">350</span>
            <span class="tr-l">Market entities mapped in a single competitive intelligence phase</span>
          </div>
          <div class="tr-item" data-reveal style="--reveal-delay:120ms;">
            <span class="tr-n">4</span>
            <span class="tr-l">Phases from baseline audit to investor-ready capital model — zero scope surprises</span>
          </div>
          <div class="tr-item" data-reveal style="--reveal-delay:180ms;">
            <span class="tr-n">10+</span>
            <span class="tr-l">Deliverables across competitive intelligence, product strategy, and capital planning</span>
          </div>
        </div>
        <a href="/work/" class="link-arrow tr-link">
          Read the full case study<span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <CTASection title="Put the method to work." />
</Base>

<style>
  .about-visual-section { padding: 2rem 0 0; background: linear-gradient(180deg,#07111f,#f7f2ea 88%); }
  .about-visual-frame { position: relative; margin: 0; overflow: hidden; border-radius: 1.4rem; border: 1px solid rgba(105,164,235,.28); box-shadow: 0 34px 80px rgba(11,24,42,.26); background:#06111e; }
  .about-visual-frame img { display:block; width:100%; height:auto; max-height:38rem; object-fit:cover; }
  .about-visual-frame figcaption { position:absolute; left:1rem; right:1rem; bottom:1rem; display:flex; gap:.7rem; align-items:center; padding:.75rem .9rem; border-radius:.72rem; background:rgba(2,9,19,.76); backdrop-filter:blur(12px); color:#fff; }
  .about-visual-frame figcaption span { font:800 .62rem/1 var(--font-mono); letter-spacing:.13em; color:#58ded7; }
  .about-visual-frame figcaption b { font:700 .82rem/1.2 var(--font-display); }
  .about-lead__p { font-size: var(--step-1); color: var(--text-muted); margin-bottom: var(--space-m); }
  .about-lead__p:first-child { color: var(--text); }
  .firm-wrap { display: grid; gap: var(--space-xl); }
  .firm-body { display: grid; gap: 0; max-width: 72ch; }
  .std { margin-top: var(--space-xl); display: grid; gap: 0; }
  .std__row { display: grid; gap: var(--space-2xs); padding: var(--space-m) 0; border-top: 1px solid var(--hairline); }
  .std__t { font-family: var(--font-display); font-weight: 500; font-size: var(--step-1); }
  .std__d { color: var(--text-muted); max-width: 60ch; }
  .track-record { display: grid; gap: var(--space-l); }
  .tr-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); border-radius: var(--radius-m); overflow: hidden; }
  .tr-item { background: var(--bg-raised); padding: var(--space-l) var(--space-m); display: flex; flex-direction: column; gap: 0.5rem; }
  .tr-n { font-family: var(--font-display); font-size: var(--step-4); font-weight: 700; color: var(--accent); letter-spacing: -0.02em; line-height: 1; }
  .tr-l { font-size: var(--step-0); color: var(--text-muted); }
  .tr-link { margin-top: var(--space-s); }
  .team-split { display: grid; gap: var(--space-xl); align-items: center; }
  .team-copy { display: grid; gap: var(--space-m); }
  .team-photo-frame { margin: 0; border-radius: var(--radius-m); overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,.35); }
  .team-photo-frame img { display: block; width: 100%; height: auto; }
  @media (min-width: 52rem) {
    .std__row { grid-template-columns: 20rem 1fr; gap: var(--space-l); align-items: baseline; }
    .team-split { grid-template-columns: 1fr 1fr; gap: var(--space-2xl); }
  }
</style>
