---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import SectionIntro from '@components/SectionIntro.astro';
import CTASection from '@components/CTASection.astro';

const metrics = [
  { n: '350', label: 'Market entities mapped' },
  { n: '14', label: 'Direct competitors identified' },
  { n: '9', label: 'Decision benchmarks scored' },
  { n: '8', label: 'Capability domains assessed' },
  { n: '47', label: 'Product capabilities designed' },
  { n: '3', label: 'Capital scenarios modelled' },
];

const phases = [
  {
    num: '01',
    title: 'Research architecture & strategic baseline',
    img: '/assets/v10/approved/two-competitor-decision-brief.webp',
    summary: 'The engagement began by defining the founder decisions, research architecture, evidence standard and decision boundaries before the analysis expanded.',
    bullets: ['6 founder decisions documented', '5-module product audit', 'Evidence grading applied from the first phase', 'Baseline deck + research inventory'],
  },
  {
    num: '02',
    title: 'Market & competitive intelligence',
    img: '/assets/v10/approved/market-intelligence-war-room.webp',
    summary: 'A broad market map was narrowed into a decision-relevant competitor set and capability matrix, then used to identify where competitive white space actually existed.',
    bullets: ['350 entities mapped', '14 direct competitors identified', '9 decision benchmarks', '8 capability domains assessed', '25-slide C-suite competitive deck'],
  },
  {
    num: '03',
    title: 'Product, AI & response architecture',
    img: '/assets/v10/approved/strategic-blueprint.webp',
    summary: 'The competitive evidence was carried forward into product architecture, AI workflow design and a conditional capital roadmap rather than being left as a stand-alone report.',
    bullets: ['Three product surfaces designed', 'AI operating model and supervised workflows', 'Conditional product roadmap', 'Three capital scenarios', 'Investor and executive deliverables'],
  },
];
---
<Base
  title="Work"
  description="An anonymized Evidence Axis engagement showing how competitive intelligence can move from market mapping and evidence analysis into product and strategic decisions."
  path="/work/"
>
  <PageHeader
    eyebrow="Work"
    title="Proof that the research can carry into real decisions."
    lede="An anonymized multi-phase engagement showing the depth behind Evidence Axis: broad market discovery, competitor analysis, evidence grading, product implications and executive-ready outputs."
    meta={['Client anonymized', 'Multi-phase engagement', 'Evidence-graded work']}
  />

  <section class="section" data-surface="dark">
    <div class="container-wide">
      <ul class="work13-metrics" role="list">
        {metrics.map((m) => <li><strong>{m.n}</strong><span>{m.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section container">
    <div class="work13-context">
      <SectionIntro
        eyebrow="Engagement context"
        title="A FinTech / EdTech platform for retail options traders."
        lede="The client needed a competitive view strong enough to inform product design, positioning and an investor-facing roadmap — not a list of competitors copied from search results."
      />
      <div class="work13-context__body">
        <p>The work moved from a broad market scan into a narrower set of direct competitors and decision benchmarks. Competitive evidence was then connected to product architecture, AI workflows and capital priorities.</p>
        <p>This case predates the current Complimentary Brief / Decision Sprint packaging, so it is shown as proof of research depth rather than as a template for today's commercial scope.</p>
      </div>
    </div>
  </section>

  <section class="section work13-dark" data-surface="dark">
    <div class="container">
      <SectionIntro
        eyebrow="Research discipline"
        title="Architecture before analysis — without turning process into the product."
        lede="The engagement defined the decision questions, evidence standard and research boundary before large-scale analysis. The same principle remains in Evidence Axis today: discovery and evidence discipline exist to improve the decision, not to create research theatre."
      />
      <div class="work13-rules axis-frame">
        <div class="axis-tick"><b>DISCOVER</b><p>Map broadly enough to avoid anchoring on the obvious names.</p></div>
        <div class="axis-tick"><b>VERIFY</b><p>Separate what public evidence supports from what a vendor merely claims.</p></div>
        <div class="axis-tick"><b>CLASSIFY</b><p>Keep evidence grade, inference and unresolved gaps visible.</p></div>
        <div class="axis-tick"><b>DECIDE</b><p>Carry the evidence forward into product and strategic choices.</p></div>
      </div>
    </div>
  </section>

  <section class="section container">
    <SectionIntro
      eyebrow="Phase by phase"
      title="What depth looked like in practice."
      lede="The value of the case is not the exact package structure. It is the ability to move from a large evidence field to a decision-ready competitive view."
    />
    <div class="work13-phases">
      {phases.map((p) => (
        <article class="work13-phase">
          <div class="work13-phase__copy">
            <span class="mono">{p.num}</span>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            <ul>{p.bullets.map((b) => <li>{b}</li>)}</ul>
          </div>
          <figure><img src={p.img} alt={`${p.title} — Evidence Axis project visual`} loading="lazy" /></figure>
        </article>
      ))}
    </div>
  </section>

  <section class="section work13-finding">
    <div class="container work13-finding__inner axis-frame">
      <span class="label">EXAMPLE OF A DECISION-RELEVANT FINDING</span>
      <blockquote>“No single competitor leads across education, workflow, lifecycle, and technology.”</blockquote>
      <p>The conclusion came from the capability matrix and decision benchmarks developed in the competitive phase. Its value was what happened next: it influenced product priorities and positioning rather than ending as a line in a report.</p>
    </div>
  </section>

  <section class="section container">
    <div class="work13-sample">
      <div>
        <span class="label">ILLUSTRATIVE INTELLIGENCE SAMPLE</span>
        <h2>Want to inspect the current Evidence Axis brief format?</h2>
        <p>The public sample is a demonstration engagement, not a client case. It shows the source trail, evidence states and decision structure used in a bounded competitive question.</p>
      </div>
      <a class="btn btn--lg" href="/sample-report/">View Sample Intelligence Brief <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <CTASection />
</Base>

<style>
  .work13-metrics{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,1fr)}.work13-metrics li{padding:1.25rem;border-left:1px solid var(--hairline);display:grid;gap:.4rem}.work13-metrics strong{font:750 clamp(1.8rem,3vw,3.4rem)/1 var(--font-display);color:var(--accent)}.work13-metrics span{font:700 .65rem/1.35 var(--font-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted)}
  .work13-context{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,7vw,6rem);align-items:start}.work13-context__body p{font-size:1.05rem;line-height:1.75;color:var(--text-muted);margin:0 0 1rem}.work13-dark{background:#030914}.work13-rules{margin-top:var(--space-xl)}.work13-rules>div{display:grid;grid-template-columns:10rem 1fr;gap:2rem;padding:1rem 0;border-top:1px solid var(--hairline);align-items:baseline}.work13-rules b{font-family:var(--font-mono);color:var(--accent);font-size:.74rem}.work13-rules p{margin:0;color:var(--text-muted)}
  .work13-phases{display:grid;gap:1.2rem;margin-top:var(--space-xl)}.work13-phase{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1.5rem,5vw,4rem);padding:1.5rem;border:1px solid var(--surface-border);border-radius:1rem;background:var(--bg-raised);align-items:center}.work13-phase__copy>span{color:var(--accent);font-size:.7rem}.work13-phase h3{font-size:clamp(1.7rem,3vw,2.7rem);margin:.55rem 0 .75rem}.work13-phase p,.work13-phase li{color:var(--text-muted);line-height:1.6}.work13-phase figure{margin:0;overflow:hidden;border-radius:.8rem;border:1px solid var(--surface-border)}.work13-phase img{display:block;width:100%;height:auto}.work13-finding{background:var(--bg-raised)}.work13-finding__inner{max-width:58rem}.work13-finding blockquote{margin:1rem 0;font:700 clamp(2rem,4vw,3.5rem)/1.08 var(--font-display);letter-spacing:-.035em}.work13-finding p{max-width:54rem;color:var(--text-muted);line-height:1.7}.work13-sample{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:end}.work13-sample h2{font-size:clamp(2rem,4vw,3.4rem);margin:.6rem 0}.work13-sample p{max-width:50rem;color:var(--text-muted)}
  @media(max-width:900px){.work13-metrics{grid-template-columns:repeat(3,1fr)}.work13-context,.work13-phase,.work13-sample{grid-template-columns:1fr}}@media(max-width:560px){.work13-metrics{grid-template-columns:repeat(2,1fr)}.work13-rules>div{grid-template-columns:1fr;gap:.45rem}}
</style>
