---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import CTASection from '@components/CTASection.astro';

const metrics = [
  { n: '350', label: 'Market entities mapped' },
  { n: '14', label: 'Direct competitors identified' },
  { n: '9', label: 'Decision benchmarks scored' },
  { n: '8', label: 'Capability domains assessed' },
  { n: '47', label: 'Product capabilities designed' },
  { n: '3', label: 'Capital scenarios modelled' },
];

const phases = [
  { num:'01', title:'Research architecture & strategic baseline', img:'/assets/v10/approved/two-competitor-decision-brief.webp', summary:'The engagement began by defining the founder decisions, research architecture, evidence standard and decision boundaries before the analysis expanded.', bullets:['6 founder decisions documented','5-module product audit','Evidence grading from the first phase','Baseline deck + research inventory'] },
  { num:'02', title:'Market & competitive intelligence', img:'/assets/v10/approved/market-intelligence-war-room.webp', summary:'A broad market map was narrowed into a decision-relevant competitor set and capability matrix, then used to identify where competitive white space actually existed.', bullets:['350 entities mapped','14 direct competitors identified','9 decision benchmarks','8 capability domains assessed','25-slide C-suite competitive deck'] },
  { num:'03', title:'Product, AI & response architecture', img:'/assets/v10/approved/strategic-blueprint.webp', summary:'The competitive evidence was carried forward into product architecture, AI workflow design and a conditional capital roadmap rather than being left as a stand-alone report.', bullets:['Three product surfaces designed','AI operating model and supervised workflows','Conditional product roadmap','Three capital scenarios','Investor and executive deliverables'] },
];
---
<Base title="Work" description="Selected Evidence Axis work showing how competitive intelligence can move from market discovery and evidence analysis into strategy, content, product and executive decisions." path="/work/">
  <PageHeader
    eyebrow="Work"
    title="Proof that the research can carry into real decisions."
    lede="Selected work showing two different kinds of depth: an active options-education client engagement and an anonymized multi-phase market, product and competitive intelligence project."
    meta={['Real client work', 'Evidence-graded research', 'Executive-ready outputs']}
  />

  <main class="work-final">
    <section class="section work-final__sqilled" data-surface="dark">
      <div class="container-wide work-final__sq-grid">
        <div class="work-final__sq-copy">
          <span class="label">SELECTED CLIENT WORK</span>
          <div class="work-final__sq-title"><h2>SQILLED</h2><span class="mono">OPTIONS EDUCATION PLATFORM</span></div>
          <p>Evidence Axis supported SQILLED across a multi-phase research and strategy engagement, then carried the work forward into content architecture and educational media production.</p>
          <div class="work-final__sq-pillars">
            <article><b>Competitive research</b><span>Market and competitor analysis structured for strategic decisions.</span></article>
            <article><b>Strategy architecture</b><span>Executive-ready research and recommendations, not isolated content tasks.</span></article>
            <article><b>Content system</b><span>Organic social and educational content designed around the platform’s audience and offer.</span></article>
            <article><b>Media prototypes</b><span>Production-ready educational video concepts and branded lesson formats.</span></article>
          </div>
          <p class="work-final__note">The public case summary is intentionally bounded. It demonstrates the type of work delivered without publishing private client material.</p>
        </div>
        <figure class="work-final__sq-media" data-lightbox data-lightbox-caption="SQILLED engagement visual — options education, market research and strategy architecture.">
          <img src="/assets/v10/approved/global-trading-command-center.webp" alt="SQILLED options education and competitive research project visual" loading="eager" />
          <figcaption class="mono">CLICK TO EXPAND · SQILLED</figcaption>
        </figure>
      </div>
    </section>

    <section class="work-final__metrics" aria-label="Anonymized engagement metrics">
      <div class="container-wide"><ul>{metrics.map((m)=><li><strong>{m.n}</strong><span>{m.label}</span></li>)}</ul></div>
    </section>

    <section class="section work-final__case-intro">
      <div class="container work-final__case-grid">
        <div><span class="label">ANONYMIZED DEEP-DIVE CASE</span><h2>A FinTech / EdTech platform for retail options traders.</h2></div>
        <div><p>The client needed a competitive view strong enough to inform product design, positioning and an investor-facing roadmap — not a list of competitors copied from search results.</p><p>The work moved from broad market mapping into direct-competitor validation, decision benchmarks, product implications, AI workflows and capital priorities.</p></div>
      </div>
    </section>

    <section class="section work-final__discipline" data-surface="dark">
      <div class="container-wide work-final__discipline-grid">
        <div><span class="label">RESEARCH DISCIPLINE</span><h2>Architecture before analysis — without turning process into the product.</h2></div>
        <div class="work-final__steps"><div><b>DISCOVER</b><p>Map broadly enough to avoid anchoring on the obvious names.</p></div><div><b>VERIFY</b><p>Separate public evidence from vendor assertion.</p></div><div><b>CLASSIFY</b><p>Keep fact, inference and unresolved gaps visible.</p></div><div><b>DECIDE</b><p>Carry the evidence forward into product and strategic choices.</p></div></div>
      </div>
    </section>

    <section class="section work-final__phases">
      <div class="container-wide">
        <header class="work-final__phase-head"><span class="label">PHASE BY PHASE</span><h2>What depth looked like in practice.</h2><p>The value is not the exact package structure. It is the ability to move from a large evidence field to a decision-ready competitive view.</p></header>
        <div class="work-final__phase-list">
          {phases.map((p)=><article class="work-final__phase">
            <div class="work-final__phase-copy"><span class="mono">{p.num}</span><h3>{p.title}</h3><p>{p.summary}</p><ul>{p.bullets.map((b)=><li>{b}</li>)}</ul></div>
            <figure data-lightbox data-lightbox-caption={`${p.title} — Evidence Axis project visual`}><img src={p.img} alt={`${p.title} — Evidence Axis project visual`} loading="lazy" /><figcaption class="mono">CLICK TO EXPAND</figcaption></figure>
          </article>)}
        </div>
      </div>
    </section>

    <section class="section work-final__finding">
      <div class="container work-final__finding-inner">
        <span class="label">EXAMPLE OF A DECISION-RELEVANT FINDING</span>
        <blockquote>“No single competitor leads across education, workflow, lifecycle, and technology.”</blockquote>
        <p>The conclusion came from the capability matrix and decision benchmarks developed in the competitive phase. Its value was what happened next: it influenced product priorities and positioning rather than ending as a line in a report.</p>
      </div>
    </section>

    <section class="section work-final__sample">
      <div class="container work-final__sample-grid">
        <div><span class="label">PUBLIC INTELLIGENCE SAMPLE</span><h2>Inspect the current Evidence Axis brief format.</h2><p>The public Intercom vs Zendesk demonstration shows the source trail, evidence states and decision structure used in a bounded competitive question.</p></div>
        <a class="btn btn--lg" href="/sample-report/">View Sample Intelligence Brief <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <CTASection />
  </main>
</Base>

<style>
  .work-final{background:#f8f5ef}.work-final__sqilled{background:#030914;color:#f4f8ff}.work-final__sq-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:clamp(2rem,6vw,5rem);align-items:center}.work-final__sq-title{display:flex;align-items:baseline;gap:1rem;flex-wrap:wrap;margin:.5rem 0 .7rem}.work-final__sq-title h2{margin:0;font-size:clamp(3.2rem,6vw,6rem);letter-spacing:-.055em;line-height:.9}.work-final__sq-title span{color:#64e2da;font-size:.62rem;letter-spacing:.12em}.work-final__sq-copy>p{color:#aebfd3;line-height:1.65;font-size:1.02rem}.work-final__sq-pillars{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-top:1.2rem}.work-final__sq-pillars article{padding:.9rem;border:1px solid rgba(116,160,215,.15);border-radius:.72rem;background:rgba(255,255,255,.025)}.work-final__sq-pillars b{display:block;margin-bottom:.3rem}.work-final__sq-pillars span{display:block;color:#91a7c1;font-size:.82rem;line-height:1.5}.work-final__note{font-size:.8rem!important;color:#7088a6!important;margin-top:1rem}.work-final__sq-media{margin:0;padding:.7rem;border-radius:1rem;background:#08111f;border:1px solid rgba(98,141,194,.18);box-shadow:0 32px 78px rgba(0,0,0,.34)}.work-final__sq-media img{display:block;width:100%;height:auto;border-radius:.68rem}.work-final__sq-media figcaption,.work-final__phase figcaption{text-align:center;margin-top:.55rem;color:#8297b3;font-size:.52rem;letter-spacing:.1em}
  .work-final__metrics{background:#07111f;color:#f4f8ff;border-top:1px solid rgba(122,163,215,.13);border-bottom:1px solid rgba(122,163,215,.13)}.work-final__metrics ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,1fr)}.work-final__metrics li{padding:1rem;border-left:1px solid rgba(120,161,215,.13);display:grid;gap:.3rem}.work-final__metrics strong{font:800 clamp(1.7rem,2.7vw,2.9rem)/1 var(--font-display);color:#64e2da}.work-final__metrics span{font:700 .55rem/1.35 var(--font-mono);letter-spacing:.06em;text-transform:uppercase;color:#8fa5bf}
  .work-final__case-intro{background:#fff}.work-final__case-grid,.work-final__discipline-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(2rem,6vw,5rem);align-items:start}.work-final__case-grid h2,.work-final__discipline h2,.work-final__phase-head h2,.work-final__sample h2{margin:.55rem 0 .8rem;font-size:clamp(2.4rem,4.5vw,4.5rem);line-height:.98;letter-spacing:-.048em}.work-final__case-grid p,.work-final__phase-head p,.work-final__sample p{color:var(--text-muted);line-height:1.68}.work-final__discipline{background:#030914;color:#f4f8ff}.work-final__discipline h2{margin-top:.6rem}.work-final__steps{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}.work-final__steps div{padding:.9rem;border:1px solid rgba(122,163,215,.15);border-radius:.7rem;background:rgba(255,255,255,.025)}.work-final__steps b{font:800 .62rem/1 var(--font-mono);letter-spacing:.1em;color:#64e2da}.work-final__steps p{margin:.35rem 0 0;color:#92a8c1;font-size:.84rem;line-height:1.5}
  .work-final__phases{background:#f4efe7}.work-final__phase-head{max-width:66rem}.work-final__phase-head p{max-width:52rem}.work-final__phase-list{display:grid;gap:.85rem;margin-top:1.7rem}.work-final__phase{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1.4rem,4vw,3.5rem);padding:1.15rem;border:1px solid rgba(31,58,87,.12);border-radius:1rem;background:#fff;align-items:center}.work-final__phase-copy>span{font-size:.58rem;color:#287d92;letter-spacing:.1em}.work-final__phase h3{margin:.55rem 0 .5rem;font-size:clamp(1.55rem,2.7vw,2.45rem);line-height:1}.work-final__phase p,.work-final__phase li{color:var(--text-muted);line-height:1.55}.work-final__phase ul{display:grid;gap:.28rem;padding-left:1rem}.work-final__phase figure{margin:0;padding:.55rem;border-radius:.8rem;background:#08111f;border:1px solid rgba(61,91,128,.15);overflow:hidden}.work-final__phase img{display:block;width:100%;height:auto;border-radius:.5rem}
  .work-final__finding{background:#fff}.work-final__finding-inner{max-width:62rem}.work-final__finding blockquote{margin:.9rem 0;font:750 clamp(2.25rem,4vw,3.8rem)/1.04 var(--font-display);letter-spacing:-.04em}.work-final__finding p{color:var(--text-muted);line-height:1.68}.work-final__sample{background:#f4efe7}.work-final__sample-grid{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:end}
  @media(max-width:900px){.work-final__sq-grid,.work-final__case-grid,.work-final__discipline-grid,.work-final__phase,.work-final__sample-grid{grid-template-columns:1fr}.work-final__metrics ul{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:580px){.work-final__sq-pillars,.work-final__steps{grid-template-columns:1fr}.work-final__metrics ul{grid-template-columns:repeat(2,1fr)}}
</style>
