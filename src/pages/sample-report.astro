---
import Base from '@layouts/Base.astro';
import SectionIntro from '@components/SectionIntro.astro';
import EvidenceRecord from '@components/EvidenceRecord.astro';
import ComparisonMatrix from '@components/ComparisonMatrix.astro';
import CTASection from '@components/CTASection.astro';
import { site, cta } from '@config/site';
import {
  sampleMeta, sampleSources, sampleRecords, sampleMatrix, sampleProfiles,
  sampleSummary, sampleDecisionImplications, sampleLimitations, sampleMethodology,
} from '@data/sample-report';

/**
 * Sample Report — real, first-party-sourced DEMONSTRATION case:
 * Intercom vs Zendesk, checked 9 August 2026. Not a client engagement.
 * Content derives entirely from src/data/sample-report.ts. Print-optimized;
 * a dedicated PDF lives at /report/evidence-axis-sample-intercom-vs-zendesk.pdf.
 */
const pdfHref = '/report/evidence-axis-sample-intercom-vs-zendesk.pdf';
const srcById = Object.fromEntries(sampleSources.map((s) => [s.id, s]));
const domain = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const recordSource = (ids: string[]) =>
  ids.map((id) => domain(srcById[id].url)).join(' · ') + ' (public)';

const matrixRows = sampleMatrix.map((r) => ({
  dimension: r.dimension,
  cells: [
    { state: r.intercom.state, note: r.intercom.note },
    { state: r.zendesk.state, note: r.zendesk.note },
  ],
}));

const sections = [
  'Research question', 'Research boundary', 'Competitor set', 'Executive decision summary',
  'Evidence matrix', 'Evidence profiles', 'Source-backed observations', 'Decision implications',
  'Limitations', 'Methodology', 'Source register',
];
---
<Base
  title="Sample Intelligence Brief"
  description="Inspect a source-backed Evidence Axis competitive intelligence sample comparing Intercom and Zendesk — with Fact, Inference, Unknown, decision implications and a complete source register."
  path="/sample-report/"
>
  <section class="sr-intro" data-surface="dark">
    <div class="sr-intro__grid" aria-hidden="true"></div>
    <div class="sr-intro__glow" aria-hidden="true"></div>
    <div class="container-wide sr-intro__inner">
      <div class="sr-head axis-frame">
        <span class="sr-badge mono">ILLUSTRATIVE INTELLIGENCE SAMPLE</span>
        <h1 class="sr-title">Intercom vs Zendesk,<br/><em>read as evidence.</em></h1>
        <p class="sr-lede">
          Inspect how Evidence Axis turns a bounded competitor question into a traceable intelligence package —
          with checked first-party sources, evidence states, decision implications and a complete source register.
        </p>
        <div class="sr-actions">
          <a href={pdfHref} class="btn btn--lg" download>
            Download the report (PDF)<span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
          <a href="#brief" class="btn btn--ghost btn--lg">Read it here</a>
          <a href={cta.primary.href} class="sr-request">Discuss a competitive decision →</a>
        </div>
        <p class="sr-meta mono">
          {sampleMeta.competitors.join(' vs ')} · first-party public evidence · checked {sampleMeta.checked}
        </p>
      </div>

      <aside class="sr-proof" aria-label="What this sample contains">
        <div class="sr-proof__axis" aria-hidden="true"></div>
        <span class="sr-proof__eyebrow mono">EVIDENCE PACKAGE</span>
        <div class="sr-proof__states">
          <div><span class="state-dot state-dot--fact"></span><b>FACT</b><small>checked source</small></div>
          <div><span class="state-dot state-dot--infer"></span><b>INFERENCE</b><small>reasoning shown</small></div>
          <div><span class="state-dot state-dot--unknown"></span><b>UNKNOWN</b><small>certainty stops here</small></div>
        </div>
        <div class="sr-proof__metrics">
          <div><strong>{sampleSources.length}</strong><span>checked sources</span></div>
          <div><strong>{sampleRecords.length}</strong><span>evidence records</span></div>
          <div><strong>{sampleMatrix.length}</strong><span>decision dimensions</span></div>
        </div>
        <div class="sr-proof__flow mono">
          <span>SOURCE</span><i>→</i><span>OBSERVATION</span><i>→</i><span>DECISION</span>
        </div>
        <p>Demonstration sample — not a client engagement. No universal winner is declared.</p>
      </aside>
    </div>
  </section>

  <section class="section container">
    <div class="sr-about">
      <div>
        <SectionIntro eyebrow="What this demonstrates" title="Method, not marketing." as="h2" />
        <p class="measure sr-p">
          A real brief answers one decision question with public evidence. It separates verified fact
          from reasoned inference, names what cannot be known, and lists every source with the date it
          was checked. This sample shows that shape end to end — with the vendors named and their own
          pages cited.
        </p>
      </div>
      <div class="sr-sections-panel">
        <h3 class="label sr-sec-h">Inside the brief</h3>
        <ol class="sr-sections">
          {sections.map((s) => <li class="mono">{s}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <article class="section brief" id="brief" aria-label="Demonstration decision brief: Intercom vs Zendesk">
    <div class="container brief__inner">
      <header class="brief__cover">
        <div class="brief__cover-top">
          <span class="mono">{site.name} · Decision Brief</span>
          <span class="sr-badge sr-badge--sm mono">Demonstration sample</span>
        </div>
        <h2 class="brief__q-label label">Research question</h2>
        <p class="brief__q">{sampleMeta.question}</p>
        <dl class="brief__meta">
          <div><dt class="label">Boundary</dt><dd>{sampleMeta.boundary}</dd></div>
          <div><dt class="label">Competitor set</dt><dd>{sampleMeta.competitors.join(' and ')} (named).</dd></div>
          <div><dt class="label">Checked</dt><dd class="mono">{sampleMeta.checked}</dd></div>
        </dl>
        <p class="brief__illus-note mono">
          This is a demonstration sample, not a client engagement. Every claim below is drawn from the
          first-party sources in the register and classified Fact, Inference or Unknown. Public pages
          change; figures are annual-billing list prices at the check date.
        </p>
      </header>

      <hr class="rule brief__rule" />

      <section class="brief__block">
        <h2 class="brief__h">Executive decision summary</h2>
        <p class="brief__body">{sampleSummary}</p>
      </section>

      <section class="brief__block">
        <h2 class="brief__h">Evidence matrix</h2>
        <ComparisonMatrix competitors={[...sampleMeta.competitors]} rows={matrixRows}
          caption={`Intercom vs Zendesk · first-party public sources · checked ${sampleMeta.checked}`} />
      </section>

      <section class="brief__block">
        <h2 class="brief__h">Evidence profiles</h2>
        <div class="brief__profiles">
          <div class="brief__profile">
            <h3 class="brief__profile-name">Intercom</h3>
            <p>{sampleProfiles.intercom}</p>
          </div>
          <div class="brief__profile">
            <h3 class="brief__profile-name">Zendesk</h3>
            <p>{sampleProfiles.zendesk}</p>
          </div>
        </div>
      </section>

      <section class="brief__block">
        <h2 class="brief__h">Source-backed observations</h2>
        <div class="brief__records">
          {sampleRecords.map((r) => (
            <EvidenceRecord
              id={r.id}
              status={r.status}
              claim={r.claim}
              observation={r.observation}
              source={recordSource(r.sources)}
              dateChecked={sampleMeta.checked}
              limitation={r.limitation}
              implication={r.implication}
            />
          ))}
        </div>
      </section>

      <section class="brief__block">
        <h2 class="brief__h">Decision implications</h2>
        <ul class="brief__impl">
          {sampleDecisionImplications.map((d) => <li>{d}</li>)}
        </ul>
      </section>

      <section class="brief__block">
        <h2 class="brief__h">Limitations</h2>
        <p class="brief__body">{sampleLimitations}</p>
      </section>

      <section class="brief__block">
        <h2 class="brief__h">Methodology</h2>
        <p class="brief__body">{sampleMethodology}</p>
      </section>

      <section class="brief__block">
        <h2 class="brief__h">Source register</h2>
        <ol class="brief__sources">
          {sampleSources.map((s) => (
            <li class="brief__source">
              <div class="brief__source-top">
                <span class="brief__source-id mono">{s.id}</span>
                <span class="brief__source-org">{s.org} — {s.title}</span>
                <span class="brief__source-party mono">{s.party}</span>
              </div>
              <a class="brief__source-url mono" href={s.url} target="_blank" rel="noopener">{domain(s.url)}</a>
              <p class="brief__source-supports">{s.supports}{s.limitation && <span class="brief__source-limit"> · Limitation: {s.limitation}</span>}</p>
              <span class="brief__source-checked mono">checked {sampleMeta.checked}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </article>

  <CTASection
    eyebrow="Start with the decision"
    title="Bring your competitive question into focus."
    body="Evidence Axis combines verified competitive evidence with your company context to support a real strategic, product, pricing, positioning or sales decision."
  />
</Base>

<style>
  .sr-intro{position:relative;overflow:hidden;background:#020713;color:#f5f8ff;padding:clamp(5rem,9vw,8rem) 0;border-bottom:1px solid rgba(115,159,218,.18)}
  .sr-intro__grid{position:absolute;inset:0;opacity:.2;background-image:linear-gradient(rgba(100,151,226,.1) 1px,transparent 1px),linear-gradient(90deg,rgba(100,151,226,.1) 1px,transparent 1px);background-size:68px 68px;mask-image:linear-gradient(90deg,#000 0,#000 74%,transparent)}
  .sr-intro__glow{position:absolute;inset:-25% -12% -20% 38%;background:radial-gradient(circle at 54% 45%,rgba(68,139,255,.28),transparent 26%),radial-gradient(circle at 62% 58%,rgba(61,224,213,.14),transparent 36%);filter:blur(12px)}
  .sr-intro__inner{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.08fr) minmax(22rem,.72fr);gap:clamp(2rem,6vw,6rem);align-items:center}
  .sr-head{max-width:60rem}.sr-badge{display:inline-block;font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:#65e2d9;border:1px solid rgba(101,226,217,.42);padding:.42em .76em;border-radius:999px;background:rgba(41,182,178,.06)}.sr-badge--sm{font-size:.6rem;color:var(--infer);border-style:dashed;border-color:var(--infer);background:transparent}
  .sr-title{font-size:clamp(3.5rem,6.6vw,7rem);line-height:.92;letter-spacing:-.065em;margin:1rem 0 0;max-width:12ch}.sr-title em{font-style:normal;background:linear-gradient(100deg,#a8c5ff 0%,#76a7ff 48%,#5ce4db 100%);-webkit-background-clip:text;background-clip:text;color:transparent}.sr-lede{margin-top:1.35rem;font-size:1.12rem;line-height:1.75;color:#cad7e8;max-width:55ch}.sr-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem;margin-top:1.7rem}.sr-request{font-family:var(--font-display);font-weight:750;color:#8fc5ff;text-decoration:none;padding:.7rem .25rem}.sr-request:hover{color:#64e2d9}.sr-meta{margin-top:1.35rem;font-size:.65rem;color:#8095b2;letter-spacing:.08em}
  .sr-proof{position:relative;min-height:29rem;padding:1.55rem;border-radius:1.35rem;border:1px solid rgba(112,162,231,.28);background:linear-gradient(155deg,rgba(10,27,50,.94),rgba(4,13,28,.96));box-shadow:0 42px 100px rgba(0,0,0,.38),0 0 60px rgba(46,127,229,.08) inset;overflow:hidden}.sr-proof::before{content:'';position:absolute;inset:0 0 auto;height:3px;background:linear-gradient(90deg,#62e2da,#709eff,#a37aff)}.sr-proof__axis{position:absolute;right:17%;top:2.5rem;bottom:2.5rem;width:1px;background:linear-gradient(transparent,rgba(91,224,214,.55),rgba(112,158,255,.5),transparent);box-shadow:0 0 18px rgba(85,225,215,.24)}.sr-proof__eyebrow{font-size:.6rem;letter-spacing:.14em;color:#7894ba}.sr-proof__states{display:grid;gap:.7rem;margin-top:1.35rem}.sr-proof__states>div{position:relative;z-index:1;display:grid;grid-template-columns:auto auto 1fr;gap:.65rem;align-items:center;padding:.85rem .95rem;border:1px solid rgba(125,164,216,.14);border-radius:.75rem;background:rgba(255,255,255,.025)}.sr-proof__states b{font:850 .72rem/1 var(--font-mono);letter-spacing:.08em}.sr-proof__states small{justify-self:end;color:#8196b2;font-size:.69rem}.state-dot{width:.65rem;height:.65rem;border-radius:50%;box-shadow:0 0 16px currentColor}.state-dot--fact{background:#57dfd7;color:#57dfd7}.state-dot--infer{background:#f0aa49;color:#f0aa49}.state-dot--unknown{background:#aa82ff;color:#aa82ff}.sr-proof__metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem;margin-top:1rem}.sr-proof__metrics div{padding:.9rem .7rem;border-radius:.75rem;background:rgba(255,255,255,.035);border:1px solid rgba(124,164,220,.12)}.sr-proof__metrics strong{display:block;font:800 1.7rem/1 var(--font-display);color:#fff}.sr-proof__metrics span{display:block;margin-top:.3rem;font-size:.62rem;color:#8298b5}.sr-proof__flow{display:flex;align-items:center;justify-content:space-between;gap:.45rem;margin-top:1rem;padding:.8rem;border:1px solid rgba(92,222,214,.18);border-radius:.75rem;color:#a9bdd7;font-size:.55rem;letter-spacing:.08em}.sr-proof__flow i{color:#59dfd7;font-style:normal}.sr-proof>p{margin:1rem 0 0;color:#7f94ae;font-size:.72rem;line-height:1.55}

  .sr-about{display:grid;gap:var(--space-xl)}.sr-p{margin-top:var(--space-s);color:var(--text-muted)}.sr-sections-panel{padding:1.4rem;border:1px solid var(--surface-border);border-radius:1rem;background:var(--bg-raised);box-shadow:0 22px 60px rgba(25,34,48,.07)}.sr-sec-h{display:block;margin-bottom:var(--space-s)}.sr-sections{margin:0;padding-left:1.4em;columns:2;column-gap:var(--space-l)}.sr-sections li{font-size:var(--step--1);color:var(--text-muted);margin-bottom:.5em}

  .brief{background:linear-gradient(180deg,var(--bg-sunken),color-mix(in srgb,var(--bg-sunken) 88%,#dbe5f1));scroll-margin-top:5rem}.brief__inner{background:var(--paper-0);color:var(--ink-900);border:1px solid var(--paper-200);border-radius:1.15rem;box-shadow:0 35px 100px rgba(21,31,46,.14);padding:clamp(1.5rem,4vw,4rem);max-width:62rem}.brief__cover-top{display:flex;justify-content:space-between;align-items:center;gap:var(--space-s);flex-wrap:wrap;color:var(--ink-500)}.brief__q-label{margin-top:var(--space-l);color:var(--ink-500)}.brief__q{font-family:var(--font-serif);font-size:var(--step-2);line-height:var(--leading-snug);color:var(--ink-900);margin-top:.3em;text-wrap:pretty}.brief__meta{display:grid;gap:var(--space-s);margin-top:var(--space-l)}.brief__meta dt{color:var(--ink-500)}.brief__meta dd{color:var(--ink-800);font-size:.98rem;margin-top:.1em;max-width:70ch}.brief__illus-note{margin-top:var(--space-l);font-size:var(--step--1);color:var(--ink-500);background:var(--paper-50);border-left:3px dashed var(--infer);padding:var(--space-s) var(--space-m);border-radius:var(--radius-xs)}.brief__rule{border-top-color:var(--paper-200);margin-block:var(--space-l)}.brief__block{margin-top:var(--space-xl)}.brief__block:first-of-type{margin-top:0}.brief__h{font-size:var(--step-1);color:var(--ink-900);padding-bottom:var(--space-2xs);border-bottom:2px solid var(--ink-900);display:inline-block;margin-bottom:var(--space-m)}.brief__body{color:var(--ink-700);max-width:68ch;line-height:var(--leading-body)}.brief__profiles{display:grid;gap:var(--space-m)}.brief__profile{background:var(--paper-50);border:1px solid var(--paper-200);border-radius:var(--radius-s);padding:var(--space-m)}.brief__profile-name{font-size:var(--step-1);color:var(--ink-900);margin-bottom:var(--space-2xs)}.brief__profile p{color:var(--ink-700);font-size:.95rem;line-height:var(--leading-body)}.brief__records{display:grid;gap:var(--space-m)}.brief__impl{margin:0;padding-left:1.3em;display:grid;gap:.6rem}.brief__impl li{color:var(--ink-700)}
  .brief__sources{list-style:none;margin:0;padding:0;display:grid;gap:var(--space-m);counter-reset:none}.brief__source{padding:var(--space-s) 0;border-top:1px solid var(--paper-200)}.brief__source-top{display:flex;align-items:baseline;gap:.8ch;flex-wrap:wrap}.brief__source-id{color:var(--ink-400);font-size:var(--step--1)}.brief__source-org{font-family:var(--font-display);font-weight:500;color:var(--ink-900)}.brief__source-party{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--fact);border:1px solid color-mix(in srgb,var(--fact) 40%,transparent);padding:.1em .45em;border-radius:var(--radius-xs)}.brief__source-url{display:inline-block;margin-top:.2em;color:var(--signal-600);font-size:.85rem;word-break:break-all}.brief__source-supports{color:var(--ink-700);font-size:.9rem;margin-top:.2em}.brief__source-limit{color:var(--ink-500)}.brief__source-checked{display:block;margin-top:.2em;color:var(--ink-400);font-size:var(--step--1)}
  .brief__inner :global(.record){background:var(--paper-50);border-color:var(--paper-200)}.brief__inner :global(.matrix__scroll){border-color:var(--paper-200)}.brief__inner :global(.matrix__table){background:var(--paper-0)}.brief__inner :global(.matrix__dim-head),.brief__inner :global(.matrix__comp-head){background:var(--paper-100)}

  @media(min-width:52rem){.sr-about{grid-template-columns:1.25fr .75fr}.brief__profiles{grid-template-columns:1fr 1fr}}
  @media(max-width:900px){.sr-intro__inner{grid-template-columns:1fr}.sr-proof{min-height:auto}.sr-title{font-size:clamp(3.35rem,11vw,5.8rem)}.sr-proof__axis{display:none}}
  @media(max-width:560px){.sr-proof__metrics{grid-template-columns:1fr}.sr-sections{columns:1}.sr-actions{align-items:stretch}.sr-actions .btn{width:100%;justify-content:center}.sr-request{width:100%}}

  @media print{
    :global(.site-header),:global(.site-footer),:global(.skip-link),.sr-intro,:global(.cta-band){display:none!important}.brief{background:#fff;padding:0}.brief__inner{box-shadow:none;border:none;background:#fff;padding:0;max-width:100%}.brief__block{break-inside:avoid}
  }
</style>