---
import Logo from './Logo.astro';
import { primaryNav } from '@data/nav';
import { cta } from '@config/site';

const current = Astro.url.pathname;
const isHome = current === '/';
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---
<header
  class:list={['site-header', { 'site-header--home': isHome }]}
  data-header
  data-surface={isHome ? 'dark' : undefined}
>
  <div class="container-wide site-header__inner">
    <Logo />

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {primaryNav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['primary-nav__link', { 'is-active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__cta">
      <a href={cta.primary.href} class="header-cta">
        {cta.primary.label}<span aria-hidden="true">↗</span>
      </a>
    </div>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
  <nav aria-label="Mobile" class="container">
    <ul>
      {primaryNav.map((item) => (
        <li>
          <a href={item.href} class="mobile-nav__link">
            <span class="mobile-nav__label">{item.label}</span>
            <span class="mobile-nav__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
      <li class="mobile-nav__cta">
        <a href={cta.primary.href} class="btn btn--lg">
          {cta.primary.label}<span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-2) var(--ease-out), background var(--dur-2) var(--ease-out);
  }
  .site-header[data-scrolled] { border-bottom-color: var(--hairline); }

  .site-header--home {
    background: rgba(7, 17, 31, .78);
    border-bottom-color: rgba(118, 151, 211, .09);
    box-shadow: 0 10px 35px rgba(0,0,0,.08);
  }
  .site-header--home[data-scrolled] {
    background: rgba(7, 17, 31, .92);
    border-bottom-color: rgba(118, 151, 211, .16);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    height: 4.5rem;
  }
  .primary-nav { margin-left: auto; display: none; }
  .primary-nav ul {
    display: flex;
    gap: clamp(.45rem, 1.45vw, 1.25rem);
    list-style: none;
    padding: 0;
  }
  .primary-nav__link {
    font-family: var(--font-display);
    font-size: .9rem;
    font-weight: 500;
    letter-spacing: -.01em;
    color: var(--text-muted);
    text-decoration: none;
    padding: .55em .2em;
    position: relative;
    transition: color var(--dur-1) var(--ease-out);
  }
  .primary-nav__link::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -.15em;
    height: 1px;
    background: linear-gradient(90deg, #769bff, #59e4cb);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .primary-nav__link:hover,
  .primary-nav__link.is-active { color: var(--text); }
  .primary-nav__link:hover::after,
  .primary-nav__link.is-active::after { transform: scaleX(1); }

  .site-header__cta { display: none; }
  .header-cta {
    display:inline-flex; align-items:center; gap:.55rem;
    min-height:2.55rem; padding:.62rem .92rem;
    border-radius:.5rem;
    text-decoration:none;
    font-family:var(--font-display); font-size:.88rem; font-weight:600;
    color:var(--text);
    border:1px solid var(--surface-border);
    background:color-mix(in srgb, var(--bg-raised) 82%, transparent);
    transition:transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }
  .header-cta:hover { transform:translateY(-1px); border-color:var(--accent); }
  .site-header--home .header-cta {
    color:#08111e;
    border-color:transparent;
    background:linear-gradient(105deg,#9ebcff,#6f99ff 58%,#56dfc8 145%);
    box-shadow:0 10px 28px rgba(58,104,216,.18);
  }

  .nav-toggle {
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-s);
    width: 2.6rem; height: 2.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text);
  }
  .site-header--home .nav-toggle { border-color:rgba(145,174,224,.2); }
  .nav-toggle__bars { display:grid; gap:5px; width:18px; }
  .nav-toggle__bars i {
    display:block; height:1.6px; background:currentColor; border-radius:2px;
    transition:transform var(--dur-2) var(--ease-out), opacity var(--dur-1);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars i:first-child { transform:translateY(3.3px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars i:last-child { transform:translateY(-3.3px) rotate(-45deg); }

  .mobile-nav {
    position: fixed;
    inset: 4.5rem 0 0 0;
    z-index: calc(var(--z-header) - 1);
    background: var(--bg);
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-l);
    overflow-y: auto;
    animation: mobileIn var(--dur-2) var(--ease-out);
  }
  .site-header--home + .mobile-nav { background:#081321; color:#eef3fb; }
  .mobile-nav[hidden] { display:none; }
  @keyframes mobileIn { from { opacity:0; transform:translateY(-8px); } to { opacity:1; transform:none; } }
  .mobile-nav ul { list-style:none; padding:0; display:grid; }
  .mobile-nav__link {
    display:flex; align-items:center; justify-content:space-between;
    padding:1rem 0; border-bottom:1px solid var(--hairline);
    text-decoration:none; color:var(--text);
    font-family:var(--font-display); font-size:var(--step-1); font-weight:500;
  }
  .mobile-nav__arrow { color:var(--accent); }
  .mobile-nav__cta { margin-top:var(--space-l); }

  @media (min-width:64rem) {
    .primary-nav { display:block; }
    .site-header__cta { display:block; }
    .nav-toggle { display:none; }
    .mobile-nav { display:none !important; }
  }
</style>
