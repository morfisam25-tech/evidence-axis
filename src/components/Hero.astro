---
import { offers, cta } from '@config/site';
---
<section class="hero-v3" data-hero data-surface="dark" aria-labelledby="hero-title">
  <div class="hero-v3__ambient" aria-hidden="true"></div>
  <canvas class="hero-v3__canvas" data-hero-canvas aria-hidden="true"></canvas>

  <div class="container-wide hero-v3__inner">
    <div class="hero-v3__copy">
      <span class="hero-v3__eyebrow mono">
        <i aria-hidden="true"></i>
        Competitor intelligence for B2B SaaS
      </span>

      <h1 id="hero-title" class="hero-v3__title">
        Know what competitors can prove.
        <span>See what they can’t.</span>
      </h1>

      <p class="hero-v3__lede">
        Evidence Axis turns scattered public competitor information into decision-ready evidence.
        Every material claim is sourced, dated, and classified as Fact, Inference, or Unknown.
      </p>

      <ul class="hero-v3__proof" aria-label="Pilot details">
        <li><span class="proof-icon">✓</span>Public / Checked / Dated</li>
        <li><span class="proof-icon">$</span>{offers.twoCompetitor.priceDisplay} Pilot</li>
        <li><span class="proof-icon">◷</span>{offers.twoCompetitor.delivery}</li>
      </ul>

      <div class="hero-v3__actions">
        <a href={cta.primary.href} class="hero-v3__primary">
          {cta.primary.label}<span aria-hidden="true">→</span>
        </a>
        <a href={cta.secondary.href} class="hero-v3__secondary">
          <span class="doc-icon" aria-hidden="true">▣</span>{cta.secondary.label}
        </a>
      </div>
    </div>

    <div class="engine" aria-label="Evidence classification model">
      <div class="engine__halo" aria-hidden="true"></div>
      <div class="engine__orbit engine__orbit--one" aria-hidden="true"></div>
      <div class="engine__orbit engine__orbit--two" aria-hidden="true"></div>

      <section class="lane lane--unknown" aria-label="Unknown evidence examples">
        <header>
          <strong>Unknown</strong>
          <span>Not yet supported by public evidence</span>
        </header>
        <div class="unknown-card unknown-card--a"><b>?</b><span>product claim</span></div>
        <div class="unknown-card unknown-card--b"><b>?</b><span>roadmap</span></div>
        <div class="unknown-card unknown-card--c"><b>?</b><span>pricing intent</span></div>
      </section>

      <div class="chamber" aria-label="Evidence Axis chamber">
        <div class="chamber__cap chamber__cap--top" aria-hidden="true">
          <span>Evidence Axis</span>
        </div>
        <div class="chamber__glass" aria-hidden="true"></div>
        <div class="chamber__beam" aria-hidden="true"></div>
        <div class="chamber__axis-label">
          <strong>Fact</strong>
          <span>Verified evidence locked to the axis</span>
        </div>

        <div class="fact-stack">
          <article class="fact-card">
            <i>✓</i>
            <div><strong>documentation</strong><span>SOURCE: Public</span><span>CHECKED / DATED</span></div>
          </article>
          <article class="fact-card">
            <i>✓</i>
            <div><strong>pricing page</strong><span>SOURCE: Public</span><span>CHECKED / DATED</span></div>
          </article>
          <article class="fact-card">
            <i>✓</i>
            <div><strong>product page</strong><span>SOURCE: Public</span><span>CHECKED / DATED</span></div>
          </article>
        </div>

        <div class="chamber__cap chamber__cap--bottom" aria-hidden="true">
          <span>Trusted · Verifiable · Decision-ready</span>
        </div>
      </div>

      <section class="lane lane--inference" aria-label="Inference examples">
        <header>
          <strong>Inference</strong>
          <span>Logical conclusions connected to facts</span>
        </header>
        <div class="infer-card infer-card--a"><span>positioning shift</span><small>CONFIDENCE: High</small></div>
        <div class="infer-card infer-card--b"><span>packaging gap</span><small>CONFIDENCE: Medium</small></div>
        <div class="infer-card infer-card--c"><span>likely ICP focus</span><small>CONFIDENCE: Medium</small></div>
      </section>

      <article class="decision-card">
        <small>Decision output</small>
        <strong>Decision-Ready<br />Brief</strong>
        <p>Clear advantage.<br />Confident next move.</p>
        <span aria-hidden="true">→</span>
      </article>

      <svg class="engine__wires" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
        <path class="wire wire--unknown" d="M108 228 C210 228, 200 188, 365 188" />
        <path class="wire wire--unknown" d="M108 315 C220 315, 215 292, 365 292" />
        <path class="wire wire--unknown" d="M108 402 C220 402, 215 397, 365 397" />
        <path class="wire wire--fact" d="M560 188 C650 188, 642 225, 708 225" />
        <path class="wire wire--fact" d="M560 292 C650 292, 642 315, 708 315" />
        <path class="wire wire--fact" d="M560 397 C650 397, 642 405, 708 405" />
        <path class="wire wire--decision" d="M820 315 C865 315, 855 315, 900 315" />
      </svg>
    </div>
  </div>

  <div class="hero-v3__floor" aria-hidden="true"></div>
</section>

<script>
  import { initHeroSpatial } from '../scripts/hero-spatial';
  initHeroSpatial();
</script>

<style>
  .hero-v3 {
    --ink: #020914;
    --panel: #071426;
    --blue: #78a2ff;
    --cyan: #54e8e6;
    --violet: #a77cf6;
    --amber: #f0a638;
    position: relative;
    min-height: calc(100svh - 4.5rem);
    overflow: clip;
    color: #f7f4ec;
    background:
      radial-gradient(circle at 67% 42%, rgba(41, 112, 218, 0.22), transparent 27rem),
      radial-gradient(circle at 47% 82%, rgba(28, 170, 189, 0.10), transparent 25rem),
      linear-gradient(120deg, #020812 0%, #030b18 44%, #061229 100%);
    isolation: isolate;
  }
  .hero-v3::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(91, 133, 192, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(91, 133, 192, .035) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: linear-gradient(to right, transparent, #000 32%, #000 100%);
    pointer-events: none;
    z-index: -4;
  }
  .hero-v3__ambient {
    position: absolute;
    width: 58rem;
    aspect-ratio: 1;
    border-radius: 50%;
    right: -8rem;
    top: -10rem;
    background: radial-gradient(circle, rgba(58, 127, 255, .16), transparent 63%);
    filter: blur(18px);
    z-index: -3;
  }
  .hero-v3__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    z-index: -2;
    transition: opacity 800ms ease;
  }
  .hero-v3.hero--spatial-ready .hero-v3__canvas { opacity: .22; }
  .hero-v3__inner {
    position: relative;
    z-index: 2;
    min-height: calc(100svh - 4.5rem);
    display: grid;
    grid-template-columns: minmax(22rem, .78fr) minmax(44rem, 1.5fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: center;
    padding-block: clamp(3.25rem, 7vh, 6.5rem) clamp(3rem, 6vh, 5rem);
  }
  .hero-v3__copy { position: relative; z-index: 5; max-width: 35rem; }
  .hero-v3__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    color: #74a8ff;
    font-size: .72rem;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .hero-v3__eyebrow i { width: 1.6rem; height: 1px; background: currentColor; box-shadow: 0 0 12px currentColor; }
  .hero-v3__title {
    margin: 1.45rem 0 0;
    max-width: 9.3ch;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 5.1vw, 6.25rem);
    line-height: .99;
    letter-spacing: -.052em;
    font-weight: 620;
    text-wrap: balance;
  }
  .hero-v3__title span {
    display: block;
    margin-top: .18em;
    background: linear-gradient(100deg, #83a9ff 4%, #668fff 49%, #51d8df 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-v3__lede {
    max-width: 49ch;
    margin: 1.65rem 0 0;
    color: #b8c1d0;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.2vw, 1.16rem);
    line-height: 1.6;
  }
  .hero-v3__proof {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    list-style: none;
    padding: 0;
    margin: 1.55rem 0 0;
  }
  .hero-v3__proof li {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .55rem .7rem;
    border: 1px solid rgba(132, 169, 225, .23);
    border-radius: .45rem;
    background: rgba(6, 17, 33, .62);
    color: #cbd4e3;
    font-size: .82rem;
    backdrop-filter: blur(12px);
  }
  .proof-icon { color: var(--cyan); font-family: var(--font-mono); }
  .hero-v3__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.1rem; }
  .hero-v3__primary, .hero-v3__secondary {
    min-height: 3.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .8rem;
    padding: 0 1.45rem;
    border-radius: .5rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 620;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }
  .hero-v3__primary {
    color: #071020;
    background: linear-gradient(110deg, #8aa9ff, #50c8f0);
    border: 1px solid #91b3ff;
    box-shadow: 0 10px 36px rgba(56, 112, 255, .27), inset 0 1px rgba(255,255,255,.45);
  }
  .hero-v3__secondary { color: #e8edf6; border: 1px solid rgba(142, 169, 213, .26); background: rgba(2, 11, 24, .42); }
  .hero-v3__primary:hover, .hero-v3__secondary:hover { transform: translateY(-2px); }
  .hero-v3__secondary:hover { border-color: rgba(142, 169, 213, .55); }
  .doc-icon { color: var(--cyan); }

  .engine {
    position: relative;
    width: min(100%, 64rem);
    height: clamp(34rem, 68vh, 43rem);
    margin-left: auto;
    perspective: 1200px;
    filter: drop-shadow(0 30px 60px rgba(0,0,0,.42));
  }
  .engine__halo {
    position: absolute;
    left: 39%; top: 44%;
    width: 30rem; height: 30rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(45, 147, 255, .22), rgba(34, 109, 230, .06) 43%, transparent 66%);
    box-shadow: 0 0 100px rgba(34, 125, 255, .12);
  }
  .engine__orbit {
    position: absolute;
    left: 39%; top: 51%;
    transform: translate(-50%, -50%) rotateX(67deg);
    border: 1px solid rgba(77, 162, 255, .16);
    border-radius: 50%;
  }
  .engine__orbit--one { width: 36rem; height: 36rem; }
  .engine__orbit--two { width: 27rem; height: 27rem; border-style: dashed; opacity: .7; }

  .chamber {
    position: absolute;
    left: 39%; top: 8%;
    width: 20rem; height: 33rem;
    transform: translateX(-50%);
    border-left: 1px solid rgba(88, 190, 255, .34);
    border-right: 1px solid rgba(88, 190, 255, .34);
    background: linear-gradient(90deg, rgba(14,40,72,.4), rgba(16,83,130,.1) 35%, rgba(20,102,158,.16) 50%, rgba(9,47,87,.14) 68%, rgba(6,22,44,.46));
    box-shadow: inset 0 0 60px rgba(54, 154, 255, .12), 0 0 70px rgba(29, 113, 240, .15);
  }
  .chamber::before, .chamber::after {
    content: '';
    position: absolute;
    left: 1.05rem; right: 1.05rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(87, 223, 255, .65), transparent);
    box-shadow: 0 0 20px rgba(87, 223, 255, .45);
  }
  .chamber::before { top: 2.9rem; }
  .chamber::after { bottom: 2.6rem; }
  .chamber__glass { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 2rem, rgba(92, 163, 233, .035) 2.05rem 2.08rem); }
  .chamber__beam {
    position: absolute;
    left: 50%; top: -1.8rem; bottom: -2.1rem;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(to bottom, transparent, #8ddcff 10%, #5ba9ff 48%, #59f3ef 84%, transparent);
    box-shadow: 0 0 7px #79c9ff, 0 0 24px rgba(87, 167, 255, .8), 0 0 70px rgba(67, 133, 255, .36);
  }
  .chamber__beam::before {
    content: '';
    position: absolute;
    left: 50%; top: 48%;
    width: 8.5rem; height: 8.5rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(111, 210, 255, .18), transparent 66%);
  }
  .chamber__cap {
    position: absolute;
    left: -1.2rem; right: -1.2rem;
    height: 4.25rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(92, 154, 255, .43);
    background: linear-gradient(#0c1e39, #050d1a 52%, #112a4a);
    box-shadow: inset 0 1px rgba(255,255,255,.15), 0 0 28px rgba(44, 120, 255, .24);
    z-index: 4;
  }
  .chamber__cap--top { top: -2.2rem; border-radius: 50% / 45%; transform: perspective(320px) rotateX(-5deg); }
  .chamber__cap--top span { color: #e9efff; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .24em; font-size: .78rem; }
  .chamber__cap--bottom { bottom: -2.25rem; border-radius: 50% / 45%; }
  .chamber__cap--bottom span { color: #7e93b5; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .13em; font-size: .55rem; }
  .chamber__axis-label { position: absolute; top: 3.45rem; left: 50%; width: 11rem; transform: translateX(-50%); text-align: center; z-index: 3; }
  .chamber__axis-label strong { display: block; color: var(--cyan); text-transform: uppercase; letter-spacing: .14em; font-size: .78rem; }
  .chamber__axis-label span { display: block; margin-top: .3rem; color: #a8bacf; font-size: .67rem; line-height: 1.35; }
  .fact-stack { position: absolute; top: 9.2rem; left: 50%; width: 13.2rem; transform: translateX(-50%); display: grid; gap: .95rem; z-index: 3; }
  .fact-card {
    position: relative;
    display: grid;
    grid-template-columns: 1.8rem 1fr;
    gap: .65rem;
    align-items: center;
    min-height: 4.6rem;
    padding: .65rem .75rem;
    border: 1px solid rgba(83, 232, 230, .72);
    border-radius: .5rem;
    background: linear-gradient(100deg, rgba(7, 67, 82, .79), rgba(6, 29, 48, .86));
    box-shadow: inset 0 0 24px rgba(43, 224, 224, .08), 0 0 22px rgba(43, 211, 224, .08);
    backdrop-filter: blur(10px);
  }
  .fact-card::after { content: ''; position: absolute; right: -2.7rem; top: 50%; width: 2.7rem; height: 1px; background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }
  .fact-card i { width: 1.65rem; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: #69e5e1; color: #082333; font-style: normal; font-weight: 800; }
  .fact-card div { display: grid; gap: .15rem; min-width: 0; }
  .fact-card strong { color: #f0f8ff; font-size: .78rem; font-weight: 600; }
  .fact-card span { color: #7fa8b7; font-family: var(--font-mono); font-size: .46rem; letter-spacing: .03em; }

  .lane { position: absolute; z-index: 3; }
  .lane header { margin-bottom: 1.1rem; }
  .lane header strong { display: block; text-transform: uppercase; letter-spacing: .12em; font-family: var(--font-mono); font-size: .75rem; }
  .lane header span { display: block; max-width: 12rem; margin-top: .28rem; color: #9aa9be; font-size: .65rem; line-height: 1.35; }
  .lane--unknown { left: 0; top: 13%; width: 13rem; }
  .lane--unknown header strong { color: var(--violet); }
  .unknown-card, .infer-card {
    position: absolute;
    min-width: 8.6rem;
    border-radius: .45rem;
    backdrop-filter: blur(11px);
  }
  .unknown-card { height: 3.55rem; display: flex; align-items: center; gap: .55rem; padding: .65rem .8rem; border: 1px solid rgba(166, 119, 247, .54); background: rgba(34, 21, 70, .72); color: #d7c7ff; box-shadow: 0 0 22px rgba(127, 78, 235, .08); }
  .unknown-card b { width: 1.15rem; height: 1.15rem; display: grid; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-family: var(--font-mono); font-size: .62rem; }
  .unknown-card span { font-size: .66rem; }
  .unknown-card--a { top: 6rem; left: .3rem; }
  .unknown-card--b { top: 11.3rem; left: 1.1rem; }
  .unknown-card--c { top: 16.7rem; left: -.3rem; }

  .lane--inference { right: 7.7rem; top: 13%; width: 13rem; }
  .lane--inference header strong { color: var(--amber); }
  .infer-card { height: 3.65rem; display: grid; align-content: center; gap: .3rem; padding: .6rem .85rem; border: 1px solid rgba(241, 168, 58, .57); background: linear-gradient(110deg, rgba(76, 47, 10, .76), rgba(32, 26, 22, .84)); color: #ffe8c2; box-shadow: 0 0 22px rgba(230, 139, 27, .08); }
  .infer-card span { font-size: .68rem; }
  .infer-card small { color: #b9955d; font-family: var(--font-mono); font-size: .45rem; }
  .infer-card--a { top: 6rem; left: 0; }
  .infer-card--b { top: 11.3rem; left: 0; }
  .infer-card--c { top: 16.7rem; left: 0; }

  .decision-card {
    position: absolute;
    right: 0; top: 29%;
    width: 7.9rem; min-height: 17rem;
    display: flex; flex-direction: column;
    padding: 1.3rem 1rem;
    border: 1px solid rgba(71, 139, 255, .56);
    border-radius: .65rem;
    background: linear-gradient(165deg, rgba(9, 34, 70, .92), rgba(3, 13, 30, .94));
    box-shadow: inset 0 0 35px rgba(48, 113, 221, .08), 0 0 35px rgba(41, 102, 217, .10);
    z-index: 4;
  }
  .decision-card small { color: #6d9cff; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .12em; font-size: .51rem; }
  .decision-card strong { margin-top: 1.4rem; color: #eef5ff; font-size: 1.08rem; line-height: 1.2; }
  .decision-card p { margin-top: auto; color: #93a5c1; font-size: .61rem; line-height: 1.5; }
  .decision-card > span { align-self: flex-end; margin-top: .75rem; color: var(--cyan); font-size: 1.45rem; }

  .engine__wires { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; overflow: visible; }
  .wire { fill: none; stroke-width: 1.25; vector-effect: non-scaling-stroke; }
  .wire--unknown { stroke: rgba(167, 124, 246, .64); stroke-dasharray: 3 6; }
  .wire--fact { stroke: rgba(84, 232, 230, .75); }
  .wire--decision { stroke: rgba(106, 156, 255, .78); }

  .hero-v3__floor {
    position: absolute;
    left: 46%; right: -15%; bottom: -13rem; height: 22rem;
    border-radius: 50%;
    transform: perspective(500px) rotateX(68deg);
    background:
      repeating-radial-gradient(ellipse at center, transparent 0 4.8rem, rgba(77, 141, 255, .12) 4.9rem 5rem),
      radial-gradient(ellipse at center, rgba(43, 125, 255, .10), transparent 63%);
    z-index: 0;
  }

  @media (max-width: 82rem) {
    .hero-v3__inner { grid-template-columns: minmax(20rem, .78fr) minmax(38rem, 1.35fr); gap: 1rem; }
    .engine { transform: scale(.92); transform-origin: center right; width: 60rem; margin-left: -2rem; }
    .hero-v3__title { font-size: clamp(3.2rem, 5vw, 5.4rem); }
  }
  @media (max-width: 64rem) {
    .hero-v3 { min-height: auto; }
    .hero-v3__inner { min-height: auto; grid-template-columns: 1fr; padding-top: 3rem; }
    .hero-v3__copy { max-width: 42rem; }
    .hero-v3__title { max-width: 10ch; font-size: clamp(3rem, 9vw, 5.2rem); }
    .engine { width: min(100%, 58rem); height: 38rem; margin: 1rem auto 0; transform: none; }
    .hero-v3__floor { left: 5%; }
  }
  @media (max-width: 46rem) {
    .hero-v3__inner { padding-block: 2.4rem 3.6rem; }
    .hero-v3__eyebrow { font-size: .6rem; }
    .hero-v3__title { font-size: clamp(2.8rem, 13.4vw, 4.4rem); }
    .hero-v3__lede { font-size: .98rem; }
    .hero-v3__proof { gap: .4rem; }
    .hero-v3__proof li { font-size: .72rem; }
    .hero-v3__actions { display: grid; grid-template-columns: 1fr; }
    .hero-v3__primary, .hero-v3__secondary { width: 100%; }
    .engine { height: 32rem; overflow: hidden; border-top: 1px solid rgba(111, 153, 214, .12); margin-top: 1.5rem; }
    .engine__halo { left: 50%; width: 24rem; height: 24rem; }
    .engine__orbit { left: 50%; }
    .engine__orbit--one { width: 27rem; height: 27rem; }
    .engine__orbit--two { width: 21rem; height: 21rem; }
    .chamber { left: 50%; top: 13%; width: 16.5rem; height: 25.5rem; }
    .chamber__axis-label { top: 3.1rem; }
    .fact-stack { top: 8rem; width: 11.2rem; gap: .65rem; }
    .fact-card { min-height: 3.55rem; }
    .fact-card span { display: none; }
    .fact-card::after { display: none; }
    .lane, .decision-card, .engine__wires { display: none; }
    .chamber__cap--bottom { bottom: -1.8rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .chamber__beam { animation: beamPulse 3.2s ease-in-out infinite; }
    .engine__orbit--one { animation: orbitTurn 18s linear infinite; }
    .engine__orbit--two { animation: orbitTurnBack 24s linear infinite; }
    .unknown-card--a, .infer-card--c { animation: drift 5.2s ease-in-out infinite; }
    .unknown-card--c, .infer-card--a { animation: drift 6.4s ease-in-out infinite reverse; }
  }
  @keyframes beamPulse { 0%,100% { opacity: .72; filter: brightness(.9); } 50% { opacity: 1; filter: brightness(1.25); } }
  @keyframes orbitTurn { to { transform: translate(-50%, -50%) rotateX(67deg) rotateZ(360deg); } }
  @keyframes orbitTurnBack { to { transform: translate(-50%, -50%) rotateX(67deg) rotateZ(-360deg); } }
  @keyframes drift { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
</style>
