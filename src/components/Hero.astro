---
import { offers, cta } from '@config/site';
---
<section class="hero5" data-hero5 data-surface="dark" aria-labelledby="hero5-title">
  <div class="hero5__grid" aria-hidden="true"></div>
  <div class="hero5__aurora hero5__aurora--one" aria-hidden="true"></div>
  <div class="hero5__aurora hero5__aurora--two" aria-hidden="true"></div>

  <div class="container-wide hero5__layout">
    <div class="hero5__copy">
      <div class="hero5__kicker mono"><span></span>COMPETITOR INTELLIGENCE / B2B SAAS</div>
      <h1 id="hero5-title">Know what competitors can prove.<em>See what they can’t.</em></h1>
      <p>Decision-ready competitor evidence from lawful public sources. Sourced, dated, and separated into Fact, Inference, and Unknown.</p>

      <div class="hero5__actions">
        <a class="hero5__primary" href={cta.primary.href}>{cta.primary.label}<span aria-hidden="true">→</span></a>
        <a class="hero5__secondary" href="/sample-report/">View Sample Report</a>
      </div>

      <div class="hero5__meta mono">
        <span><b>{offers.twoCompetitor.priceDisplay}</b> PILOT</span>
        <span><b>{offers.twoCompetitor.delivery}</b> DELIVERY</span>
        <span><b>PUBLIC</b> EVIDENCE</span>
      </div>
    </div>

    <div class="hero5__stage" data-hero5-stage aria-label="Interactive Evidence Axis model">
      <div class="hero5__scene" data-hero5-scene>
        <div class="orbit orbit--back" aria-hidden="true"></div>
        <div class="orbit orbit--mid" aria-hidden="true"></div>
        <div class="orbit orbit--front" aria-hidden="true"></div>
        <div class="floor5" aria-hidden="true"></div>

        <div class="unknown-cloud unknown-cloud--a">
          <span class="unknown-cloud__mark">?</span>
          <div><small>UNKNOWN</small><strong>Roadmap intent</strong><b>not established</b></div>
        </div>
        <div class="unknown-cloud unknown-cloud--b">
          <span class="unknown-cloud__mark">?</span>
          <div><small>UNKNOWN</small><strong>Private usage</strong><b>not public</b></div>
        </div>

        <div class="axis5">
          <div class="axis5__cap axis5__cap--top"><span>EVIDENCE AXIS</span></div>
          <div class="axis5__body">
            <div class="axis5__beam"></div>
            <div class="axis5__scan"></div>
            <div class="axis5__glow"></div>
          </div>
          <div class="axis5__cap axis5__cap--bottom"><span>VERIFIED / TRACEABLE</span></div>

          <div class="fact-plane fact-plane--one">
            <i>✓</i><div><small>FACT / 01</small><strong>Pricing page</strong><span>checked + dated</span></div>
          </div>
          <div class="fact-plane fact-plane--two">
            <i>✓</i><div><small>FACT / 02</small><strong>Documentation</strong><span>public source</span></div>
          </div>
          <div class="fact-plane fact-plane--three">
            <i>✓</i><div><small>FACT / 03</small><strong>Product evidence</strong><span>source locked</span></div>
          </div>
        </div>

        <div class="inference-rail">
          <div class="inference-rail__head"><small>INFERENCE</small><span>reasoning layer</span></div>
          <div class="inference-chip"><b>↗</b><span>Packaging shift</span><small>HIGH CONFIDENCE</small></div>
          <div class="inference-chip"><b>↗</b><span>Positioning gap</span><small>MEDIUM CONFIDENCE</small></div>
        </div>

        <div class="decision-terminal">
          <div class="decision-terminal__top mono"><span>DECISION OUTPUT</span><b>READY</b></div>
          <strong>Decision-Ready<br/>Brief</strong>
          <p>Evidence separated from judgment. Unknowns kept visible.</p>
          <div class="decision-terminal__route"><span>FACT</span><i>→</i><span>REASON</span><i>→</i><b>MOVE</b></div>
        </div>

        <svg class="links5" viewBox="0 0 1000 700" preserveAspectRatio="none" aria-hidden="true">
          <path class="links5__fact" d="M455 250 C620 250 650 315 770 315"/>
          <path class="links5__fact" d="M455 350 C620 350 650 350 770 350"/>
          <path class="links5__fact" d="M455 450 C620 450 650 385 770 385"/>
          <path class="links5__decision" d="M805 350 C875 350 900 350 935 350"/>
        </svg>
      </div>

      <div class="hero5__stage-label mono"><span>MOVE POINTER</span><i></i><span>ROTATE MODEL</span></div>
    </div>
  </div>
</section>

<style>
  .hero5{
    --blue:#80a8ff;--cyan:#5ce8e3;--violet:#ad84ff;--amber:#efb85e;
    position:relative;min-height:calc(100svh - 4.5rem);overflow:hidden;color:#f5f8fc;
    background:radial-gradient(circle at 76% 43%,rgba(41,102,236,.2),transparent 30rem),linear-gradient(115deg,#020711 0%,#030a17 46%,#07152d 100%);
    isolation:isolate;
  }
  .hero5__grid{position:absolute;inset:0;z-index:-4;background-image:linear-gradient(rgba(91,135,196,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(91,135,196,.035) 1px,transparent 1px);background-size:58px 58px;mask-image:linear-gradient(90deg,transparent,#000 34%,#000 100%)}
  .hero5__aurora{position:absolute;border-radius:50%;filter:blur(64px);pointer-events:none;z-index:-3}.hero5__aurora--one{width:34rem;height:34rem;right:4%;top:5%;background:rgba(54,105,255,.11)}.hero5__aurora--two{width:28rem;height:28rem;right:26%;bottom:-10rem;background:rgba(35,225,220,.07)}

  .hero5__layout{min-height:calc(100svh - 4.5rem);display:grid;grid-template-columns:minmax(21rem,.72fr) minmax(46rem,1.48fr);gap:clamp(1.5rem,3vw,3.5rem);align-items:center;padding-block:clamp(3rem,5vh,4.5rem)}
  .hero5__copy{position:relative;z-index:7;max-width:35rem}.hero5__kicker{display:flex;align-items:center;gap:.75rem;color:#78a5ff;font-size:.66rem;letter-spacing:.16em}.hero5__kicker span{width:1.5rem;height:1px;background:currentColor;box-shadow:0 0 12px currentColor}
  .hero5 h1{margin:1.1rem 0 0;max-width:10ch;font-family:var(--font-display);font-size:clamp(3.05rem,4.25vw,5.05rem);line-height:1.01;letter-spacing:-.05em;font-weight:650;text-wrap:balance}.hero5 h1 em{display:block;margin-top:.12em;font-style:normal;background:linear-gradient(100deg,#8cacff,#68a1ff 50%,#59dfdf 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero5__copy>p{margin:1.25rem 0 0;max-width:47ch;color:#b8c5d4;font-size:1.03rem;line-height:1.65}
  .hero5__actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.35rem}.hero5__actions a{display:inline-flex;align-items:center;justify-content:center;min-height:3.15rem;padding:0 1.15rem;border-radius:.58rem;text-decoration:none;font-family:var(--font-display);font-weight:650}.hero5__primary{gap:.8rem;color:#06101c;background:linear-gradient(110deg,#8cacff,#5ed6e3);box-shadow:0 15px 36px rgba(61,116,239,.22)}.hero5__secondary{color:#dce7f6;border:1px solid rgba(127,164,220,.25);background:rgba(6,18,34,.54)}
  .hero5__meta{display:flex;gap:1.1rem;flex-wrap:wrap;margin-top:1.15rem;color:#7187a5;font-size:.63rem;letter-spacing:.08em}.hero5__meta span{display:flex;gap:.35rem}.hero5__meta b{color:#c4d2e5;font-weight:600}

  .hero5__stage{position:relative;height:clamp(39rem,72vh,49rem);perspective:1150px;perspective-origin:50% 48%;cursor:crosshair;z-index:3}
  .hero5__scene{--rx:0deg;--ry:0deg;--mx:0px;--my:0px;position:absolute;inset:0;transform-style:preserve-3d;transform:rotateX(var(--rx)) rotateY(var(--ry)) scale(1);transition:transform 140ms cubic-bezier(.2,.8,.2,1);will-change:transform}
  .hero5__stage:hover .hero5__scene{filter:drop-shadow(0 38px 64px rgba(0,0,0,.32))}
  .hero5__scene>*{transform-style:preserve-3d}

  .orbit{position:absolute;left:48%;top:50%;border-radius:50%;border:1px solid rgba(90,157,255,.2);pointer-events:none}.orbit--back{width:36rem;height:36rem;transform:translate(-50%,-50%) rotateX(72deg) translateZ(-150px)}.orbit--mid{width:29rem;height:29rem;border-style:dashed;opacity:.8;transform:translate(-50%,-50%) rotateX(72deg) translateZ(-40px)}.orbit--front{width:22rem;height:22rem;border-color:rgba(88,224,223,.22);transform:translate(-50%,-50%) rotateX(72deg) translateZ(70px)}
  .floor5{position:absolute;left:17%;right:2%;bottom:-9rem;height:18rem;border-radius:50%;transform:rotateX(79deg) translateZ(-165px);background:repeating-radial-gradient(ellipse at center,transparent 0 4rem,rgba(83,145,232,.14) 4.08rem 4.16rem),radial-gradient(ellipse at center,rgba(44,124,255,.12),transparent 66%)}

  .axis5{position:absolute;left:46%;top:8%;width:20rem;height:35rem;transform:translateX(-50%) translateZ(70px) rotateY(-7deg);transform-style:preserve-3d}
  .axis5__body{position:absolute;inset:1.4rem 1.2rem;background:linear-gradient(90deg,rgba(8,29,54,.95),rgba(27,100,146,.25) 35%,rgba(45,178,190,.16) 50%,rgba(25,91,141,.25) 68%,rgba(5,19,38,.95));border-left:1px solid rgba(89,190,238,.46);border-right:1px solid rgba(89,190,238,.46);box-shadow:inset 0 0 80px rgba(61,157,237,.14),0 0 90px rgba(39,114,255,.18)}
  .axis5__cap{position:absolute;left:-.3rem;right:-.3rem;height:4.3rem;display:grid;place-items:center;border:1px solid rgba(91,153,255,.5);background:linear-gradient(#132c4f,#07111f 55%,#173760);box-shadow:inset 0 1px rgba(255,255,255,.16),0 0 32px rgba(50,118,255,.22);z-index:6}.axis5__cap--top{top:-.5rem;border-radius:50% / 44%;transform:translateZ(30px)}.axis5__cap--bottom{bottom:-.5rem;border-radius:50% / 44%;transform:translateZ(24px)}.axis5__cap span{font-family:var(--font-mono);font-size:.67rem;letter-spacing:.18em;color:#dce8fa}.axis5__cap--bottom span{font-size:.5rem;color:#7991b1}
  .axis5__beam{position:absolute;left:50%;top:-1rem;bottom:-1rem;width:3px;transform:translateX(-50%) translateZ(55px);background:linear-gradient(transparent,#9edcff 9%,#68a6ff 48%,#5ce8e3 88%,transparent);box-shadow:0 0 10px #79caff,0 0 34px rgba(86,181,255,.82),0 0 95px rgba(58,120,255,.42);animation:beam5 2.5s ease-in-out infinite}.axis5__scan{position:absolute;left:12%;right:12%;height:3.6rem;top:22%;transform:translateZ(38px);border-top:1px solid rgba(93,235,229,.45);border-bottom:1px solid rgba(93,235,229,.2);background:linear-gradient(180deg,rgba(82,230,225,.08),transparent);animation:scan5 5.2s ease-in-out infinite}.axis5__glow{position:absolute;left:50%;top:50%;width:13rem;height:13rem;border-radius:50%;transform:translate(-50%,-50%) translateZ(26px);background:radial-gradient(circle,rgba(88,220,255,.24),transparent 68%);filter:blur(4px)}

  .fact-plane{position:absolute;left:50%;width:14.2rem;min-height:4.8rem;display:grid;grid-template-columns:1.8rem 1fr;gap:.65rem;align-items:center;padding:.7rem .8rem;border:1px solid rgba(87,230,225,.72);border-radius:.62rem;background:linear-gradient(105deg,rgba(5,69,82,.96),rgba(5,27,48,.96));box-shadow:0 18px 34px rgba(0,0,0,.22),inset 0 0 26px rgba(70,224,219,.08);z-index:9}.fact-plane i{width:1.75rem;height:1.75rem;display:grid;place-items:center;border-radius:.45rem;background:rgba(72,225,220,.13);color:#66ebe5;font-style:normal;font-weight:800}.fact-plane small{display:block;color:#63e4df;font-size:.58rem;letter-spacing:.1em}.fact-plane strong{display:block;margin-top:.18rem;color:#f1f7fb;font-size:1rem}.fact-plane span{display:block;margin-top:.2rem;color:#a9bdcf;font-size:.72rem}.fact-plane--one{top:9rem;transform:translateX(-50%) translateZ(110px) rotateY(5deg)}.fact-plane--two{top:15.4rem;transform:translateX(-50%) translateZ(145px)}.fact-plane--three{top:21.8rem;transform:translateX(-50%) translateZ(105px) rotateY(-5deg)}

  .unknown-cloud{position:absolute;display:grid;grid-template-columns:2.2rem 1fr;gap:.7rem;align-items:center;width:13rem;padding:.75rem;border:1px solid rgba(171,132,255,.42);border-radius:.7rem;background:linear-gradient(120deg,rgba(49,35,88,.9),rgba(10,20,40,.95));box-shadow:0 18px 34px rgba(0,0,0,.2);z-index:5}.unknown-cloud__mark{width:2.1rem;height:2.1rem;display:grid;place-items:center;border-radius:50%;border:1px dashed #b18cff;color:#ba95ff;font-weight:700}.unknown-cloud small{display:block;color:#b18cff;font-size:.58rem;letter-spacing:.1em}.unknown-cloud strong{display:block;margin-top:.15rem;color:#e6e9f3;font-size:.9rem}.unknown-cloud b{display:block;margin-top:.18rem;color:#8f9eb3;font-size:.66rem;font-weight:500}.unknown-cloud--a{left:2%;top:20%;transform:translateZ(-35px) rotateY(12deg)}.unknown-cloud--b{left:6%;top:60%;transform:translateZ(5px) rotateY(9deg)}

  .inference-rail{position:absolute;left:67%;top:17%;width:14rem;padding:1rem;border-left:2px solid rgba(239,184,94,.65);background:linear-gradient(90deg,rgba(239,184,94,.08),transparent);transform:translateZ(95px) rotateY(-6deg);z-index:7}.inference-rail__head{margin-bottom:1rem}.inference-rail__head small{display:block;color:#efb85e;font-size:.62rem;letter-spacing:.12em}.inference-rail__head span{display:block;margin-top:.2rem;color:#93a4b8;font-size:.72rem}.inference-chip{padding:.7rem .75rem;margin-top:.65rem;border:1px solid rgba(239,184,94,.25);border-radius:.55rem;background:rgba(25,29,34,.78)}.inference-chip b{color:#efb85e}.inference-chip span{display:block;margin-top:.25rem;color:#edf0f4;font-size:.87rem}.inference-chip small{display:block;margin-top:.28rem;color:#928c7f;font-size:.58rem;letter-spacing:.08em}

  .decision-terminal{position:absolute;right:1.5%;top:36%;width:15.8rem;padding:1rem 1rem 1.05rem;border:1px solid rgba(109,158,255,.5);border-radius:.78rem;background:linear-gradient(145deg,rgba(11,34,66,.98),rgba(5,17,32,.98));box-shadow:0 25px 55px rgba(0,0,0,.28),0 0 55px rgba(64,118,255,.1);transform:translateZ(180px) rotateY(-9deg);z-index:10}.decision-terminal__top{display:flex;justify-content:space-between;align-items:center;padding-bottom:.7rem;border-bottom:1px solid rgba(117,157,216,.18);font-size:.58rem;color:#7c92b1}.decision-terminal__top b{color:#63e4df}.decision-terminal>strong{display:block;margin-top:1rem;font-family:var(--font-display);font-size:1.55rem;line-height:1.05;color:#f4f8fc}.decision-terminal>p{margin:.65rem 0 0;color:#aebdd0;font-size:.82rem;line-height:1.5}.decision-terminal__route{display:flex;align-items:center;gap:.35rem;margin-top:1rem;padding-top:.75rem;border-top:1px solid rgba(117,157,216,.14);font-size:.57rem;color:#7990ac}.decision-terminal__route b{color:#dce8f8}.decision-terminal__route i{color:#5f86c8;font-style:normal}

  .links5{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;transform:translateZ(25px);z-index:2}.links5 path{fill:none;stroke-width:1.2;vector-effect:non-scaling-stroke}.links5__fact{stroke:rgba(87,231,225,.35);stroke-dasharray:4 8;animation:dash5 5s linear infinite}.links5__decision{stroke:rgba(125,166,255,.48);stroke-width:1.5}
  .hero5__stage-label{position:absolute;left:50%;bottom:.15rem;transform:translateX(-50%);display:flex;align-items:center;gap:.55rem;color:#57708f;font-size:.55rem;letter-spacing:.13em}.hero5__stage-label i{width:2rem;height:1px;background:linear-gradient(90deg,transparent,#5d83b7,transparent)}

  @keyframes beam5{0%,100%{opacity:.68}50%{opacity:1;box-shadow:0 0 12px #8ed6ff,0 0 42px rgba(86,181,255,.94),0 0 105px rgba(58,120,255,.5)}}
  @keyframes scan5{0%,100%{top:18%;opacity:.2}50%{top:72%;opacity:.8}}
  @keyframes dash5{to{stroke-dashoffset:-40}}

  @media(max-width:76rem){.hero5__layout{grid-template-columns:minmax(20rem,.8fr) minmax(38rem,1.2fr)}.hero5__stage{transform:scale(.9);transform-origin:center right}.hero5 h1{font-size:clamp(3rem,4.8vw,4.5rem)}}
  @media(max-width:64rem){.hero5{min-height:auto}.hero5__layout{min-height:auto;grid-template-columns:1fr;padding-block:4rem 3rem}.hero5__copy{max-width:42rem}.hero5 h1{max-width:11ch}.hero5__stage{height:38rem;transform:none}.unknown-cloud--a{left:5%}.unknown-cloud--b{left:8%}.decision-terminal{right:4%}}
  @media(max-width:48rem){.hero5__layout{padding-top:3.2rem}.hero5 h1{font-size:clamp(2.75rem,12vw,3.8rem)}.hero5__copy>p{font-size:1rem}.hero5__stage{height:27rem;margin-top:1.4rem;overflow:hidden}.hero5__scene{transform:scale(.67);transform-origin:center top;left:-23%;right:-23%;top:0}.hero5__stage-label{display:none}.hero5__meta{gap:.7rem}.hero5__actions a{flex:1 1 10rem}}
  @media(prefers-reduced-motion:reduce){.hero5__scene{transition:none!important}.axis5__beam,.axis5__scan,.links5__fact{animation:none!important}}
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-hero5-stage]');
  const scene = document.querySelector<HTMLElement>('[data-hero5-scene]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && scene && !reduce) {
    let raf = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const render = () => {
      currentX += (targetX - currentX) * 0.11;
      currentY += (targetY - currentY) * 0.11;
      scene.style.setProperty('--rx', `${currentX.toFixed(2)}deg`);
      scene.style.setProperty('--ry', `${currentY.toFixed(2)}deg`);
      if (Math.abs(targetX - currentX) > 0.02 || Math.abs(targetY - currentY) > 0.02) raf = requestAnimationFrame(render);
      else raf = 0;
    };

    const queue = () => { if (!raf) raf = requestAnimationFrame(render); };

    stage.addEventListener('pointermove', (event) => {
      const r = stage.getBoundingClientRect();
      const nx = ((event.clientX - r.left) / r.width - 0.5) * 2;
      const ny = ((event.clientY - r.top) / r.height - 0.5) * 2;
      targetY = nx * 18;
      targetX = ny * -8;
      queue();
    });

    stage.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;
      queue();
    });
  }
</script>
