---
import { offers, cta } from '@config/site';
/**
 * Homepage hero.
 * Layered by capability:
 *  - Base / fallback (this markup): a CSS/SVG "evidence field" that aligns
 *    onto the axis. Fully readable with no JS, and used for reduced-motion,
 *    mobile, and no-WebGL.
 *  - Enhancement (Phase 2): on capable desktops, src/scripts/hero-spatial
 *    adds `.hero--spatial-ready` ONLY after the WebGL2 scene has loaded, fonts
 *    are ready and a first frame has rendered — then swaps in a full-bleed
 *    procedural Three.js scene (scatter → classify → align → decision).
 * Essential headline, pricing and CTA text always live in semantic DOM,
 * never inside the canvas.
 */
const fragments = [
  { label: 'pricing page', state: 'fact', x: -46, y: -30, r: -6, d: 0 },
  { label: 'documentation', state: 'fact', x: -60, y: 46, r: 5, d: 90 },
  { label: 'changelog', state: 'inference', x: 40, y: -54, r: 7, d: 180 },
  { label: 'public reviews', state: 'inference', x: 54, y: 30, r: -5, d: 140 },
  { label: 'marketplace', state: 'unknown', x: -30, y: 92, r: 4, d: 240 },
  { label: 'private churn', state: 'unknown', x: 48, y: 96, r: -7, d: 300 },
];
const rows = [
  { state: 'fact', label: 'Fact', note: 'evidence-backed' },
  { state: 'inference', label: 'Inference', note: 'reasoned' },
  { state: 'unknown', label: 'Unknown', note: 'unresolved' },
];
---
<section class="hero" data-hero data-surface="dark" aria-labelledby="hero-title">
  <div class="hero__stage">
  <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="container-wide hero__grid">
    <div class="hero__copy">
      <span class="label eyebrow">Competitor intelligence for B2B SaaS</span>
      <h1 id="hero-title" class="hero__title">
        Scattered competitor information,<br />
        <span class="hero__title-accent">resolved into decision-ready evidence.</span>
      </h1>
      <p class="hero__lede">
        You rarely lack competitor information. You lack clarity about what is
        actually supported, what is marketing language, and what remains unknown.
        Evidence Axis turns public evidence into a structured decision brief —
        every claim sourced, dated, and marked Fact, Inference or Unknown.
      </p>
      <div class="hero__actions">
        <a href={cta.primary.href} class="btn btn--lg">
          {cta.primary.label}<span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href={cta.secondary.href} class="btn btn--ghost btn--lg">
          {cta.secondary.label}
        </a>
      </div>
      <p class="hero__meta mono">
        Two-Competitor Decision Brief · <strong>{offers.twoCompetitor.priceDisplay}</strong>
        pilot · {offers.twoCompetitor.delivery} · asynchronous, no sales call
      </p>

      <ol class="hero__states" data-hero-states data-active="0" aria-hidden="true">
        <li>Scattered</li>
        <li>Classified</li>
        <li>Aligned</li>
        <li>Decision</li>
      </ol>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="evidence-field" data-evidence-field>
        <svg class="evidence-field__axis" viewBox="0 0 40 320" preserveAspectRatio="none">
          <line x1="20" y1="6" x2="20" y2="314" />
        </svg>
        <span class="ef-axis-label ef-axis-label--top mono">AXIS</span>
        <span class="ef-axis-label ef-axis-label--bottom mono">DECISION</span>

        {fragments.map((f) => (
          <span
            class:list={['ef-frag', `ef-frag--${f.state}`]}
            style={`--fx:${f.x}px; --fy:${f.y}px; --fr:${f.r}deg; --fd:${f.d}ms;`}
          >
            <i class="ef-frag__dot"></i>{f.label}
          </span>
        ))}

        <ul class="ef-rows">
          {rows.map((r, i) => (
            <li class:list={['ef-row', `ef-row--${r.state}`]} style={`--rd:${i * 120 + 380}ms;`}>
              <span class="ef-row__marker"></span>
              <span class="ef-row__label mono">{r.label}</span>
              <span class="ef-row__note mono">{r.note}</span>
            </li>
          ))}
        </ul>

        <div class="ef-decision" style="--rd:820ms;">
          <span class="mono">→ decision implication</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="mono">scroll</span>
    <span class="hero__scroll-line"></span>
  </div>
  </div><!-- /.hero__stage -->
</section>

<script>
  import { initHeroSpatial } from '../scripts/hero-spatial';
  initHeroSpatial();
</script>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(120% 90% at 78% 8%, color-mix(in srgb, var(--signal-600) 20%, transparent), transparent 55%),
      var(--bg);
    color: var(--text);
    padding-block: clamp(3rem, 2rem + 8vw, 7rem) clamp(3rem, 2rem + 5vw, 5.5rem);
    overflow: clip;
  }
  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    grid-template-columns: 1fr;
  }
  .hero__title {
    font-size: var(--step-6);
    margin-top: var(--space-xs);
    letter-spacing: -0.025em;
  }
  .hero__title-accent { color: var(--accent); }
  .hero__lede {
    margin-top: var(--space-l);
    max-width: 52ch;
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }
  .hero__meta {
    margin-top: var(--space-l);
    font-size: var(--step--1);
    color: var(--text-faint);
    letter-spacing: 0.01em;
  }
  .hero__meta strong { color: var(--accent); font-weight: 500; }

  /* ---- Phase 2 spatial enhancement (progressive) ---- */
  .hero__canvas { display: none; pointer-events: none; }
  .hero__stage { position: relative; }
  .hero__states { display: none; }
  .hero__states {
    list-style: none; padding: 0; margin: var(--space-xl) 0 0;
    flex-wrap: wrap; gap: 0.5rem 1.15rem;
    font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--text-faint);
  }
  .hero__states li { position: relative; padding-left: 1.05rem; transition: color var(--dur-2) var(--ease-out); }
  .hero__states li::before {
    content: ''; position: absolute; left: 0; top: 0.5em;
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    border: 1px solid currentColor;
    transition: background var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out);
  }
  .hero__states[data-active='0'] li:nth-child(-n+1),
  .hero__states[data-active='1'] li:nth-child(-n+2),
  .hero__states[data-active='2'] li:nth-child(-n+3),
  .hero__states[data-active='3'] li:nth-child(-n+4) { color: var(--accent); }
  .hero__states[data-active='0'] li:nth-child(-n+1)::before,
  .hero__states[data-active='1'] li:nth-child(-n+2)::before,
  .hero__states[data-active='2'] li:nth-child(-n+3)::before,
  .hero__states[data-active='3'] li:nth-child(-n+4)::before { background: var(--accent); border-color: var(--accent); }

  .hero--spatial-ready { padding-block: 0; min-height: 240vh; }
  .hero--spatial-ready .hero__stage {
    position: sticky; top: 0; height: 100vh; min-height: 620px;
    display: flex; align-items: center; overflow: hidden;
    padding-block: clamp(4.5rem, 11vh, 7rem) 2rem;
  }
  .hero--spatial-ready .hero__canvas {
    display: block; position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0;
  }
  .hero--spatial-ready .hero__stage::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg,
      var(--bg) 0%,
      var(--bg) 30%,
      color-mix(in srgb, var(--bg) 72%, transparent) 46%,
      transparent 70%);
  }
  .hero--spatial-ready .hero__grid { position: relative; z-index: 2; width: 100%; }
  .hero--spatial-ready .hero__visual { display: none; }
  .hero--spatial-ready .hero__states { display: flex; }
  .hero--spatial-ready .hero__title { font-size: var(--step-5); }
  /* Pinned view has a fixed vertical budget — tighten the rhythm so headline,
     pricing microcopy and the state row all stay above the fold. */
  .hero--spatial-ready .hero__lede { margin-top: var(--space-m); }
  .hero--spatial-ready .hero__actions { margin-top: var(--space-m); }
  .hero--spatial-ready .hero__meta { margin-top: var(--space-m); }
  .hero--spatial-ready .hero__states { margin-top: var(--space-m); }

  /* ---- Evidence field visual ---- */
  .hero__visual { min-height: 340px; display: grid; place-items: center; }
  .evidence-field {
    position: relative;
    width: min(100%, 30rem);
    height: 340px;
  }
  .evidence-field__axis {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 40px;
    height: 100%;
  }
  .evidence-field__axis line {
    stroke: var(--axis-line);
    stroke-width: 1.5;
    stroke-dasharray: 2 4;
  }
  .ef-axis-label {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--text-faint);
  }
  .ef-axis-label--top { top: -0.2rem; }
  .ef-axis-label--bottom { bottom: -0.4rem; color: var(--accent); }

  .ef-frag {
    position: absolute;
    left: 50%;
    top: 50%;
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--bg-raised) 88%, transparent);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-s);
    padding: 0.32em 0.6em;
    white-space: nowrap;
    backdrop-filter: blur(3px);
    transform: translate(calc(-50% + var(--fx)), calc(-50% + var(--fy))) rotate(var(--fr));
    animation: fragAlign 900ms var(--ease-out) both;
    animation-delay: var(--fd);
    box-shadow: var(--shadow-2);
  }
  .ef-frag__dot { width: 0.5em; height: 0.5em; border-radius: 50%; flex: none; }
  .ef-frag--fact .ef-frag__dot { background: var(--fact); }
  .ef-frag--inference .ef-frag__dot { background: var(--infer); }
  .ef-frag--unknown .ef-frag__dot { background: transparent; border: 1px solid var(--unknown); }

  @keyframes fragAlign {
    0% { opacity: 0; transform: translate(calc(-50% + var(--fx)), calc(-50% + var(--fy))) rotate(var(--fr)) scale(0.9); }
    60% { opacity: 1; }
    100% { opacity: 0.55; transform: translate(calc(-50% + var(--fx)), calc(-50% + var(--fy))) rotate(var(--fr)) scale(1); }
  }

  .ef-rows {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    width: min(88%, 22rem);
    z-index: var(--z-raised);
  }
  .ef-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.7ch;
    background: var(--bg-raised);
    border: 1px solid var(--surface-border);
    border-left-width: 3px;
    border-radius: var(--radius-s);
    padding: 0.6em 0.8em;
    box-shadow: var(--shadow-3);
    animation: rowIn 600ms var(--ease-out) both;
    animation-delay: var(--rd);
  }
  .ef-row--fact { border-left-color: var(--fact); }
  .ef-row--inference { border-left-color: var(--infer); border-left-style: dashed; }
  .ef-row--unknown { border-left-color: var(--unknown); border-left-style: dotted; }
  .ef-row__marker { width: 0.7em; height: 0.7em; border-radius: 50%; }
  .ef-row--fact .ef-row__marker { background: var(--fact); }
  .ef-row--inference .ef-row__marker { background: linear-gradient(90deg, var(--infer) 50%, transparent 50%); border: 1px solid var(--infer); }
  .ef-row--unknown .ef-row__marker { background: transparent; border: 1px solid var(--unknown); }
  .ef-row__label { font-size: 0.78rem; color: var(--text); font-weight: 500; }
  .ef-row__note { font-size: 0.66rem; color: var(--text-faint); }

  @keyframes rowIn {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: none; }
  }

  .ef-decision {
    position: absolute;
    left: 50%;
    bottom: 0.2rem;
    transform: translateX(-50%);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.7rem;
    padding: 0.4em 0.8em;
    border-radius: var(--radius-s);
    animation: rowIn 600ms var(--ease-out) both;
    animation-delay: var(--rd);
    box-shadow: var(--shadow-3);
  }

  .hero__scroll {
    position: absolute;
    left: var(--gutter);
    bottom: 1.2rem;
    display: none;
    align-items: center;
    gap: 0.7ch;
    color: var(--text-faint);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hero__scroll-line { width: 3rem; height: 1px; background: var(--hairline); position: relative; overflow: hidden; }
  .hero__scroll-line::after {
    content: ''; position: absolute; inset: 0; width: 40%;
    background: var(--accent);
    animation: scrollHint 2.4s var(--ease-in-out) infinite;
  }
  @keyframes scrollHint { 0% { transform: translateX(-120%); } 100% { transform: translateX(300%); } }

  @media (min-width: 64rem) {
    .hero__grid { grid-template-columns: 1.05fr 0.95fr; }
    .hero__scroll { display: flex; }
  }

  /* Short laptop heights: keep headline, pricing and CTA inside the pinned view. */
  @media (min-width: 64rem) and (max-height: 820px) {
    .hero--spatial-ready .hero__title { font-size: var(--step-4); }
    .hero--spatial-ready .hero__lede { margin-top: var(--space-m); font-size: var(--step-0); }
    .hero--spatial-ready .hero__states { margin-top: var(--space-l); }
    .hero--spatial-ready .hero__stage { padding-block: clamp(3.5rem, 8vh, 5rem) 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ef-frag { animation: none; opacity: 0.55; }
    .ef-row, .ef-decision { animation: none; opacity: 1; transform: translateX(-50%); }
    .ef-row { transform: none; }
    .hero__scroll-line::after { animation: none; }
  }
</style>
