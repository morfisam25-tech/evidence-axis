---
import { offers, cta } from '@config/site';
import ProductFilm from './ProductFilm.astro';
---
<section class="hero7" aria-labelledby="hero7-title">
  <ProductFilm />
  <div class="hero7__shade" aria-hidden="true"></div>
  <div class="container-wide hero7__inner">
    <div class="hero7__copy">
      <div class="hero7__eyebrow mono"><span></span>COMPETITOR INTELLIGENCE FOR B2B SAAS</div>
      <h1 id="hero7-title"><span>Know what competitors can prove.</span><em>See what they can’t.</em></h1>
      <p>Evidence Axis turns scattered public competitor information into a source-checked decision brief. Facts stay facts. Inferences stay labeled. Unknowns stay visible.</p>
      <div class="hero7__actions">
        <a class="hero7__primary" href={cta.primary.href}>{cta.primary.label}<span aria-hidden="true">→</span></a>
        <a class="hero7__secondary" href="/sample-report/">View Sample Report</a>
      </div>
      <div class="hero7__proof mono">
        <span><b>{offers.twoCompetitor.priceDisplay}</b><small>PILOT</small></span>
        <span><b>{offers.twoCompetitor.delivery}</b><small>DELIVERY</small></span>
        <span><b>PUBLIC</b><small>EVIDENCE</small></span>
      </div>
    </div>
  </div>
  <a class="hero7__scroll mono" href="#proof">SCROLL TO THE EVIDENCE <span>↓</span></a>
</section>

<style>
  .hero7{position:relative;min-height:calc(100svh - 5rem);overflow:hidden;background:#020713;color:#fff;isolation:isolate}.hero7__shade{position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(2,7,18,.98) 0%,rgba(2,7,18,.91) 28%,rgba(2,7,18,.56) 49%,rgba(2,7,18,.14) 75%,rgba(2,7,18,.08) 100%),linear-gradient(180deg,rgba(2,7,18,.1),rgba(2,7,18,.08) 70%,rgba(2,7,18,.8))}.hero7__inner{position:relative;z-index:2;min-height:calc(100svh - 5rem);display:flex;align-items:center;padding-block:clamp(4rem,8vh,7rem)}.hero7__copy{width:min(42rem,48vw);padding:1rem 0}.hero7__eyebrow{display:flex;align-items:center;gap:.75rem;color:#83a9ff;font-size:.7rem;letter-spacing:.17em;font-weight:700}.hero7__eyebrow span{width:1.65rem;height:1px;background:currentColor;box-shadow:0 0 14px currentColor}.hero7 h1{margin:1.15rem 0 0;max-width:11ch;font-family:var(--font-display);font-size:clamp(3.65rem,5.6vw,6.4rem);line-height:.93;letter-spacing:-.06em;font-weight:720}.hero7 h1 span{display:block;color:#fff;text-shadow:0 4px 28px rgba(0,0,0,.45)}.hero7 h1 em{display:block;margin-top:.14em;font-style:normal;background:linear-gradient(100deg,#8fb2ff 0%,#6f9eff 42%,#4fe0da 100%);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 8px 22px rgba(47,126,231,.2))}.hero7__copy>p{max-width:39rem;margin:1.5rem 0 0;color:#ced8e7;font-size:1.1rem;line-height:1.72;text-shadow:0 2px 12px rgba(0,0,0,.4)}.hero7__actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.65rem}.hero7__actions a{min-height:3.45rem;display:inline-flex;align-items:center;justify-content:center;padding:0 1.35rem;border-radius:.75rem;text-decoration:none;font-family:var(--font-display);font-weight:750}.hero7__primary{gap:.85rem;color:#06101a;background:linear-gradient(115deg,#8aafff,#48d7d4);box-shadow:0 18px 46px rgba(53,130,229,.27)}.hero7__secondary{color:#edf5ff;border:1px solid rgba(151,185,231,.32);background:rgba(5,14,29,.7);backdrop-filter:blur(12px)}.hero7__proof{display:flex;gap:.55rem;margin-top:1.2rem;flex-wrap:wrap}.hero7__proof>span{display:grid;grid-template-columns:auto auto;gap:.42rem;align-items:center;min-height:2.2rem;padding:0 .75rem;border-radius:.55rem;border:1px solid rgba(139,171,217,.18);background:rgba(7,17,33,.62);backdrop-filter:blur(10px)}.hero7__proof b{color:#f6f9fe;font-size:.74rem}.hero7__proof small{color:#7f95b4;font-size:.58rem;letter-spacing:.09em}.hero7__scroll{position:absolute;z-index:3;left:50%;bottom:1.25rem;transform:translateX(-50%);display:flex;align-items:center;gap:.6rem;color:#7891b4;text-decoration:none;font-size:.58rem;letter-spacing:.12em}.hero7__scroll span{color:#4fe0da;font-size:.9rem;animation:scrollHint 1.8s ease-in-out infinite}
  @keyframes scrollHint{50%{transform:translateY(5px)}}
  @media(max-width:1050px){.hero7__copy{width:min(39rem,58vw)}.hero7__shade{background:linear-gradient(90deg,rgba(2,7,18,.98) 0%,rgba(2,7,18,.87) 55%,rgba(2,7,18,.38) 100%)}}
  @media(max-width:760px){.hero7{min-height:48rem}.hero7__inner{min-height:48rem;align-items:flex-end;padding-bottom:5rem}.hero7__copy{width:100%}.hero7 h1{font-size:clamp(3.05rem,13vw,4.35rem)}.hero7__copy>p{font-size:1rem;max-width:31rem}.hero7__shade{background:linear-gradient(180deg,rgba(2,7,18,.42) 0%,rgba(2,7,18,.72) 38%,rgba(2,7,18,.98) 67%,#020712 100%)}.hero7__scroll{display:none}}
  @media(prefers-reduced-motion:reduce){.hero7__scroll span{animation:none}}
</style>
