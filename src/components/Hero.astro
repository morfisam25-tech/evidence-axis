---
import { cta } from '@config/site';
---
<section class="hero-v10" data-surface="dark" aria-labelledby="hero-v10-title">
  <div class="hero-v10__grid" aria-hidden="true"></div>
  <div class="hero-v10__glow" aria-hidden="true"></div>

  <div class="container-wide hero-v10__inner">
    <div class="hero-v10__copy">
      <div class="hero-v10__eyebrow mono"><span></span>INDEPENDENT COMPETITIVE INTELLIGENCE</div>
      <h1 id="hero-v10-title"><span>Find what your competitive view</span><em>is missing.</em></h1>
      <p class="hero-v10__lede">Evidence Axis discovers overlooked competitors, verifies what is actually happening, and turns the evidence into executive-ready decisions.</p>

      <div class="hero-v10__actions">
        <a class="hero-v10__primary" href={cta.primary.href}>{cta.primary.label}<span aria-hidden="true">→</span></a>
        <a class="hero-v10__secondary" href={cta.sample.href}>{cta.sample.label}</a>
        <a class="hero-v10__film" href="/method/"><span class="play" aria-hidden="true">↗</span> See the method</a>
      </div>

      <div class="hero-v10__proof mono" aria-label="Evidence Axis research standard">
        <span><b>SOURCE-VERIFIED</b><small>EVIDENCE</small></span>
        <span><b>HUMAN-REVIEWED</b><small>CLAIMS</small></span>
        <span><b>FACT · INFERENCE · UNKNOWN</b><small>SEPARATED</small></span>
      </div>
    </div>

    <div class="axis-stage" data-axis-stage aria-label="Interactive three-dimensional Evidence Axis model">
      <canvas class="axis-stage__canvas" data-axis-canvas aria-hidden="true"></canvas>
      <div class="axis-stage__fallback" aria-hidden="true"><div class="axis-stage__fallback-body"></div></div>

      <div class="axis-label mono">EVIDENCE AXIS</div>
      <a class="axis-state axis-state--fact" href="/method/#evidence-states"><span>FACT</span><b>verified</b></a>
      <a class="axis-state axis-state--inference" href="/method/#evidence-chain"><span>INFERENCE</span><b>reasoned</b></a>
      <a class="axis-state axis-state--unknown" href="/method/#limitations"><span>UNKNOWN</span><b>unresolved</b></a>

      <a class="axis-tag axis-tag--pricing" href="/#services"><small>SIGNAL</small><b>Competitor move</b><em>See engagements →</em></a>
      <a class="axis-tag axis-tag--docs" href="/method/#workflow"><small>SOURCE</small><b>Underlying evidence</b><em>See method →</em></a>
      <a class="axis-tag axis-tag--brief" href="/sample-report/"><small>OUTPUT</small><b>Intelligence brief</b><em>Open sample →</em></a>

      <div class="axis-stage__footer mono">DISCOVER · VERIFY · DECIDE · RESPOND</div>
      <div class="axis-stage__hint mono">MOVE POINTER · ROTATE MODEL · CLICK A CARD</div>
    </div>
  </div>

  <a class="hero-v10__scroll mono" href="#proof">SEE THE WORK <span>↓</span></a>
</section>

<script>import '../scripts/hero-v10';</script>

<style>
  .hero-v10{position:relative;overflow:hidden;min-height:calc(100svh - 4.15rem);background:#020713;color:#f4f8ff;isolation:isolate}
  .hero-v10__grid{position:absolute;inset:0;opacity:.18;background-image:linear-gradient(rgba(102,149,222,.11) 1px,transparent 1px),linear-gradient(90deg,rgba(102,149,222,.11) 1px,transparent 1px);background-size:68px 68px;mask-image:linear-gradient(90deg,transparent 0,#000 34%,#000 100%)}
  .hero-v10__glow{position:absolute;inset:-18% -12% -18% 34%;background:radial-gradient(circle at 58% 46%,rgba(54,129,255,.3),transparent 25%),radial-gradient(circle at 58% 49%,rgba(72,230,217,.15),transparent 44%);filter:blur(7px)}
  .hero-v10::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(2,7,18,.98) 0%,rgba(2,7,18,.86) 29%,rgba(2,7,18,.27) 56%,rgba(2,7,18,.03) 84%),linear-gradient(180deg,transparent 66%,rgba(2,7,18,.54));z-index:1}
  .hero-v10__inner{position:relative;z-index:2;min-height:calc(100svh - 4.15rem);display:grid;grid-template-columns:minmax(0,.82fr) minmax(34rem,1.18fr);gap:clamp(.7rem,2vw,2rem);align-items:center;padding-block:clamp(1.55rem,3.2vh,2.5rem) 2.8rem}
  .hero-v10__copy{position:relative;z-index:4;max-width:43rem}.hero-v10__eyebrow{display:flex;align-items:center;gap:.65rem;color:#86adff;font-size:.66rem;font-weight:800;letter-spacing:.17em}.hero-v10__eyebrow span{width:1.6rem;height:1px;background:currentColor;box-shadow:0 0 13px currentColor}
  .hero-v10 h1{margin:.85rem 0 0;max-width:9.4ch;font-family:var(--font-display);font-size:clamp(3.3rem,4.65vw,5.55rem);line-height:.92;letter-spacing:-.06em;font-weight:780}.hero-v10 h1 span{display:block;color:#fff;text-shadow:0 12px 36px rgba(0,0,0,.64)}.hero-v10 h1 em{display:block;margin-top:.1em;font-style:normal;background:linear-gradient(100deg,#9fbdff 0%,#70a0ff 46%,#54e0d8 100%);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 9px 24px rgba(68,141,247,.24))}
  .hero-v10__lede{max-width:38rem;margin:1rem 0 0;color:#d5dfed;font-family:var(--font-serif);font-size:1.01rem;line-height:1.58}.hero-v10__actions{display:flex;flex-wrap:wrap;gap:.58rem;margin-top:1.2rem}.hero-v10__actions a{display:inline-flex;align-items:center;justify-content:center;min-height:3rem;padding:0 .95rem;border-radius:.7rem;font-family:var(--font-display);font-size:.86rem;font-weight:800;text-decoration:none}.hero-v10__primary{gap:.65rem;background:linear-gradient(115deg,#8db1ff,#4edbd4);color:#06101a;box-shadow:0 16px 40px rgba(53,130,229,.24)}.hero-v10__film{gap:.48rem;border:1px solid rgba(95,221,213,.26);background:rgba(8,25,42,.74);color:#fff}.hero-v10__film .play{display:grid;place-items:center;width:1.35rem;height:1.35rem;border-radius:50%;background:#54dfd8;color:#06101a;font-size:.5rem}.hero-v10__secondary{border:1px solid rgba(151,185,231,.24);background:rgba(5,14,29,.52);color:#e9f2ff;backdrop-filter:blur(12px)}
  .hero-v10__proof{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.8rem}.hero-v10__proof>span{display:grid;grid-template-columns:auto auto;gap:.34rem;align-items:center;min-height:1.95rem;padding:0 .62rem;border-radius:.52rem;border:1px solid rgba(139,171,217,.19);background:rgba(7,17,33,.64);backdrop-filter:blur(10px)}.hero-v10__proof b{font-size:.65rem;color:#fff}.hero-v10__proof small{font-size:.5rem;color:#9baec8;letter-spacing:.08em}

  .axis-stage{--pointer-x:0px;--pointer-y:0px;position:relative;height:min(68vh,40rem);min-height:33.5rem;perspective:1750px;isolation:isolate;transform:translateX(.6rem)}
  .axis-stage::before{content:'';position:absolute;inset:5% 0;border-radius:50%;background:radial-gradient(ellipse at center,rgba(54,140,255,.25),rgba(55,218,207,.09) 36%,transparent 70%);filter:blur(22px);transform:translate(var(--pointer-x),var(--pointer-y));transition:transform .18s ease-out}
  .axis-stage__canvas{position:absolute;inset:-2%;width:104%;height:104%;z-index:2;filter:drop-shadow(0 30px 66px rgba(0,0,0,.46))}.axis-stage__fallback{position:absolute;z-index:1;left:50%;top:50%;width:55%;height:78%;transform:translate(-50%,-50%);border:1px solid rgba(104,154,230,.4);border-radius:44% / 8%;background:linear-gradient(90deg,rgba(44,111,197,.07),rgba(72,212,207,.11),rgba(44,111,197,.07));box-shadow:0 0 65px rgba(53,128,238,.16)}.axis-stage__fallback::before,.axis-stage__fallback::after{content:'';position:absolute;left:-1px;right:-1px;height:3.3rem;border:1px solid rgba(104,154,230,.55);border-radius:50%;background:radial-gradient(ellipse at center,rgba(74,220,211,.16),rgba(12,30,61,.7) 60%,rgba(3,9,20,.96))}.axis-stage__fallback::before{top:-1.65rem}.axis-stage__fallback::after{bottom:-1.65rem}.axis-stage--webgl .axis-stage__fallback{opacity:.12}.axis-stage__fallback-body{position:absolute;left:50%;top:6%;bottom:6%;width:3px;transform:translateX(-50%);background:linear-gradient(transparent,#52e4da,#75a5ff,#52e4da,transparent);box-shadow:0 0 28px rgba(82,228,218,.7)}
  .axis-label{position:absolute;z-index:5;left:50%;top:5%;transform:translateX(-50%) translate(var(--pointer-x),var(--pointer-y));color:#f2f7ff;font-size:.86rem;font-weight:900;letter-spacing:.18em;text-shadow:0 0 22px rgba(255,255,255,.28);white-space:nowrap}
  .axis-state{position:absolute;z-index:5;left:50%;width:13.6rem;min-height:3.65rem;transform:translateX(-50%);display:flex;align-items:center;justify-content:center;gap:.62rem;border-radius:999px;background:rgba(3,11,24,.8);backdrop-filter:blur(12px);font-family:var(--font-mono);font-weight:900;letter-spacing:.11em;box-shadow:0 14px 38px rgba(0,0,0,.22);text-decoration:none;cursor:pointer;transition:transform .18s ease,filter .18s ease,box-shadow .18s ease}.axis-state::before{content:'';position:absolute;inset:0;border:1.2px solid currentColor;border-radius:999px;opacity:.82}.axis-state span,.axis-state b{position:relative}.axis-state span{font-size:.8rem}.axis-state b{font-family:var(--font-display);font-size:.8rem;letter-spacing:0;text-transform:none;color:#eef5ff}.axis-state--fact{top:20%;color:#55e1d9}.axis-state--inference{top:46%;color:#f0aa49}.axis-state--unknown{top:72%;color:#ad84ff}.axis-state:hover,.axis-state:focus-visible{filter:brightness(1.16);box-shadow:0 18px 46px rgba(0,0,0,.32),0 0 0 1px currentColor inset;transform:translateX(-50%) translateY(-3px);outline:none}
  .axis-tag{position:absolute;z-index:7;min-width:11.5rem;padding:.78rem .85rem;border-radius:.8rem;border:1px solid rgba(133,174,230,.28);background:rgba(5,15,31,.92);backdrop-filter:blur(14px);box-shadow:0 18px 42px rgba(0,0,0,.3);transition:transform .18s ease-out,border-color .18s ease,box-shadow .18s ease;text-decoration:none}.axis-tag:hover,.axis-tag:focus-visible{border-color:#5be1d9;box-shadow:0 18px 50px rgba(44,189,205,.23);outline:none}.axis-tag small{display:block;margin-bottom:.28rem;font:850 .52rem/1 var(--font-mono);letter-spacing:.12em;color:#7794ba}.axis-tag b{display:block;font:800 .94rem/1.08 var(--font-display);color:#f3f7ff}.axis-tag em{display:block;margin-top:.34rem;font:700 .62rem/1 var(--font-display);font-style:normal;color:#94aac7}.axis-tag--pricing{left:0;top:28%;transform:translate(calc(var(--pointer-x) * -.65),calc(var(--pointer-y) * -.55)) rotate(-3deg);border-color:rgba(85,225,217,.38)}.axis-tag--docs{right:-1%;top:44%;transform:translate(calc(var(--pointer-x) * .7),calc(var(--pointer-y) * .55)) rotate(3deg);border-color:rgba(240,170,73,.4)}.axis-tag--brief{right:4%;bottom:10%;transform:translate(calc(var(--pointer-x) * .45),calc(var(--pointer-y) * .35)) rotate(-1deg);border-color:rgba(173,132,255,.42)}
  .axis-stage__footer{position:absolute;z-index:5;left:50%;bottom:4.3%;transform:translateX(-50%);color:#a5b8d1;font-size:.58rem;font-weight:800;letter-spacing:.12em;white-space:nowrap}.axis-stage__hint{position:absolute;z-index:5;left:50%;bottom:-.4%;transform:translateX(-50%);color:#607b9e;font-size:.48rem;letter-spacing:.11em;white-space:nowrap}.hero-v10__scroll{position:absolute;z-index:4;left:50%;bottom:.65rem;transform:translateX(-50%);display:flex;align-items:center;gap:.5rem;color:#8299ba;text-decoration:none;font-size:.54rem;letter-spacing:.12em}.hero-v10__scroll span{color:#55e1d9;font-size:.82rem;animation:v10hint 1.7s ease-in-out infinite}@keyframes v10hint{50%{transform:translateY(4px)}}
  @media(max-width:1120px){.hero-v10{min-height:auto}.hero-v10__inner{min-height:auto;grid-template-columns:1fr;padding-block:3rem 4rem}.hero-v10__copy{max-width:50rem}.axis-stage{height:35rem;min-height:35rem;transform:none}.hero-v10::after{background:linear-gradient(180deg,rgba(2,7,18,.2),rgba(2,7,18,.56) 45%,rgba(2,7,18,.94) 100%)}.hero-v10__scroll{display:none}}
  @media(max-width:720px){.hero-v10__inner{padding-block:2.7rem 3rem}.hero-v10 h1{font-size:clamp(3.05rem,12vw,4.35rem)}.hero-v10__lede{font-size:.98rem}.hero-v10__actions{display:grid}.hero-v10__actions a{width:100%}.axis-stage{height:29rem;min-height:29rem}.axis-state{width:10.5rem;min-height:2.8rem}.axis-state span,.axis-state b{font-size:.62rem}.axis-tag{min-width:8.7rem;padding:.62rem .68rem}.axis-tag b{font-size:.75rem}.axis-tag em{font-size:.54rem}.axis-tag--pricing{left:0}.axis-tag--docs{right:0}.axis-tag--brief{right:1%}.axis-label{font-size:.68rem}.axis-stage__footer{font-size:.46rem}.axis-stage__hint{display:none}}
  @media(prefers-reduced-motion:reduce){.hero-v10__scroll span{animation:none}.axis-tag,.axis-state{transition:none}}
</style>
