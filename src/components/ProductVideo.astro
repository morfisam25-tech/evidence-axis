---
import ProductFilm from './ProductFilm.astro';
import { heroVideoData } from '@data/heroVideo';
---
<div class="product-video" data-product-video aria-hidden="true">
  <div class="product-video__fallback"><ProductFilm /></div>

  <div class="product-video__screen">
    <div class="product-video__chrome">
      <span class="product-video__dots"><i></i><i></i><i></i></span>
      <b>EVIDENCE AXIS / DECISION WORKSPACE</b>
      <span>LIVE PRODUCT FILM</span>
    </div>
    <video
      class="product-video__media"
      data-product-video-media
      src={heroVideoData}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      tabindex="-1"
    ></video>
    <div class="product-video__glass" aria-hidden="true"></div>
    <div class="product-video__rail product-video__rail--top"><span>PUBLIC SOURCES</span><i></i><span>CLASSIFY</span><i></i><span>DECIDE</span></div>
    <div class="product-video__rail product-video__rail--bottom"><span class="live-dot"></span><b>SOURCE-CHECKED COMPETITOR EVIDENCE</b><em>LOOP / 06 SEC</em></div>
  </div>

  <div class="product-video__float product-video__float--fact"><small>FACT</small><strong>Source verified</strong></div>
  <div class="product-video__float product-video__float--unknown"><small>UNKNOWN</small><strong>Certainty ends here</strong></div>
  <div class="product-video__float product-video__float--move"><small>OUTPUT</small><strong>Decision-ready brief →</strong></div>
</div>

<script>
  const root = document.querySelector('[data-product-video]');
  const video = root?.querySelector('[data-product-video-media]');
  if (video instanceof HTMLVideoElement) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let visible = true;
    const sync = () => {
      if (reduced.matches || document.hidden || !visible) video.pause();
      else video.play().catch(() => {});
    };
    const observer = new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting);
      sync();
    }, { threshold: 0.05 });
    observer.observe(root);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener?.('change', sync);
    video.addEventListener('loadeddata', () => root.classList.add('is-video-ready'), { once: true });
    sync();
  }
</script>

<style>
  .product-video{position:absolute;inset:0;overflow:hidden;isolation:isolate;background:#020713}.product-video__fallback{position:absolute;inset:0;opacity:.22;filter:saturate(.9) contrast(1.05);transition:opacity .45s ease}.product-video.is-video-ready .product-video__fallback{opacity:.09}.product-video__screen{position:absolute;right:clamp(-5.5rem,-3.5vw,-1.5rem);top:50%;width:min(64vw,69rem);aspect-ratio:16/9;transform:translateY(-50%) perspective(1600px) rotateY(-5deg) rotateX(1.2deg);transform-origin:center;border:1px solid rgba(125,164,225,.34);border-radius:1.55rem;overflow:hidden;background:#061120;box-shadow:0 50px 120px rgba(0,0,0,.54),0 0 140px rgba(47,111,240,.18);z-index:2}.product-video__chrome{height:3rem;position:absolute;inset:0 0 auto;z-index:5;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 1rem;background:rgba(3,10,22,.88);border-bottom:1px solid rgba(139,171,219,.16);backdrop-filter:blur(14px);font:700 .6rem/1 var(--font-mono);letter-spacing:.09em;color:#8399b8}.product-video__chrome b{justify-self:center;color:#e3edf9}.product-video__chrome>span:last-child{justify-self:end;color:#59ded7}.product-video__dots{display:flex;gap:.35rem}.product-video__dots i{width:.45rem;height:.45rem;border-radius:50%;background:#3e516e}.product-video__dots i:first-child{background:#f26f58}.product-video__dots i:nth-child(2){background:#f2b94c}.product-video__dots i:nth-child(3){background:#48d8b5}.product-video__media{position:absolute;inset:3rem 0 0;width:100%;height:calc(100% - 3rem);object-fit:cover;display:block;background:#020713;filter:saturate(1.08) contrast(1.06);transform:scale(1.005)}.product-video__glass{position:absolute;inset:3rem 0 0;z-index:3;pointer-events:none;background:linear-gradient(115deg,rgba(255,255,255,.035),transparent 28%,transparent 70%,rgba(91,156,255,.035));box-shadow:inset 0 0 70px rgba(94,159,255,.08)}.product-video__rail{position:absolute;z-index:6;display:flex;align-items:center;font:700 .56rem/1 var(--font-mono);letter-spacing:.09em;color:#9bb0cc;text-transform:uppercase}.product-video__rail--top{top:4rem;left:1.15rem;gap:.55rem;padding:.48rem .6rem;border-radius:.5rem;background:rgba(2,10,22,.66);border:1px solid rgba(113,159,225,.14);backdrop-filter:blur(10px)}.product-video__rail--top i{width:1.4rem;height:1px;background:linear-gradient(90deg,#5d8eef,#47dcd4)}.product-video__rail--bottom{left:1.15rem;right:1.15rem;bottom:1rem;justify-content:flex-start;gap:.55rem;padding:.55rem .7rem;border-radius:.55rem;background:rgba(2,9,20,.78);border:1px solid rgba(113,159,225,.13);backdrop-filter:blur(12px)}.product-video__rail--bottom b{color:#dfe9f8}.product-video__rail--bottom em{margin-left:auto;font-style:normal;color:#6e87aa}.live-dot{width:.45rem;height:.45rem;border-radius:50%;background:#48e0d6;box-shadow:0 0 13px #48e0d6;animation:livePulse 1.6s ease-in-out infinite}.product-video__float{position:absolute;z-index:7;min-width:10.5rem;padding:.78rem .9rem;border-radius:.7rem;background:rgba(6,17,34,.82);backdrop-filter:blur(14px);border:1px solid rgba(135,170,222,.16);box-shadow:0 18px 45px rgba(0,0,0,.28);animation:floatY 5s ease-in-out infinite}.product-video__float small{display:block;font:800 .57rem/1 var(--font-mono);letter-spacing:.1em}.product-video__float strong{display:block;margin-top:.35rem;color:#eef5ff;font:700 .78rem/1.15 var(--font-display)}.product-video__float--fact{right:57%;top:25%;border-color:rgba(72,224,214,.3);animation-delay:-1s}.product-video__float--fact small{color:#48e0d6}.product-video__float--unknown{right:6%;top:22%;border-color:rgba(165,113,255,.3);animation-delay:-2.6s}.product-video__float--unknown small{color:#bc98ff}.product-video__float--move{right:7%;bottom:15%;border-color:rgba(255,161,72,.3);animation-delay:-3.8s}.product-video__float--move small{color:#ffad58}@keyframes floatY{50%{transform:translateY(-9px)}}@keyframes livePulse{50%{opacity:.35;transform:scale(.75)}}
  @media(max-width:1100px){.product-video__screen{width:72vw;right:-18vw}.product-video__float--fact{right:54%}.product-video__float--unknown{right:2%}.product-video__float--move{right:2%}}
  @media(max-width:760px){.product-video__screen{width:108vw;right:-55vw;top:31%;opacity:.82;transform:translateY(-50%) perspective(1100px) rotateY(-4deg) scale(.92)}.product-video__float{display:none}.product-video__rail--bottom em{display:none}.product-video__chrome b{font-size:.54rem}.product-video__chrome>span:last-child{display:none}}
  @media(prefers-reduced-motion:reduce){.product-video__float,.live-dot{animation:none}.product-video__media{opacity:.72}}
</style>
