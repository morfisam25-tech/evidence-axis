---
import { site, legal } from '@config/site';

interface Props {
  title: string;
  description: string;
  /** page path for canonical, e.g. "/method/" */
  path?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const {
  title,
  description,
  path = '/',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og-image.png', site.url).href;
const fullTitle = title === site.name ? `${site.name} — ${site.category}` : `${title} · ${site.name}`;
const founderUrl = new URL('/author/sai-morfi/', site.url).href;

// Organization structured data — only truthfully supportable fields.
// No ratings, no reviews, no employee counts, no unverified claims.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  description: site.description,
  logo: new URL('/favicon.svg', site.url).href,
  slogan: site.tagline,
  founder: {
    '@type': 'Person',
    name: legal.publicOperator,
    url: founderUrl,
  },
};

const serviceTypes: Record<string, string> = {
  '/competitive-intelligence/': 'Competitive intelligence for B2B SaaS',
  '/competitor-analysis/': 'Competitor analysis for B2B SaaS',
  '/decision-brief/': 'Competitive decision brief',
  '/competitor-brief/': 'Competitive decision sprint',
  '/strategic-blueprint/': 'Competitive response sprint',
  '/market-intelligence/': 'Competitive monitoring and intelligence',
};

const serviceLd = serviceTypes[path]
  ? {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: title,
      serviceType: serviceTypes[path],
      description,
      url: canonical,
      provider: {
        '@type': 'Organization',
        name: site.name,
        url: site.url,
      },
      areaServed: 'Worldwide',
      audience: {
        '@type': 'BusinessAudience',
        audienceType: 'B2B SaaS teams and decision-makers',
      },
    }
  : null;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#14171c" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
{serviceLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceLd)} />}
