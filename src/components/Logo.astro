---
/**
 * Evidence Axis wordmark + mark.
 * The mark is the identity: evidence fragments (Fact / Inference / Unknown)
 * aligning onto a single vertical axis. Uses currentColor for the wordmark
 * so it inherits surface color; mark accents are fixed brand values but
 * dim gracefully in monochrome contexts via the `mono` prop.
 */
interface Props {
  showWord?: boolean;
  mono?: boolean;
  class?: string;
  size?: number;
}
const { showWord = true, mono = false, class: className = '', size = 26 } = Astro.props;
const fact = mono ? 'currentColor' : '#2f8067';
const infer = mono ? 'currentColor' : '#a9682a';
const unknown = mono ? 'currentColor' : 'currentColor';
const axis = mono ? 'currentColor' : 'var(--accent)';
---
<a href="/" class:list={['logo', className]} aria-label="Evidence Axis — home">
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <line x1="21" y1="4" x2="21" y2="28" stroke={axis} stroke-width="1.5" />
    <line x1="8" y1="9" x2="21" y2="9" stroke={fact} stroke-width="1.6" opacity={mono ? 0.9 : 1} />
    <circle cx="21" cy="9" r="2.5" fill={fact} />
    <line x1="10" y1="16" x2="21" y2="16" stroke={infer} stroke-width="1.6" stroke-dasharray="2.2 2" opacity={mono ? 0.75 : 1} />
    <circle cx="21" cy="16" r="2.5" fill="none" stroke={infer} stroke-width="1.5" />
    <path d="M21 13.6 A2.5 2.5 0 0 1 21 18.5 Z" fill={infer} />
    <line x1="12" y1="23" x2="21" y2="23" stroke={unknown} stroke-width="1.5" stroke-dasharray="1 2.6" opacity="0.6" />
    <circle cx="21" cy="23" r="2.3" fill="none" stroke={unknown} stroke-width="1.4" opacity="0.7" />
  </svg>
  {showWord && (
    <span class="logo-word">
      <span class="logo-word-a">Evidence</span>
      <span class="logo-word-b">Axis</span>
    </span>
  )}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    text-decoration: none;
    color: var(--text);
  }
  .logo-mark { flex: none; overflow: visible; }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
    line-height: 1;
    display: inline-flex;
    gap: 0.4ch;
  }
  .logo-word-a { color: var(--text); }
  .logo-word-b { color: var(--accent); }
  .logo:hover .logo-word-b { color: var(--accent-hover); }
</style>
