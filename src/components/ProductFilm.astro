<div class="film" aria-hidden="true">
  <div class="film__glow film__glow--a"></div>
  <div class="film__glow film__glow--b"></div>
  <div class="film__grid"></div>

  <div class="film__window">
    <div class="film__chrome">
      <span class="film__dots"><i></i><i></i><i></i></span>
      <b>EVIDENCE AXIS / LIVE WORKSPACE</b>
      <span>PUBLIC · CHECKED · DATED</span>
    </div>

    <div class="film__stage">
      <section class="film-scene film-scene--sources">
        <div class="source source--1"><small>SOURCE</small><strong>Pricing page</strong><span>plans · add-ons</span></div>
        <div class="source source--2"><small>SOURCE</small><strong>Documentation</strong><span>capabilities · limits</span></div>
        <div class="source source--3"><small>SOURCE</small><strong>Changelog</strong><span>release evidence</span></div>
        <div class="source source--4"><small>SIGNAL</small><strong>Reviews</strong><span>context · not proof</span></div>
        <div class="intake"><span></span><b>Evidence field</b><i></i></div>
      </section>

      <section class="film-scene film-scene--matrix">
        <div class="matrix__title"><small>DECISION QUESTION</small><strong>Which platform gives this team the stronger AI-support economics?</strong></div>
        <div class="matrix">
          <div class="matrix__head"><span>CLAIM</span><span>STATE</span><span>SOURCE</span><span>USE</span></div>
          <div class="matrix__row"><b>AI resolution pricing</b><em class="state state--fact">FACT</em><span>Official pricing</span><span>Cost mechanic</span></div>
          <div class="matrix__row"><b>Packaging trade-off</b><em class="state state--infer">INFERENCE</em><span>Pricing + docs</span><span>Plan choice</span></div>
          <div class="matrix__row"><b>Team-specific AI cost</b><em class="state state--unknown">UNKNOWN</em><span>Not public</span><span>Ask before buy</span></div>
          <div class="matrix__row"><b>Enterprise flexibility</b><em class="state state--fact">FACT</em><span>Official page</span><span>Scope check</span></div>
        </div>
      </section>

      <section class="film-scene film-scene--decision">
        <div class="mini-chart">
          <div class="mini-chart__head"><span>PUBLIC LIST PRICE</span><b>Evidence view</b></div>
          <div class="bars"><i style="--h:48%"></i><i style="--h:72%"></i><i style="--h:58%"></i><i style="--h:86%"></i><i style="--h:66%"></i></div>
          <div class="mini-chart__axis"><span>Plan</span><span>AI</span><span>Usage</span><span>Scope</span></div>
        </div>
        <div class="decision-card">
          <div class="decision-card__top"><small>DECISION OUTPUT</small><b>READY</b></div>
          <h3>Decision-Ready Brief</h3>
          <p>Evidence separated from judgment. Unknowns kept visible.</p>
          <div class="decision-card__states"><span class="fact-dot">Fact</span><span class="infer-dot">Inference</span><span class="unknown-dot">Unknown</span></div>
          <footer>SOURCE → OBSERVATION → FACT → INFERENCE → MOVE</footer>
        </div>
      </section>
    </div>
  </div>

  <div class="film__caption"><span class="pulse"></span> Evidence in → decision out</div>
</div>

<style>
  .film{--cyan:#42e0d5;--blue:#719aff;--amber:#ff9f43;--violet:#a36dff;position:absolute;inset:0;overflow:hidden;background:#020813;isolation:isolate}.film__grid{position:absolute;inset:0;background-image:linear-gradient(rgba(111,154,221,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(111,154,221,.05) 1px,transparent 1px);background-size:64px 64px;mask-image:linear-gradient(90deg,transparent 0,#000 28%,#000 100%)}.film__glow{position:absolute;border-radius:50%;filter:blur(80px);opacity:.8}.film__glow--a{width:45rem;height:45rem;right:-9rem;top:-10rem;background:rgba(39,101,240,.35);animation:glowA 11s ease-in-out infinite}.film__glow--b{width:28rem;height:28rem;right:20%;bottom:-12rem;background:rgba(24,205,191,.22);animation:glowB 8s ease-in-out infinite}.film__window{position:absolute;right:clamp(-8rem,-4vw,-2rem);top:50%;width:min(68vw,66rem);height:min(67vh,43rem);transform:translateY(-50%) perspective(1400px) rotateY(-5deg) rotateX(1deg);transform-origin:center;overflow:hidden;border:1px solid rgba(113,157,255,.28);border-radius:1.5rem;background:linear-gradient(145deg,rgba(8,21,42,.92),rgba(3,10,22,.97));box-shadow:0 45px 110px rgba(0,0,0,.48),0 0 120px rgba(46,103,227,.15);backdrop-filter:blur(8px)}.film__chrome{height:3.25rem;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 1rem;border-bottom:1px solid rgba(132,164,211,.13);background:rgba(255,255,255,.025);font-family:var(--font-mono);font-size:.63rem;letter-spacing:.08em;color:#8fa7c9}.film__chrome b{justify-self:center;color:#d9e6f7}.film__chrome>span:last-child{justify-self:end}.film__dots{display:flex;gap:.35rem}.film__dots i{width:.45rem;height:.45rem;border-radius:50%;background:#304462}.film__dots i:nth-child(1){background:#ff765f}.film__dots i:nth-child(2){background:#f5bd4f}.film__dots i:nth-child(3){background:#49d7b5}.film__stage{position:relative;height:calc(100% - 3.25rem);overflow:hidden}.film-scene{position:absolute;inset:0;padding:clamp(1.5rem,3vw,3rem);opacity:0;animation:scene 12s linear infinite}.film-scene--sources{animation-delay:0s}.film-scene--matrix{animation-delay:4s}.film-scene--decision{animation-delay:8s}.source{position:absolute;width:13rem;padding:1rem;border-radius:.8rem;background:rgba(7,18,36,.93);border:1px solid rgba(111,154,255,.22);box-shadow:0 20px 60px rgba(0,0,0,.28);animation:sourceFloat 4s ease-in-out infinite}.source small{display:block;color:var(--cyan);font:700 .63rem/1 var(--font-mono);letter-spacing:.12em}.source strong{display:block;margin-top:.4rem;color:#f4f8ff;font:700 1.05rem/1.1 var(--font-display)}.source span{display:block;margin-top:.3rem;color:#8297b5;font-size:.75rem}.source--1{left:8%;top:18%;--dx:15rem;--dy:8rem}.source--2{right:8%;top:16%;--dx:-13rem;--dy:10rem}.source--3{left:12%;bottom:13%;--dx:13rem;--dy:-8rem}.source--4{right:10%;bottom:12%;--dx:-12rem;--dy:-7rem}.intake{position:absolute;left:50%;top:50%;width:14rem;height:14rem;transform:translate(-50%,-50%);display:grid;place-items:center;border:1px solid rgba(86,183,235,.22);border-radius:50%;box-shadow:0 0 80px rgba(63,146,245,.18),inset 0 0 70px rgba(64,186,211,.08)}.intake::before,.intake::after{content:'';position:absolute;border-radius:50%;border:1px dashed rgba(90,151,230,.23);inset:1.6rem;animation:spin 9s linear infinite}.intake::after{inset:3.3rem;border-color:rgba(66,224,213,.36);animation-direction:reverse;animation-duration:6s}.intake span{position:absolute;width:2px;height:80%;background:linear-gradient(transparent,#7ed7ff,#42e0d5,transparent);box-shadow:0 0 24px #55c6ff}.intake b{z-index:2;padding:.4rem .65rem;border-radius:99px;background:#081a2f;color:#dceaff;font:700 .68rem/1 var(--font-mono);letter-spacing:.08em}.intake i{position:absolute;width:.55rem;height:.55rem;border-radius:50%;background:var(--cyan);box-shadow:0 0 18px var(--cyan);animation:orbit 4s linear infinite}.matrix__title small{display:block;color:var(--cyan);font:700 .64rem/1 var(--font-mono);letter-spacing:.12em}.matrix__title strong{display:block;max-width:38rem;margin-top:.45rem;color:#f7f9fd;font:700 clamp(1.3rem,2vw,2rem)/1.12 var(--font-display)}.matrix{margin-top:2rem;border:1px solid rgba(122,158,210,.16);border-radius:1rem;overflow:hidden;background:rgba(3,11,24,.74)}.matrix__head,.matrix__row{display:grid;grid-template-columns:1.5fr .75fr 1fr .85fr;gap:.7rem;align-items:center;padding:.8rem 1rem}.matrix__head{background:rgba(255,255,255,.03);color:#7f96b7;font:700 .62rem/1 var(--font-mono);letter-spacing:.1em}.matrix__row{min-height:4.1rem;border-top:1px solid rgba(125,156,201,.09);color:#afbed2;font-size:.8rem}.matrix__row b{color:#edf3fb;font-size:.9rem}.state{justify-self:start;padding:.35rem .55rem;border-radius:99px;font:700 .57rem/1 var(--font-mono);font-style:normal;letter-spacing:.08em}.state--fact{color:var(--cyan);background:rgba(66,224,213,.08);border:1px solid rgba(66,224,213,.26)}.state--infer{color:var(--amber);background:rgba(255,159,67,.08);border:1px solid rgba(255,159,67,.25)}.state--unknown{color:#c39eff;background:rgba(163,109,255,.08);border:1px solid rgba(163,109,255,.25)}.film-scene--decision{display:grid;grid-template-columns:.95fr 1.05fr;gap:1.5rem;align-items:center}.mini-chart,.decision-card{border-radius:1rem;background:linear-gradient(145deg,rgba(11,31,56,.9),rgba(4,13,27,.95));border:1px solid rgba(108,153,219,.18);box-shadow:0 24px 70px rgba(0,0,0,.3)}.mini-chart{padding:1.2rem;min-height:18rem}.mini-chart__head{display:flex;justify-content:space-between;color:#829abb;font:700 .62rem/1 var(--font-mono);letter-spacing:.08em}.mini-chart__head b{color:#e6eef9}.bars{height:12rem;margin:1.3rem 1rem .4rem;display:flex;align-items:end;gap:1rem;border-bottom:1px solid rgba(116,151,204,.18)}.bars i{flex:1;height:var(--h);border-radius:.4rem .4rem 0 0;background:linear-gradient(180deg,#6f98ff,#1c6d93);box-shadow:0 0 25px rgba(77,137,255,.18);animation:barPulse 3.2s ease-in-out infinite}.bars i:nth-child(2n){background:linear-gradient(180deg,#45ddd3,#177c7d)}.mini-chart__axis{display:flex;justify-content:space-around;color:#657b9b;font:600 .58rem/1 var(--font-mono)}.decision-card{padding:1.4rem}.decision-card__top{display:flex;justify-content:space-between;color:#7e99c0;font:700 .62rem/1 var(--font-mono);letter-spacing:.08em}.decision-card__top b{color:var(--cyan)}.decision-card h3{margin:1.2rem 0 0;color:white;font:700 clamp(1.65rem,2.4vw,2.5rem)/1 var(--font-display)}.decision-card p{max-width:27rem;color:#9fb0c7;line-height:1.55}.decision-card__states{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.35rem}.decision-card__states span{padding:.5rem .7rem;border-radius:99px;font:700 .65rem/1 var(--font-mono)}.fact-dot{color:var(--cyan);background:rgba(66,224,213,.09)}.infer-dot{color:var(--amber);background:rgba(255,159,67,.09)}.unknown-dot{color:#bf98ff;background:rgba(163,109,255,.09)}.decision-card footer{margin-top:1.5rem;padding-top:1rem;border-top:1px solid rgba(124,154,201,.12);color:#7189ab;font:700 .58rem/1.4 var(--font-mono);letter-spacing:.07em}.film__caption{position:absolute;right:2.2rem;bottom:1.6rem;display:flex;align-items:center;gap:.55rem;color:#9eb3d1;font:700 .62rem/1 var(--font-mono);letter-spacing:.1em;text-transform:uppercase}.pulse{width:.45rem;height:.45rem;border-radius:50%;background:var(--cyan);box-shadow:0 0 14px var(--cyan);animation:pulse 1.6s ease-in-out infinite}
  @keyframes scene{0%,28%{opacity:1;transform:scale(1)}33%,100%{opacity:0;transform:scale(1.025)}}@keyframes sourceFloat{0%{transform:translate(0,0)}70%,100%{transform:translate(var(--dx),var(--dy));opacity:.25}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes orbit{0%{transform:rotate(0deg) translateX(5.7rem)}100%{transform:rotate(360deg) translateX(5.7rem)}}@keyframes barPulse{50%{filter:brightness(1.25);transform:translateY(-4px)}}@keyframes pulse{50%{opacity:.35;transform:scale(.72)}}@keyframes glowA{50%{transform:translate(-6rem,4rem) scale(1.1)}}@keyframes glowB{50%{transform:translate(3rem,-3rem) scale(.9)}}
  @media(max-width:1100px){.film__window{width:76vw;right:-18vw;opacity:.86}.film__caption{display:none}}@media(max-width:760px){.film__window{width:95vw;right:-45vw;height:70%;opacity:.72;transform:translateY(-50%) scale(.92)}.film-scene--decision{grid-template-columns:1fr}.mini-chart{display:none}.matrix__head,.matrix__row{grid-template-columns:1.25fr .75fr}.matrix__head span:nth-child(n+3),.matrix__row span{display:none}}@media(prefers-reduced-motion:reduce){.film-scene{animation:none}.film-scene--matrix,.film-scene--decision{display:none}.source,.intake::before,.intake::after,.intake i,.bars i,.pulse,.film__glow{animation:none}}
</style>
