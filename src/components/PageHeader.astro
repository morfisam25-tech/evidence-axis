---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  meta?: string[];
}
const { eyebrow, title, lede, meta } = Astro.props;
---
<header class="page-header" data-surface="dark">
  <div class="container-wide page-header__inner axis-frame">
    <span class="label eyebrow">{eyebrow}</span>
    <h1 class="page-header__title">{title}</h1>
    {lede && <p class="page-header__lede">{lede}</p>}
    {meta && (
      <ul class="page-header__meta">
        {meta.map((m) => <li class="mono">{m}</li>)}
      </ul>
    )}
  </div>
</header>

<style>
  .page-header { background:#030914;color:#f4f8ff;padding-block:clamp(2.25rem,4.5vw,4rem) clamp(2rem,3.8vw,3.2rem);border-bottom:1px solid rgba(126,167,219,.16); }
  .page-header__inner { max-width:68rem; }
  .page-header :global(.label){color:#69dfd9}
  .page-header__title { font-size:clamp(2.75rem,5.4vw,5.45rem);line-height:.95;letter-spacing:-.052em;margin:.58rem 0 0;max-width:16ch;color:#f7fbff; }
  .page-header__lede { margin:.85rem 0 0;font-size:clamp(1rem,1.6vw,1.12rem);line-height:1.62;color:#c5d3e4;max-width:58ch; }
  .page-header__meta { list-style:none;padding:0;margin:.95rem 0 0;display:flex;flex-wrap:wrap;gap:.5rem 1.1rem; }
  .page-header__meta li { font-size:.64rem;color:#8fa5c0;padding-left:.9rem;position:relative;letter-spacing:.06em; }
  .page-header__meta li::before { content:'';position:absolute;left:0;top:.42em;width:.4rem;height:.4rem;border-radius:50%;background:#5be1d9; }
  @media(max-width:600px){.page-header__title{font-size:clamp(2.6rem,11vw,3.8rem)}.page-header{padding-block:2.4rem 2.2rem}}
</style>
