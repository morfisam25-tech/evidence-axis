---
// Self-hosted open fonts (no commercial license required).
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/site-final.css';

import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, path, ogType, noindex } = Astro.props;
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <BaseHead title={title} description={description} path={path} ogType={ogType} noindex={noindex} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const header = document.querySelector('[data-header]');
      const onScroll = () => {
        if (!header) return;
        if (window.scrollY > 8) header.setAttribute('data-scrolled', '');
        else header.removeAttribute('data-scrolled');
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
      }

      const toggle = document.querySelector('[data-nav-toggle]') as HTMLButtonElement | null;
      const panel = document.querySelector('[data-mobile-nav]') as HTMLElement | null;
      const backgrounds = [
        document.getElementById('main'),
        document.querySelector('.site-footer'),
      ].filter(Boolean) as HTMLElement[];

      if (toggle && panel) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          panel.hidden = !open;
          document.body.style.overflow = open ? 'hidden' : '';
          backgrounds.forEach((el) => { el.inert = open; });
          if (open) {
            const first = panel.querySelector<HTMLElement>('a, button');
            first?.focus();
          }
        };
        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        panel.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => {
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', 'Open menu');
            panel.hidden = true;
            document.body.style.overflow = '';
            backgrounds.forEach((el) => { el.inert = false; });
          })
        );
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });
        const mq = window.matchMedia('(min-width: 64rem)');
        mq.addEventListener('change', (e) => { if (e.matches && toggle.getAttribute('aria-expanded') === 'true') setOpen(false); });
      }
    </script>

    <script is:inline>
      (() => {
        const path = window.location.pathname;
        const setSrc = (selector, src) => {
          const el = document.querySelector(selector);
          if (el && el.tagName === 'IMG') el.setAttribute('src', src);
        };
        const setMany = (selector, srcs) => {
          document.querySelectorAll(selector).forEach((el, i) => {
            if (el.tagName === 'IMG' && srcs[i]) el.setAttribute('src', srcs[i]);
          });
        };

        if (path === '/') {
          const player = document.querySelector('.film-v10__player--real-video');
          const frame = player?.querySelector('.film-v10__frame');
          const oldIframe = player?.querySelector('iframe');
          if (oldIframe) {
            const video = document.createElement('video');
            video.className = 'film-v10__native-video';
            video.autoplay = true;
            video.muted = true;
            video.loop = true;
            video.playsInline = true;
            video.preload = 'auto';
            video.setAttribute('aria-label', 'Evidence Axis system film');
            video.innerHTML = '<source src="/assets/v10/approved/system-film.mp4" type="video/mp4">';
            oldIframe.replaceWith(video);
            video.play().catch(() => {});
          }

          setMany('.gallery-v10__mosaic img', [
            '/assets/v10/command-center-approved.svg',
            '/assets/v10/global-signal.svg',
            '/assets/v10/decision-brief.svg',
            '/assets/v10/decision-room.svg'
          ]);

          setMany('.outputs-v10__gallery img', [
            '/assets/v10/evidence-matrix.svg',
            '/assets/v10/decision-room.svg',
            '/assets/v10/decision-brief.svg',
            '/assets/v10/ai-comparison.svg',
            '/assets/v10/command-center-approved.svg',
            '/assets/v10/global-signal.svg'
          ]);

          setSrc('.ai-v10__visual img', '/assets/v10/ai-comparison.svg');
          setSrc('.world-v10__visual img', '/assets/v10/global-signal.svg');
          setSrc('.v10-media--sample img', '/assets/v10/decision-brief.svg');
          setSrc('.final-v10 img', '/assets/v10/decision-room.svg');
        }

        const internal = {
          '/competitor-brief/': ['/assets/v10/decision-brief.svg', 'Two-competitor decision brief'],
          '/market-intelligence/': ['/assets/v10/global-signal.svg', 'Market intelligence signals'],
          '/method/': ['/assets/v10/evidence-matrix.svg', 'Evidence Axis research workflow'],
          '/strategic-blueprint/': ['/assets/v10/decision-room.svg', 'Strategic market blueprint'],
          '/sample-report/': ['/assets/v10/decision-brief.svg', 'Evidence Axis sample report'],
          '/about/': ['/assets/v10/ai-comparison.svg', 'Evidence Axis versus generic AI'],
          '/contact/': ['/assets/v10/command-center-approved.svg', 'Decision-ready Evidence Axis output']
        };

        const config = internal[path];
        if (config) {
          const [src, alt] = config;
          const existing = document.querySelector('main img[src*="/assets/v10/"]');
          if (existing) {
            existing.setAttribute('src', src);
            existing.setAttribute('alt', alt);
          } else {
            const section = document.createElement('section');
            section.className = 'runtime-page-visual container-wide';
            section.innerHTML = `<figure><img src="${src}" alt="${alt}" /></figure>`;
            const firstSection = document.querySelector('#main > section');
            if (firstSection) firstSection.insertAdjacentElement('afterend', section);
            else document.querySelector('#main')?.prepend(section);
          }
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  .film-v10__player--real-video .film-v10__native-video {
    display: block;
    width: 100%;
    height: 100%;
    min-height: clamp(25rem, 48vw, 42rem);
    object-fit: cover;
    background: #09111f;
  }
  .film-v10__player--real-video { position: relative; overflow: hidden; }
  .film-v10__player--real-video .film-v10__frame { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; z-index: 3; }
  .gallery-v10__mosaic img,
  .outputs-v10__gallery img,
  .ai-v10__visual img,
  .world-v10__visual img,
  .v10-media--sample img,
  .final-v10 img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #08111f;
  }
  .runtime-page-visual { padding-block: clamp(1.5rem, 4vw, 4rem); }
  .runtime-page-visual figure {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--surface-border);
    border-radius: 1.25rem;
    background: #08111f;
    box-shadow: 0 24px 70px rgba(4, 10, 20, 0.18);
  }
  .runtime-page-visual img { display: block; width: 100%; height: auto; max-height: 44rem; object-fit: contain; }
</style>
